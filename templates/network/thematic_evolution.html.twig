{% extends 'base.html.twig' %}

{% block title %}Evolução Temática — {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Projetos</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_projects_show', {id: project.id}) }}" style="color:var(--bm-text-muted);text-decoration:none">{{ project.title|slice(0,30) }}</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <span class="current">Evolução Temática</span>
{% endblock %}

{% block topbar_actions %}
{{ help('thematic_evo.export_csv') }}
<button class="btn-bm-primary" onclick="exportCSV()" style="padding:6px 14px;font-size:13px">
    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
</button>
<a href="{{ path('app_projects_show', {id: project.id}) }}" class="btn-bm-secondary" style="padding:6px 14px;font-size:13px">
    <i class="bi bi-arrow-left me-1"></i> Voltar
</a>
{% endblock %}

{% block stylesheets %}
<style>
/* ── Layout Grid ─────────────────────────────────────────────── */
.evo-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

/* ── Sidebar controls ────────────────────────────────────────── */
.evo-sidebar {
    background: var(--bm-card-bg);
    border: 1px solid var(--bm-border);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-self: start;
}
.sidebar-section-title {
    font-size: 11px; font-weight: 700; color: var(--bm-text-muted);
    text-transform: uppercase; letter-spacing: 0.5px;
    margin-bottom: 12px;
}
.control-group {
    display: flex; flex-direction: column; gap: 6px;
    margin-bottom: 12px;
}
.control-label {
    font-size: 12px; font-weight: 600; color: var(--bm-text-muted);
    display: flex; justify-content: space-between;
}
.control-input {
    background: var(--bm-bg); border: 1px solid var(--bm-border);
    color: var(--bm-text); border-radius: 8px;
    padding: 6px 12px; font-size: 13px; font-weight: 500;
}
.control-input:focus { outline: none; border-color: var(--bm-accent); }
input[type="range"] {
    accent-color: var(--bm-accent);
}

/* ── Main Sankey Area ────────────────────────────────────────── */
.evo-card-wrap {
    background: var(--bm-card-bg);
    border: 1px solid var(--bm-border);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
    overflow: hidden;
}
.chart-container {
    position: relative;
    height: 520px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 10px;
    border: 1px solid var(--bm-border);
    padding: 10px;
}
.evo-loading {
    position: absolute; inset: 0;
    background: rgba(22,27,34,0.9);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: var(--bm-text-muted); font-size: 14px; gap: 12px;
    z-index: 20;
}
.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ── Table Styling ───────────────────────────────────────────── */
.tbl-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--bm-border);
    padding-top: 16px;
}
.evo-table {
    width: 100%; border-collapse: collapse; font-size: 12.5px;
}
.evo-table th {
    padding: 8px 12px; text-align: left; color: var(--bm-text-muted);
    font-weight: 600; border-bottom: 2px solid var(--bm-border);
    text-transform: uppercase; font-size: 10.5px; letter-spacing: 0.5px;
}
.evo-table td {
    padding: 10px 12px; border-bottom: 1px solid var(--bm-border); color: var(--bm-text);
}
.evo-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
}

.kw-pill-mini {
    display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 10px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid var(--bm-border);
    color: var(--bm-text-muted); margin: 2px;
}
</style>
{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="bm-page-header" style="margin-bottom:20px">
    <div style="display:flex;align-items:center;gap:14px">
        <div style="width:36px;height:36px;background:var(--bm-gradient);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px">📊</div>
        <div>
            <h1 class="bm-page-title" style="margin:0">Evolução Temática {{ help('thematic_evo.page') }}</h1>
            <p class="bm-page-subtitle" style="margin:0">Como os temas do período anterior se transformam nos temas do período seguinte</p>
        </div>
    </div>
</div>

<!-- Main Layout Grid -->
<div class="map-layout evo-layout">

    <!-- Left Controls Sidebar -->
    <div class="evo-sidebar">
        <div>
            <div class="sidebar-section-title">Parâmetros do Pipeline</div>
            
            <!-- Keyword Type Selection -->
            <div class="control-group">
                <label class="control-label"><span>Tipo de Palavras-Chave {{ help('thematic_evo.kw_type') }}</span></label>
                <select id="param-kw-type" class="control-input" onchange="loadThematicEvolution()">
                    <option value="author">Palavras dos Autores</option>
                    <option value="indexed">Palavras Indexadas</option>
                </select>
            </div>

            <!-- Cutoff Year Slider (Dynamically bounded) -->
            <div class="control-group">
                <label class="control-label">
                    <span>Ano de Corte (Divisão) {{ help('thematic_evo.cutoff_year') }}</span>
                    <span id="lbl-cutoff-year" style="color:var(--bm-accent);font-weight:700">{{ defaultCutoff }}</span>
                </label>
                <input type="range" id="param-cutoff-year" min="{{ minYear }}" max="{{ maxYear }}" value="{{ defaultCutoff }}" oninput="updateCutoffLabel(this.value)" onchange="loadThematicEvolution()">
                <small class="text-muted" style="font-size:10px">
                    Divide a base: <b>Período 1</b> (até <span class="lbl-p1">{{ defaultCutoff }}</span>) e <b>Período 2</b> (após <span class="lbl-p1">{{ defaultCutoff }}</span>).
                </small>
            </div>

            <!-- Min Occurrence Slider -->
            <div class="control-group">
                <label class="control-label">
                    <span>Ocorrência Mínima {{ help('thematic_evo.min_occur') }}</span>
                    <span id="lbl-min-occur" style="color:var(--bm-accent);font-weight:700">2</span>
                </label>
                <input type="range" id="param-min-occur" min="1" max="10" value="2" oninput="updateOccurLabel(this.value)" onchange="loadThematicEvolution()">
                <small class="text-muted" style="font-size:10px">Mínimo de documentos por termo, em cada período.</small>
            </div>

            <!-- Max Keywords Count Slider -->
            <div class="control-group">
                <label class="control-label">
                    <span>Limite de Palavras {{ help('thematic_evo.max_keywords') }}</span>
                    <span id="lbl-max-keywords" style="color:var(--bm-accent);font-weight:700">100</span>
                </label>
                <input type="range" id="param-max-keywords" min="20" max="300" step="10" value="100" oninput="updateKeywordsLabel(this.value)" onchange="loadThematicEvolution()">
                <small class="text-muted" style="font-size:10px">Máximo de termos usados em cada período.</small>
            </div>
        </div>

        <div style="font-size:11px;color:var(--bm-text-muted);border-top:1px solid var(--bm-border);padding-top:16px">
            <span style="font-weight:700;display:block;margin-bottom:6px">📌 DIAGRAMA DE SANKEY {{ help('thematic_evo.sankey') }}</span>
            <span style="line-height:1.4;display:block">
                O fluxo liga os temas do <b>Período 1 (esquerda)</b> aos do <b>Período 2 (direita)</b>.
                A largura é o número de palavras-chave que os dois temas têm em comum.
            </span>
        </div>
    </div>

    <!-- Right Flow Display Card -->
    <div class="evo-card-wrap">
        
        <!-- Loading Indicator -->
        <div class="evo-loading" id="evo-loading">
            <i class="bi bi-arrow-clockwise spin" style="font-size:24px;color:var(--bm-accent)"></i>
            <span>Particionando base de dados e computando trajetórias de Sankey…</span>
        </div>

        <!-- Diagram Chart Area -->
        <div class="chart-container" id="sankey-chart-wrap">
            <div id="sankey-chart" style="width:100%;height:100%"></div>
        </div>

        <!-- Clusters Legend Table -->
        <div class="tbl-wrap">
            <div class="sidebar-section-title" style="margin-bottom:12px">Detalhamento dos Fluxos Temáticos (Transições) {{ help('thematic_evo.flows_table') }}</div>
            <table class="evo-table" id="table-flows">
                <thead>
                    <tr>
                        <th style="width:250px">Período 1 (Origem)</th>
                        <th style="width:80px;text-align:center">Fluxo {{ help('thematic_evo.col_flow') }}</th>
                        <th style="width:250px">Período 2 (Destino)</th>
                        <th>Palavras-Chave de Conexão (Overlap)</th>
                    </tr>
                </thead>
                <tbody id="list-flows">
                    <!-- Loaded dynamically -->
                </tbody>
            </table>
        </div>

    </div>

</div>
{% endblock %}

{% block javascripts %}
<!-- Load Apache ECharts from CDN -->
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<script>
// ── Global Config ────────────────────────────────────────────────────────────
const DATA_URL = '{{ path('app_thematic_evolution_data', {id: project.id}) }}';
let myChart    = null;
let evolutionData = null; // cached JSON coordinates

function updateCutoffLabel(v) { 
    document.getElementById('lbl-cutoff-year').textContent = v; 
    document.querySelectorAll('.lbl-p1').forEach(el => el.textContent = v);
}
function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function updateOccurLabel(v) { document.getElementById('lbl-min-occur').textContent = v; }
function updateKeywordsLabel(v) { document.getElementById('lbl-max-keywords').textContent = v; }

function isThemeLight() {
    return document.documentElement.getAttribute('data-bs-theme') === 'light';
}

function getColors() {
    const light = isThemeLight();
    return {
        text: light ? '#24292f' : '#e6edf3',
        grid: light ? 'rgba(208,215,222,0.8)' : 'rgba(48,54,61,0.6)',
        labelColor: light ? '#24292f' : '#e6edf3',
        lineColor: light ? 'rgba(0, 0, 0, 0.15)' : 'rgba(255, 255, 255, 0.15)',
    };
}

// ── Theme Re-drawing Listener ────────────────────────────────────────────────
window.addEventListener('bm-theme-changed', () => {
    if (evolutionData) {
        renderSankey();
        renderTable();
    }
});

// ── Fetch Thematic Evolution Data ────────────────────────────────────────────
async function loadThematicEvolution() {
    const loading = document.getElementById('evo-loading');
    loading.style.display = 'flex';

    const kwType     = document.getElementById('param-kw-type').value;
    const cutoffYear = document.getElementById('param-cutoff-year').value;
    const minOccur   = document.getElementById('param-min-occur').value;
    const limit      = document.getElementById('param-max-keywords').value;

    const url = `${DATA_URL}?kwType=${kwType}&cutoffYear=${cutoffYear}&minOccur=${minOccur}&limit=${limit}`;

    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('HTTP ' + response.status);
        evolutionData = await response.json();
        
        renderSankey();
        renderTable();
    } catch (e) {
        console.error("Failed loading thematic evolution data:", e);
        document.getElementById('list-flows').innerHTML = '<tr><td colspan="4" class="text-center py-4 text-danger">Não foi possível calcular a evolução temática. Tente novamente ou reduza o limite de palavras.</td></tr>';
    } finally {
        loading.style.display = 'none';
    }
}

// ── Render ECharts Sankey ────────────────────────────────────────────────────
function renderSankey() {
    const chartDom = document.getElementById('sankey-chart');
    if (!myChart) {
        myChart = echarts.init(chartDom);
        window.addEventListener('resize', () => myChart.resize());
    }

    const cl = getColors();

    // Map labels of nodes to clear visual styling.
    // depth pins P1 themes to the left and P2 themes to the right, even when a
    // theme has no flow (otherwise ECharts puts unlinked P2 themes in the left column).
    const nodes = evolutionData.nodes.map(n => ({
        name: n.name,
        depth: n.name.endsWith('(P1)') ? 0 : 1,
        itemStyle: {
            color: n.name.includes('(P1)') ? '#4f8ef7' : '#a855f7',
            borderColor: n.name.includes('(P1)') ? '#4f8ef7' : '#a855f7'
        }
    }));

    const option = {
        tooltip: {
            trigger: 'item',
            triggerOn: 'mousemove',
            formatter: function (params) {
                if (params.dataType === 'node') {
                    return `<b>${escapeHtml(params.name)}</b>`;
                }
                const link = evolutionData.details.find(d => 
                    (d.p1_label + " (P1)") === params.data.source && 
                    (d.p2_label + " (P2)") === params.data.target
                );
                const keywordsText = link ? escapeHtml(link.keywords.slice(0, 8).join(', ')) : '';
                return `<b>${escapeHtml(params.data.source)}</b> ➔ <b>${escapeHtml(params.data.target)}</b><br/>` +
                       `Palavras em comum: ${params.data.value}<br/>` +
                       `<small style="color:var(--bm-text-muted)">Palavras de conexão: ${keywordsText}</small>`;
            }
        },
        series: [
            {
                type: 'sankey',
                layout: 'none',
                emphasis: {
                    focus: 'adjacency'
                },
                data: nodes,
                links: evolutionData.links,
                lineStyle: {
                    color: 'gradient',
                    curveness: 0.5,
                    opacity: 0.25
                },
                label: {
                    position: 'right',
                    color: cl.labelColor,
                    fontSize: 11,
                    fontFamily: '"Inter", sans-serif',
                    fontWeight: 'bold'
                },
                draggable: true
            }
        ]
    };

    myChart.setOption(option, true);
}

// ── Render Legend Table ──────────────────────────────────────────────────────
function renderTable() {
    const tbody = document.getElementById('list-flows');
    tbody.innerHTML = '';

    if (evolutionData.details.length === 0) {
        const meta = evolutionData.meta || {};
        let msg = 'Nenhuma transição temática identificada com os parâmetros atuais. Tente reduzir a ocorrência mínima ou mudar o ano de corte.';
        if (meta.p2_size === 0) msg = 'O Período 2 (após o ano de corte) não tem termos suficientes. Escolha um ano de corte menor ou reduza a ocorrência mínima.';
        else if (meta.p1_size === 0) msg = 'O Período 1 (até o ano de corte) não tem termos suficientes. Escolha um ano de corte maior ou reduza a ocorrência mínima.';
        tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">${msg}</td></tr>`;
        return;
    }

    // Sort transitions by flow weight desc
    const sorted = [...evolutionData.details].sort((a,b) => b.value - a.value);

    tbody.innerHTML = sorted.map(d => {
        const pills = d.keywords.map(k => `<span class="kw-pill-mini">${escapeHtml(k)}</span>`).join('');
        return `<tr>
            <td style="font-weight:600;color:#4f8ef7"><i class="bi bi-tag-fill me-1"></i>${escapeHtml(d.p1_label)} <span style="font-size:9.5px;color:var(--bm-text-muted)">(P1)</span></td>
            <td style="text-align:center;font-weight:700;color:var(--bm-accent)">➔ ${d.value} ➔</td>
            <td style="font-weight:600;color:#a855f7"><i class="bi bi-tag-fill me-1"></i>${escapeHtml(d.p2_label)} <span style="font-size:9.5px;color:var(--bm-text-muted)">(P2)</span></td>
            <td>${pills}</td>
        </tr>`;
    }).join('');
}

// ── Export CSV Table (Microsoft Excel accents and semicolon friendly) ────────
function exportCSV() {
    if (!evolutionData || evolutionData.details.length === 0) {
        alert("Sem dados disponíveis para exportação.");
        return;
    }

    // Excel-friendly UTF-8 BOM
    let csvContent = "\uFEFF";
    
    // Headers
    csvContent += "Tema Origem (P1);Palavras em Comum;Tema Destino (P2);Palavras-Chave de Conexao\r\n";
    
    // Rows
    evolutionData.details.forEach(d => {
        const keywordsStr = d.keywords.join(', ');
        const row = [
            `"${String(d.p1_label).replace(/"/g, '""')}"`,
            d.value,
            `"${String(d.p2_label).replace(/"/g, '""')}"`,
            `"${keywordsStr.replace(/"/g, '""')}"`
        ];
        csvContent += row.join(";") + "\r\n";
    });

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `evolucao_tematica_ano_${document.getElementById('param-cutoff-year').value}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

// Initialize
loadThematicEvolution();
</script>
{% endblock %}
