const BI_CATS = {
    data:    v => ['bar-chart','pie-chart','graph','diagram','table','grid','database','funnel','filter','sort','list','percent','calculator','123'].some(k => v.includes(k)),
    science: v => ['flower','tree','leaf','bug','water','droplet','sun','moon','cloud','thermo','wind','snow','globe','geo','map','camera','binocular','flask','virus','robot','cpu','radioactive','infinity','recycle'].some(k => v.includes(k)),
    tech:    v => ['laptop','pc','phone','tablet','hdd','server','wifi','bluetooth','usb','terminal','code','braces','brackets','github','git','broadcast','router','rss','qr','radar','bezier'].some(k => v.includes(k)),
    people:  v => ['people','person','mortarboard','book','journal','briefcase','building','bank','shop','award','trophy','star','shield','patch','collection','clipboard','folder','box','archive'].some(k => v.includes(k)),
    ui:      v => ['search','zoom','eye','bell','chat','envelope','send','check','x-circle','ban','slash','exclamation','info','question','lightning','gear','sliders','toggle','list','card','column','layout','layer','tag','hash','key','lock','link','paperclip','pin','cursor','hand','play','pause','stop','download','upload','share','trash','pencil','pen','eraser','image','film','camera','mic','volume','headphone'].some(k => v.includes(k)),
    arrows:  v => ['arrow','chevron','caret','dash','plus','three-dots','compass','crosshair','cursor'].some(k => v.includes(k)),
};

let _bmTab = 'all', _bmList = [], _bmRendered = 0;
const _bmLimit = 120;

function getBmList(tab) {
    if (tab === 'all') return BI_ICONS;
    const fn = BI_CATS[tab];
    return fn ? BI_ICONS.filter(ic => fn(ic.replace('bi-',''))) : BI_ICONS;
}

function renderBmIcons(list) {
    _bmList = list; _bmRendered = 0;
    document.getElementById('bm-icon-grid').innerHTML = '';
    appendBmIcons();
}

function appendBmIcons() {
    const grid = document.getElementById('bm-icon-grid');
    const end = Math.min(_bmRendered + _bmLimit, _bmList.length);
    for (let i = _bmRendered; i < end; i++) {
        const ic = _bmList[i];
        const btn = document.createElement('button');
        btn.type = 'button'; btn.title = ic;
        btn.innerHTML = `<i class="bi ${ic}"></i>`;
        btn.onclick = () => selectBmIcon(ic);
        btn.onmouseenter = () => previewBmIcon(ic);
        grid.appendChild(btn);
    }
    _bmRendered = end;
    if (_bmRendered < _bmList.length) {
        const s = document.createElement('div');
        s.id = 'bm-sentinel';
        s.style.cssText = 'grid-column:1/-1;text-align:center;padding:.5rem;font-size:.75rem;color:var(--bm-text-muted)';
        s.textContent = `Role para mais… (${_bmRendered}/${_bmList.length})`;
        grid.appendChild(s);
    }
}

function openIconPicker() {
    document.getElementById('bm-icon-modal-overlay').style.display = 'flex';
    document.getElementById('bm-icon-search').value = '';
    document.querySelectorAll('.bm-itab').forEach((t,i) => t.classList.toggle('active', i===0));
    _bmTab = 'all';
    renderBmIcons(getBmList('all'));
    setTimeout(() => document.getElementById('bm-icon-search').focus(), 100);
    const cur = document.getElementById('icon').value;
    if (cur) previewBmIcon(cur);

    document.getElementById('bm-icon-grid').onscroll = function() {
        if (this.scrollTop + this.clientHeight >= this.scrollHeight - 50) {
            const s = document.getElementById('bm-sentinel');
            if (s) { s.remove(); appendBmIcons(); }
        }
    };
}

function closeIconPicker() {
    document.getElementById('bm-icon-modal-overlay').style.display = 'none';
}

function selectBmIcon(ic) {
    document.getElementById('icon').value = ic;
    updateIconPreview(ic);
    previewBmIcon(ic);
    closeIconPicker();
}

function previewBmIcon(ic) {
    document.getElementById('bm-pane-icon').innerHTML = `<i class="bi ${ic}"></i>`;
    document.getElementById('bm-pane-name').textContent = ic;
    document.getElementById('bm-pane-desc').textContent = 'Bootstrap Icons — clique para selecionar';
}

function switchBmTab(tab, btn) {
    document.querySelectorAll('.bm-itab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    _bmTab = tab;
    document.getElementById('bm-icon-search').value = '';
    renderBmIcons(getBmList(tab));
}

function filterBmIcons(q) {
    const term = q.toLowerCase().replace('bi-','').trim();
    const base = getBmList(_bmTab);
    renderBmIcons(term ? base.filter(ic => ic.toLowerCase().includes(term)) : base);
}

document.getElementById('bm-icon-modal-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeIconPicker();
});
</script>
{% endblock %}
