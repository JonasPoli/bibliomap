{% extends 'base.html.twig' %}

{% block title %}Classificação Temática — {{ project.title }}{% endblock %}

{% block body %}
<div class="bm-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="bm-page-title">
            <i class="bi bi-collection-fill me-2 text-accent"></i>Classificação Temática {{ help('classification.index.page') }}
        </h1>
        <p class="bm-page-subtitle">Crie grupos, defina termos de classificação e aplique o motor automático ao corpus.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <a href="{{ path('app_classification_groups_export_csv', {id: project.id}) }}" class="btn btn-bm-secondary" title="Exportar cadastro de grupos em CSV">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Exportar Grupos (CSV)
        </a>
        {{ help('classification.index.export_groups') }}
        <button type="button" class="btn btn-bm-secondary" data-bs-toggle="modal" data-bs-target="#modalImportGroupsCsv" title="Importar grupos de um arquivo CSV">
            <i class="bi bi-file-earmark-arrow-up me-1"></i> Importar Grupos (CSV)
        </button>
        {{ help('classification.index.import_groups') }}
        {% if hasResult %}
        <a href="{{ path('app_classification_results', {id: project.id}) }}" class="btn btn-bm-secondary">
            <i class="bi bi-list-ul me-1"></i> Ver Resultados
        </a>
        <a href="{{ path('app_classification_export', {id: project.id}) }}" class="btn btn-bm-secondary">
            <i class="bi bi-download me-1"></i> Exportar Resultados
        </a>
        {{ help('classification.index.export_results') }}
        <a href="{{ path('app_classification_export_vosviewer', {id: project.id}) }}" class="btn btn-bm-secondary">
            <i class="bi bi-diagram-3 me-1"></i> VOSviewer
        </a>
        {{ help('classification.index.vosviewer') }}
        {% endif %}
        <a href="{{ path('app_classification_group_new', {id: project.id}) }}" class="btn btn-bm-primary">
            <i class="bi bi-plus-lg me-1"></i> Novo Grupo
        </a>
    </div>
</div>

{% for label, messages in app.flashes %}
    {% for msg in messages %}
    <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'danger' ? 'danger' : 'warning') }} bm-alert mb-3">
        <i class="bi bi-{{ label == 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' }}"></i>
        {{ msg }}
    </div>
    {% endfor %}
{% endfor %}

{{ include('classification/_expansion_notice.html.twig') }}

{# ── STATS BAR ─────────────────────────────────────────────────────────────── #}
{% if groups|length > 0 %}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="bm-stat-card text-center">
            <div class="bm-stat-value text-accent">{{ groups|length }}</div>
            <div class="bm-stat-label">Grupos {{ help('classification.index.stats') }}</div>
        </div>
    </div>
    {% set normal_count = groups|filter(g => g.type == 'normal')|length %}
    {% set noise_count  = groups|filter(g => g.type == 'noise')|length %}
    {% set val_count    = groups|filter(g => g.type == 'validator')|length %}
    <div class="col-6 col-md-3">
        <div class="bm-stat-card text-center">
            <div class="bm-stat-value" style="color:var(--bm-success)">{{ normal_count }}</div>
            <div class="bm-stat-label">Temáticos {{ help('classification.type.normal') }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bm-stat-card text-center">
            <div class="bm-stat-value" style="color:var(--bm-danger)">{{ noise_count }}</div>
            <div class="bm-stat-label">Ruído {{ help('classification.type.noise') }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bm-stat-card text-center">
            <div class="bm-stat-value" style="color:var(--bm-warning)">{{ val_count }}</div>
            <div class="bm-stat-label">Validadores {{ help('classification.type.validator') }}</div>
        </div>
    </div>
</div>
{% endif %}

{% if groups|length > 0 %}
<ul class="nav nav-tabs mb-4" id="classificationTabs" role="tablist" style="border-bottom-color:var(--bm-border)">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-groups-btn" data-bs-toggle="tab" data-bs-target="#tab-groups" type="button" role="tab" aria-controls="tab-groups" aria-selected="true">
            <i class="bi bi-list-ul me-1"></i> Lista de Grupos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-colors-btn" data-bs-toggle="tab" data-bs-target="#tab-colors" type="button" role="tab" aria-controls="tab-colors" aria-selected="false">
            <i class="bi bi-grid-1x2-fill me-1"></i> Organização por Cores
            {% if colorGroups|length > 0 %}
            <span class="badge text-bg-secondary ms-1" style="font-size:10px">{{ colorGroups|length }}</span>
            {% endif %}
        </button>
    </li>
</ul>
{% endif %}

<div class="tab-content" id="classificationTabsContent">
<div class="tab-pane fade show active" id="tab-groups" role="tabpanel" aria-labelledby="tab-groups-btn">
<div class="row g-4">
    {# ── LEFT: groups list ──────────────────────────────────────────────────── #}
    <div class="col-lg-8">
        {% if groups|length == 0 %}
        <div class="bm-card text-center py-5">
            <div style="font-size:48px;margin-bottom:12px">📂</div>
            <h5 style="color:var(--bm-text);font-weight:600">Nenhum grupo criado ainda</h5>
            <p style="color:var(--bm-text-muted);font-size:13.5px;margin-bottom:20px">
                Crie grupos temáticos (Normal), grupos de Ruído e Validadores para configurar o motor de classificação.
            </p>
            <a href="{{ path('app_classification_group_new', {id: project.id}) }}" class="btn btn-bm-primary">
                <i class="bi bi-plus-lg me-1"></i> Criar primeiro grupo
            </a>
        </div>
        {% else %}

        {# Group by type #}
        {% set type_labels = {
            'validator':    ['Validadores', 'warning',   'bi-shield-check',    'Documentos devem conter ao menos um desses termos para serem considerados relevantes.', 'classification.type.validator'],
            'noise':        ['Ruído / Falso Positivo', 'danger', 'bi-ban',       'Documentos com esses termos saem da análise temática (falsos positivos).', 'classification.type.noise'],
            'normal':       ['Grupos Temáticos', 'primary',  'bi-collection',     'Cada documento validado entra em todos os grupos cujos termos aparecem nele.', 'classification.type.normal'],
            'unclassified': ['Sem Classificação', 'secondary', 'bi-question-circle', 'Documentos válidos que não se enquadraram em nenhum grupo temático.', 'classification.type.unclassified']
        } %}

        {% for type_key, type_info in type_labels %}
            {% set type_groups = groups|filter(g => g.type == type_key) %}
            {% if type_groups|length > 0 %}
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi {{ type_info[2] }} text-{{ type_info[1] }}"></i>
                    <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--bm-text-muted)">{{ type_info[0] }}</span>
                    <span class="badge text-bg-{{ type_info[1] }}" style="font-size:10px">{{ type_groups|length }}</span>
                    {{ help(type_info[4]) }}
                </div>
                <div style="font-size:11px;color:var(--bm-text-muted);margin-bottom:8px;padding-left:26px">
                    {{ type_info[3] }}
                </div>
                {% for group in type_groups %}
                {% set doc_count = counts[group.id] ?? 0 %}
                <div class="bm-card mb-2" style="border-left:4px solid {{ group.color }};padding:14px 18px">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div style="flex:1;min-width:0">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi {{ group.icon }}" style="color:{{ group.color }};font-size:15px"></i>
                                <span style="font-weight:600;color:var(--bm-text);font-size:14px">{{ group.name }}</span>
                                <span class="badge text-bg-{{ group.typeColor }}" style="font-size:10px">{{ group.typeLabel }}</span>
                                {% if doc_count > 0 %}
                                <span class="badge text-bg-secondary" style="font-size:10px">{{ doc_count }} docs</span>
                                {% endif %}
                            </div>
                            {% if group.description %}
                            <div style="font-size:12px;color:var(--bm-text-muted);margin-bottom:8px;line-height:1.4">{{ group.description|slice(0, 150) }}{% if group.description|length > 150 %}…{% endif %}</div>
                            {% endif %}
                            {% if group.terms|length > 0 %}
                            <div class="d-flex flex-wrap gap-1">
                                {% for term in group.terms|slice(0, 12) %}
                                <span style="font-size:10.5px;background:rgba(255,255,255,0.05);border:1px solid var(--bm-border);border-radius:4px;padding:2px 7px;color:var(--bm-text-muted);font-family:monospace">{{ term }}</span>
                                {% endfor %}
                                {% if group.terms|length > 12 %}
                                <span style="font-size:10.5px;color:var(--bm-text-muted)">+{{ group.terms|length - 12 }} mais</span>
                                {% endif %}
                            </div>
                            {% else %}
                            <span style="font-size:11px;color:var(--bm-text-muted);font-style:italic">Nenhum termo definido</span>
                            {% endif %}
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                            <a href="{{ path('app_classification_group_edit', {id: project.id, groupId: group.id}) }}"
                               class="btn btn-sm btn-outline-secondary" title="Editar" style="font-size:12px;padding:4px 10px">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Excluir"
                                    style="font-size:12px;padding:4px 10px"
                                    onclick="confirmDelete({{ group.id }}, '{{ group.name|e('js') }}', '{{ csrf_token('clf_group_del_' ~ group.id) }}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        {% endfor %}
        {% endif %}
    </div>

    {# ── RIGHT: run panel ───────────────────────────────────────────────────── #}
    <div class="col-lg-4">
        <div class="bm-card mb-3" style="background:linear-gradient(135deg,rgba(79,142,247,0.08),rgba(168,85,247,0.08));border-color:rgba(79,142,247,0.3)">
            <h6 style="font-weight:700;color:var(--bm-text);margin-bottom:8px">
                <i class="bi bi-lightning-fill text-accent me-1"></i> Motor de Classificação {{ help('classification.index.engine') }}
            </h6>
            <p style="font-size:12.5px;color:var(--bm-text-muted);line-height:1.55;margin-bottom:16px">
                Processa todos os documentos do projeto em sequência:<br>
                <strong style="color:var(--bm-text-muted)">⓪ Filtro Temporal</strong> →
                <strong style="color:var(--bm-danger)">① Ruído</strong> →
                <strong style="color:var(--bm-warning)">② Validadores</strong> →
                <strong style="color:var(--bm-accent)">③ Temáticos (todos)</strong> →
                <strong style="color:var(--bm-text-muted)">④ Sem grupo</strong>
                <br><span style="font-size:11px;color:var(--bm-text-muted)">Um documento pode ser classificado em <strong>múltiplos</strong> grupos temáticos.</span>
            </p>

            {% if groups|length == 0 %}
            <div style="font-size:12px;color:var(--bm-text-muted);font-style:italic">Crie ao menos um grupo antes de executar.</div>
            {% else %}
            <form action="{{ path('app_classification_run', {id: project.id}) }}" method="post" id="runForm">
                <input type="hidden" name="_token" value="{{ csrf_token('clf_run_' ~ project.id) }}">

                <div class="mb-3">
                    <label for="min_year" class="form-label" style="font-size:12.5px;color:var(--bm-text)">
                        <i class="bi bi-calendar-minus me-1"></i>Ano Mínimo (filtro temporal) {{ help('classification.index.min_year') }}
                    </label>
                    <input type="number" id="min_year" name="min_year" class="form-control"
                           value="{{ project.classificationMinYear }}"
                           placeholder="Ex: 2000" min="1900" max="2100"
                           style="font-size:13px">
                    <div style="font-size:11px;color:var(--bm-text-muted);margin-top:4px">
                        Anteriores a este ano vão para o <strong style="color:var(--bm-danger)">Ruído</strong>. Vazio = sem filtro.
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-bm-primary flex-grow-1" id="runBtn">
                        <i class="bi bi-play-fill me-1"></i> Executar Classificação
                    </button>
                    {{ help('classification.index.run') }}
                </div>
                <div style="font-size:11px;color:var(--bm-text-muted);margin-top:8px;text-align:center">
                    ⚠️ Substitui os resultados anteriores, inclusive ajustes manuais
                </div>
            </form>
            {% endif %}
        </div>

        {% if hasResult %}
        <div class="bm-card">
            <h6 style="font-weight:700;color:var(--bm-text);margin-bottom:12px">
                <i class="bi bi-pie-chart-fill text-accent me-1"></i> Distribuição {{ help('classification.index.distribution') }}
            </h6>
            {% set total_classified = counts|reduce((carry, v) => carry + v, 0) %}
            {% for group in groups %}
                {% set cnt = counts[group.id] ?? 0 %}
                {% if cnt > 0 %}
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span style="font-size:11.5px;color:var(--bm-text)">
                            <i class="bi {{ group.icon }}" style="color:{{ group.color }}"></i>
                            {{ group.name|slice(0,28) }}{% if group.name|length > 28 %}…{% endif %}
                        </span>
                        <span style="font-size:11px;color:var(--bm-text-muted)">{{ cnt }}</span>
                    </div>
                    <div style="height:5px;background:var(--bm-border);border-radius:3px;overflow:hidden">
                        <div style="height:100%;background:{{ group.color }};width:{{ total_classified > 0 ? (cnt / total_classified * 100)|round : 0 }}%;border-radius:3px;transition:width 0.5s ease"></div>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
            {% set unclassified_count = counts[0] ?? counts[''] ?? 0 %}
            {% if unclassified_count > 0 %}
            <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span style="font-size:11.5px;color:var(--bm-text)"><i class="bi bi-question-circle" style="color:#6b7280"></i> Sem grupo</span>
                    <span style="font-size:11px;color:var(--bm-text-muted)">{{ unclassified_count }}</span>
                </div>
                <div style="height:5px;background:var(--bm-border);border-radius:3px;overflow:hidden">
                    <div style="height:100%;background:#6b7280;width:{{ total_classified > 0 ? (unclassified_count / total_classified * 100)|round : 0 }}%;border-radius:3px"></div>
                </div>
            </div>
            {% endif %}
            <div class="mt-3 text-center">
                <a href="{{ path('app_classification_results', {id: project.id}) }}" class="btn btn-bm-secondary w-100" style="font-size:12.5px">
                    <i class="bi bi-list-ul me-1"></i> Ver todos os documentos
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</div>
</div>{# /tab-groups #}

{% if groups|length > 0 %}
<div class="tab-pane fade" id="tab-colors" role="tabpanel" aria-labelledby="tab-colors-btn">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0 fw-bold" style="color:var(--bm-text)">
                <i class="bi bi-grid-1x2-fill text-accent me-1"></i> Organização dos Grupos por Cor
            </h5>
            {{ help('classification.index.color_board') }}
        </div>
        {% if colorGroups|length > 0 %}
        <div class="d-flex align-items-center gap-2 flex-wrap">
            {% if hasResult %}
            <div class="form-check form-switch mb-0 me-2" style="font-size:12.5px;color:var(--bm-text-muted)">
                <input class="form-check-input" type="checkbox" id="exportIncludeCounts" checked>
                <label class="form-check-label" for="exportIncludeCounts">Incluir contagens</label>
            </div>
            {% endif %}
            <button type="button" class="btn btn-sm btn-bm-secondary" onclick="exportColorBoardSvg()">
                <i class="bi bi-filetype-svg me-1"></i> Exportar SVG
            </button>
            <button type="button" class="btn btn-sm btn-bm-primary" onclick="exportColorBoardPng()">
                <i class="bi bi-filetype-png me-1"></i> Exportar PNG
            </button>
        </div>
        {% endif %}
    </div>

    {% if colorGroups|length == 0 %}
    <div class="bm-card text-center py-5">
        <p class="mb-0" style="color:var(--bm-text-muted);font-size:13.5px">
            Nenhum grupo temático (tipo <strong>Normal</strong>) cadastrado ainda. Grupos de Ruído e Validadores não entram neste quadro.
        </p>
    </div>
    {% else %}
    <div class="row row-cols-1 row-cols-md-2 g-4" id="colorBoardGrid">
        {% for cg in colorGroups %}
        <div class="col">
            <div class="h-100 rounded-3 overflow-hidden" style="background:var(--bm-card-bg);border:1.5px solid {{ cg.color }}">
                <div class="px-3 py-3 text-center position-relative" style="background:color-mix(in srgb, {{ cg.color }} 14%, transparent);border-bottom:1.5px solid {{ cg.color }}">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <span class="rounded-circle flex-shrink-0" style="width:10px;height:10px;background:{{ cg.color }};display:inline-block"></span>
                        <span class="fw-bold color-board-title" data-color="{{ cg.color }}" style="font-size:15px;color:var(--bm-text);line-height:1.3">
                            {{ cg.label ?: cg.defaultLabel }}
                        </span>
                        {% if canEdit %}
                        <button type="button" class="btn btn-sm p-0 px-1 border-0 bg-transparent color-label-edit-btn"
                                data-color="{{ cg.color }}"
                                data-current="{{ cg.label }}"
                                data-default="{{ cg.defaultLabel }}"
                                title="Editar título deste agrupamento de cor"
                                style="color:var(--bm-text-muted)">
                            <i class="bi bi-pencil-square" style="font-size:13px"></i>
                        </button>
                        {% endif %}
                    </div>
                    {% if canEdit %}
                    <div class="color-label-editor d-none mt-2" data-color="{{ cg.color }}">
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control color-label-input" value="{{ cg.label }}" maxlength="255" placeholder="Ex.: 1. Inteligência aplicada aos processos produtivos">
                            <button type="button" class="btn btn-bm-primary color-label-save-btn">Salvar</button>
                            <button type="button" class="btn btn-bm-secondary color-label-cancel-btn">Cancelar</button>
                        </div>
                    </div>
                    {% endif %}
                    <div style="font-size:11px;color:var(--bm-text-muted);margin-top:4px">
                        {{ cg.groupsCount }} {{ cg.groupsCount == 1 ? 'grupo' : 'grupos' }}
                        {% if hasResult and cg.docsSum > 0 %} · {{ cg.docsSum|number_format(0, ',', '.') }} ocorrências{% endif %}
                    </div>
                </div>
                <div class="p-3">
                    {% for section in cg.sections %}
                        {% if not loop.first %}
                        <hr class="my-3" style="border-color:color-mix(in srgb, {{ cg.color }} 35%, var(--bm-border));opacity:1">
                        {% endif %}
                        {% if section.title %}
                        <div class="fw-bold mb-2" style="font-size:13.5px;color:var(--bm-text)">{{ section.title }}</div>
                        {% endif %}
                        <ul class="list-unstyled mb-0 {{ section.title ? 'ps-3' : '' }}">
                            {% for g in section.groups %}
                            <li class="d-flex align-items-center justify-content-between gap-2 py-1" style="font-size:13px;color:var(--bm-text)">
                                <span class="d-flex align-items-center gap-2">
                                    {% if not section.title %}
                                    <i class="bi {{ g.icon }}" style="color:{{ cg.color }};font-size:12px"></i>
                                    {% endif %}
                                    <span>{{ g.name }}</span>
                                </span>
                                {% if hasResult %}
                                <a href="{{ path('app_classification_results', {id: project.id, group: g.id}) }}"
                                   class="badge text-bg-secondary text-decoration-none flex-shrink-0"
                                   style="font-size:10.5px" title="Ver documentos deste grupo">
                                    {{ g.docCount|number_format(0, ',', '.') }}
                                </a>
                                {% endif %}
                            </li>
                            {% endfor %}
                        </ul>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>{# /tab-colors #}
{% endif %}
</div>{# /tab-content #}

{# Delete confirmation modal #}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--bm-card-bg);border:1px solid var(--bm-border)">
            <div class="modal-header" style="border-color:var(--bm-border)">
                <h5 class="modal-title" style="color:var(--bm-text)">Excluir Grupo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="color:var(--bm-text-muted)">
                Tem certeza que deseja excluir o grupo <strong id="deleteGroupName" style="color:var(--bm-text)"></strong>?
                Todos os resultados deste grupo também serão removidos.
            </div>
            <div class="modal-footer" style="border-color:var(--bm-border)">
                <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post">
                    <input type="hidden" name="_token" id="deleteToken">
                    <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

{# ── Modal Import Groups CSV ────────────────────────────────────────────────── #}
<div class="modal fade" id="modalImportGroupsCsv" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--bm-card-bg);border:1px solid var(--bm-border)">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" style="color:var(--bm-text)">
                    <i class="bi bi-file-earmark-arrow-up text-accent me-1"></i> Importar Grupos de Classificação (CSV)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('app_classification_groups_import_csv', {id: project.id}) }}" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('groups_import_' ~ project.id) }}">
                    <div class="mb-3">
                        <label for="csv_file" class="form-label fw-bold" style="font-size:13px">Selecione o arquivo CSV: {{ help('classification.index.import_file') }}</label>
                        <input type="file" class="form-control" id="csv_file" name="csv_file" accept=".csv" required>
                    </div>
                    <div class="p-3 rounded mb-2" style="background:var(--bm-bg);border:1px solid var(--bm-border);font-size:12px;color:var(--bm-text-muted)">
                        <strong style="color:var(--bm-text)"><i class="bi bi-info-circle text-accent me-1"></i> Estrutura esperada do cabeçalho CSV:</strong> {{ help('classification.index.import_format') }}<br>
                        <code class="d-block text-accent my-1" style="font-size:11px;word-break:break-all">nome;tipo;cor;icone;posicao;termos;campos_match;ano_inicio;ano_fim;qualis;natureza_instituicao;continente;paises;autores;usar_tesauro</code>
                        <div class="mt-2" style="line-height:1.5">
                            • <strong>termos</strong>: separados por vírgula (ex: <code>machine learning, deep learning</code>) ou por ponto e vírgula com o campo entre aspas (<code>"machine learning; deep learning"</code>)<br>
                            • <strong>usar_tesauro</strong>: <code>1</code> (sim) ou <code>0</code> (não)<br>
                            • <strong>tipo</strong>: <code>normal</code>, <code>validator</code>, <code>noise</code><br>
                            • Cada linha cria um grupo <strong>novo</strong> (não atualiza grupos de mesmo nome)
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-bm-primary">
                        <i class="bi bi-upload me-1"></i> Importar CSV
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function confirmDelete(groupId, groupName, token) {
    document.getElementById('deleteGroupName').textContent = groupName;
    document.getElementById('deleteForm').action = '/projects/{{ project.id }}/classification/groups/' + groupId + '/delete';
    document.getElementById('deleteToken').value = token;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}

document.getElementById('runForm')?.addEventListener('submit', function() {
    const btn = document.getElementById('runBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processando…';
});

// ── Organização por Cores: abas, edição inline de rótulos e exportação SVG/PNG ──
const COLOR_BOARD_DATA = {{ colorGroups|json_encode|raw }};
const COLOR_LABELS_URL = {{ path('app_classification_color_labels', {id: project.id})|json_encode|raw }};
const COLOR_LABELS_CSRF = {{ csrf_token('clf_color_labels_' ~ project.id)|json_encode|raw }};
const PROJECT_TITLE = {{ project.title|json_encode|raw }};
const HAS_RESULT = {{ hasResult ? 'true' : 'false' }};

if (window.location.hash === '#cores') {
    const btn = document.getElementById('tab-colors-btn');
    if (btn) new bootstrap.Tab(btn).show();
}
document.getElementById('tab-colors-btn')?.addEventListener('shown.bs.tab', () => {
    history.replaceState(null, '', '#cores');
});
document.getElementById('tab-groups-btn')?.addEventListener('shown.bs.tab', () => {
    if (window.location.hash === '#cores') history.replaceState(null, '', window.location.pathname + window.location.search);
});

document.querySelectorAll('.color-label-edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        const color = btn.dataset.color;
        const editor = document.querySelector(`.color-label-editor[data-color="${color}"]`);
        if (!editor) return;
        editor.classList.remove('d-none');
        const input = editor.querySelector('.color-label-input');
        input.focus();
        input.select();
    });
});

document.querySelectorAll('.color-label-editor').forEach(editor => {
    const color = editor.dataset.color;
    const input = editor.querySelector('.color-label-input');
    const saveBtn = editor.querySelector('.color-label-save-btn');
    const cancelBtn = editor.querySelector('.color-label-cancel-btn');

    const closeEditor = () => editor.classList.add('d-none');
    cancelBtn.addEventListener('click', closeEditor);

    const doSave = async () => {
        const label = input.value.trim();
        saveBtn.disabled = true;
        try {
            const fd = new FormData();
            fd.append('_token', COLOR_LABELS_CSRF);
            fd.append('color', color);
            fd.append('label', label);
            const res = await fetch(COLOR_LABELS_URL, { method: 'POST', body: fd });
            const data = await res.json();
            if (!res.ok || !data.ok) {
                alert(data.error || 'Erro ao salvar título.');
                return;
            }
            const item = COLOR_BOARD_DATA.find(c => c.color === color);
            if (item) item.label = data.label;
            const titleEl = document.querySelector(`.color-board-title[data-color="${color}"]`);
            if (titleEl && item) titleEl.textContent = item.label || item.defaultLabel;
            const editBtn = document.querySelector(`.color-label-edit-btn[data-color="${color}"]`);
            if (editBtn) editBtn.dataset.current = data.label;
            closeEditor();
        } catch (err) {
            alert('Erro de comunicação ao salvar título.');
        } finally {
            saveBtn.disabled = false;
        }
    };

    saveBtn.addEventListener('click', doSave);
    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); doSave(); }
        if (e.key === 'Escape') closeEditor();
    });
});

function escapeXml(str) {
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function wrapText(text, maxChars) {
    const words = String(text).split(/\s+/);
    const lines = [];
    let cur = '';
    for (const w of words) {
        if (!cur) { cur = w; continue; }
        if ((cur + ' ' + w).length <= maxChars) {
            cur += ' ' + w;
        } else {
            lines.push(cur);
            cur = w;
        }
    }
    if (cur) lines.push(cur);
    return lines;
}

function hexToRgba(hex, alpha) {
    const clean = hex.replace('#', '');
    const r = parseInt(clean.slice(0, 2), 16);
    const g = parseInt(clean.slice(2, 4), 16);
    const b = parseInt(clean.slice(4, 6), 16);
    return `rgba(${r},${g},${b},${alpha})`;
}

function buildColorBoardSvg() {
    const includeCounts = HAS_RESULT && (document.getElementById('exportIncludeCounts')?.checked ?? false);
    const cols = COLOR_BOARD_DATA.length === 1 ? 1 : 2;
    const cardW = 520;
    const gap = 28;
    const padX = 36;
    const topTitleH = 72;
    const totalW = padX * 2 + cols * cardW + (cols - 1) * gap;

    // Pré-calcula layout de cada card
    const cards = COLOR_BOARD_DATA.map(cg => {
        const headerLines = wrapText(cg.label || cg.defaultLabel, 38);
        const headerH = Math.max(58, 26 + headerLines.length * 22);
        let bodyY = 20;
        const bodyItems = [];
        cg.sections.forEach((sec, sIdx) => {
            if (sIdx > 0) {
                bodyY += 10;
                bodyItems.push({ kind: 'hr', y: bodyY });
                bodyY += 18;
            }
            if (sec.title) {
                const secLines = wrapText(sec.title, 46);
                secLines.forEach(line => {
                    bodyItems.push({ kind: 'section', y: bodyY, text: line });
                    bodyY += 20;
                });
                bodyY += 4;
            }
            sec.groups.forEach(g => {
                const suffix = includeCounts ? ` (${g.docCount.toLocaleString('pt-BR')})` : '';
                const gLines = wrapText(g.name + suffix, sec.title ? 48 : 50);
                gLines.forEach((line, lIdx) => {
                    bodyItems.push({
                        kind: 'group',
                        y: bodyY,
                        text: line,
                        indent: sec.title ? (lIdx === 0 ? 18 : 26) : (lIdx === 0 ? 4 : 12),
                    });
                    bodyY += 19;
                });
            });
        });
        const bodyH = bodyY + 14;
        return { cg, headerLines, headerH, bodyItems, totalH: headerH + bodyH };
    });

    // Agrupa em linhas de `cols` cards, igualando altura por linha
    const rows = [];
    for (let i = 0; i < cards.length; i += cols) {
        const slice = cards.slice(i, i + cols);
        const rowH = Math.max(...slice.map(c => c.totalH));
        rows.push({ cards: slice, height: rowH });
    }

    const totalH = topTitleH + rows.reduce((acc, r) => acc + r.height + gap, 0) + 20;
    const parts = [];
    parts.push(`<svg xmlns="http://www.w3.org/2000/svg" width="${totalW}" height="${totalH}" viewBox="0 0 ${totalW} ${totalH}">`);
    parts.push(`<rect width="100%" height="100%" fill="#ffffff"/>`);
    parts.push(`<style>
        .t-main { font: 700 22px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; fill: #0f172a; }
        .t-sub  { font: 400 13px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; fill: #475569; }
        .t-hdr  { font: 700 16px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; fill: #0f172a; }
        .t-sec  { font: 700 13.5px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; fill: #1e293b; }
        .t-grp  { font: 400 13px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; fill: #334155; }
    </style>`);

    const titleShort = PROJECT_TITLE.length > 88 ? PROJECT_TITLE.slice(0, 85) + '…' : PROJECT_TITLE;
    parts.push(`<text x="${totalW / 2}" y="34" text-anchor="middle" class="t-main">Organização dos Grupos Temáticos</text>`);
    parts.push(`<text x="${totalW / 2}" y="55" text-anchor="middle" class="t-sub">${escapeXml(titleShort)}</text>`);

    let curY = topTitleH;
    rows.forEach(row => {
        row.cards.forEach((card, cIdx) => {
            const x = padX + cIdx * (cardW + gap);
            const y = curY;
            const h = row.height;
            const col = card.cg.color;
            const clipId = `clip_${x}_${y}`;
            parts.push(`<defs><clipPath id="${clipId}"><rect x="${x}" y="${y}" width="${cardW}" height="${h}" rx="12" ry="12"/></clipPath></defs>`);
            parts.push(`<g clip-path="url(#${clipId})">`);
            parts.push(`<rect x="${x}" y="${y}" width="${cardW}" height="${h}" fill="#ffffff"/>`);
            parts.push(`<rect x="${x}" y="${y}" width="${cardW}" height="${card.headerH}" fill="${hexToRgba(col, 0.12)}"/>`);
            parts.push(`<line x1="${x}" y1="${y + card.headerH}" x2="${x + cardW}" y2="${y + card.headerH}" stroke="${col}" stroke-width="1.5"/>`);
            const startTextY = y + (card.headerH - (card.headerLines.length - 1) * 22) / 2 + 5;
            card.headerLines.forEach((line, lIdx) => {
                parts.push(`<text x="${x + cardW / 2}" y="${startTextY + lIdx * 22}" text-anchor="middle" class="t-hdr">${escapeXml(line)}</text>`);
            });

            const bTop = y + card.headerH;
            card.bodyItems.forEach(it => {
                if (it.kind === 'hr') {
                    parts.push(`<line x1="${x + 18}" y1="${bTop + it.y}" x2="${x + cardW - 18}" y2="${bTop + it.y}" stroke="${hexToRgba(col, 0.35)}" stroke-width="1"/>`);
                } else if (it.kind === 'section') {
                    parts.push(`<text x="${x + 20}" y="${bTop + it.y + 12}" class="t-sec">${escapeXml(it.text)}</text>`);
                } else if (it.kind === 'group') {
                    parts.push(`<text x="${x + 20 + it.indent}" y="${bTop + it.y + 12}" class="t-grp">${escapeXml(it.text)}</text>`);
                }
            });
            parts.push(`</g>`);
            parts.push(`<rect x="${x}" y="${y}" width="${cardW}" height="${h}" rx="12" ry="12" fill="none" stroke="${col}" stroke-width="1.5"/>`);
        });
        curY += row.height + gap;
    });

    parts.push(`</svg>`);
    return { svg: parts.join('\n'), width: totalW, height: totalH };
}

function exportColorBoardSvg() {
    const { svg } = buildColorBoardSvg();
    const blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'organizacao-grupos-cores-projeto-{{ project.id }}.svg';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

function exportColorBoardPng() {
    const { svg, width, height } = buildColorBoardSvg();
    const scale = 2;
    const img = new Image();
    const blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = width * scale;
        canvas.height = height * scale;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.scale(scale, scale);
        ctx.drawImage(img, 0, 0);
        URL.revokeObjectURL(url);
        canvas.toBlob(pngBlob => {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(pngBlob);
            a.download = 'organizacao-grupos-cores-projeto-{{ project.id }}.png';
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
        }, 'image/png');
    };
    img.src = url;
}
</script>
{% endblock %}
