{% extends 'base.html.twig' %}

{% block title %}Nova Base de Dados — Admin{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_admin_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Admin</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_admin_academic_databases_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Bases de Dados</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <span class="current">Nova Base</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-plus-circle text-accent me-2"></i>Cadastrar Nova Base de Dados Acadêmica {{ help('admin.databases.form_page') }}
    </h1>
    <p class="bm-page-subtitle">Adicione uma nova base com regras de detecção de arquivos e informações sobre a estrutura de dados.</p>
</div>

<div class="bm-card col-lg-8">
    <form method="POST" action="{{ path('app_admin_academic_databases_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_database_new') }}">

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Nome da Base * {{ help('admin.databases.form.name') }}</label>
                <input type="text" name="name" class="form-control" placeholder="Ex: SciELO" required>
            </div>

            <div class="col-md-6">
                <label class="form-label">Sigla/Chave de Identificação * {{ help('admin.databases.form.acronym') }}</label>
                <input type="text" name="acronym" class="form-control" placeholder="Ex: scielo" required>
                <small class="text-muted-bm" style="font-size:11px">Salva em minúsculas (ex: scopus, wos, lens, pubmed).</small>
            </div>

            <div class="col-md-6">
                <label class="form-label">URL Principal (Website)</label>
                <input type="url" name="url" class="form-control" placeholder="Ex: https://scielo.org">
            </div>

            <div class="col-md-6">
                <label class="form-label">Caminho do Logo {{ help('admin.databases.form.logo') }}</label>
                <input type="text" name="logo" class="form-control" placeholder="Ex: /img/scielo-logo.svg">
                <small class="text-muted-bm" style="font-size:11px">Caminho relativo a /public (ex: /img/Scopus_logo.svg).</small>
            </div>

            <div class="col-md-12">
                <label class="form-label">Formatos de Arquivo Suportados {{ help('admin.databases.form.formats') }}</label>
                <input type="text" name="fileFormats" class="form-control" placeholder="Ex: csv, ris, txt">
                <small class="text-muted-bm" style="font-size:11px">Formatos separados por vírgula (ex: csv, ris).</small>
            </div>

            <div class="col-md-12">
                <label class="form-label">Colunas de Assinatura (detecção automática de CSV) {{ help('admin.databases.form.signature') }}</label>
                <textarea name="signatureColumns" class="form-control" rows="4" placeholder="PMID&#10;Title&#10;Authors&#10;Citation"></textarea>
                <small class="text-muted-bm" style="font-size:11px">Uma coluna por linha, escrita exatamente como no cabeçalho do CSV.</small>
            </div>

            <div class="col-md-12">
                <label class="form-label">Descrição {{ help('admin.databases.form.description') }}</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Breve resumo da base de dados acadêmica..."></textarea>
            </div>

            <div class="col-md-12">
                <label class="form-label">Instruções para Exportação/Importação (texto simples) {{ help('admin.databases.form.instructions') }}</label>
                <textarea name="importInstructions" class="form-control" rows="6" placeholder="Passo 1: Acesse o site...&#10;Passo 2: Faça a pesquisa...&#10;Passo 3: Escolha exportar como CSV..."></textarea>
                <small class="text-muted-bm" style="font-size:11px">Estas instruções serão exibidas no painel de importação ao selecionar esta base.</small>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('app_admin_academic_databases_index') }}" class="btn btn-bm-secondary" style="text-decoration:none">Cancelar</a>
            <button type="submit" class="btn btn-bm-primary">Salvar Cadastro</button>
        </div>
    </form>
</div>
{% endblock %}
