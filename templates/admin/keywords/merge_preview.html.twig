{% extends 'base.html.twig' %}

{% block title %}Mesclar Palavras-Chave — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_keywords_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Palavras-Chave</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Mesclar Registros</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-intersect text-warning me-2"></i>Mesclar e Consolidar Palavras-Chave
    </h1>
    <p class="bm-page-subtitle">Compare registros de palavras-chave lado a lado, selecione o registro Principal (Master) e defina qual termo preferido e tipo devem ser mantidos.</p>
</div>

<form action="{{ path('app_admin_keywords_merge_execute') }}" method="POST">
    <input type="hidden" name="_token" value="{{ csrf_token('merge_keywords') }}">
    {% for kw in keywords %}
        <input type="hidden" name="source_ids[]" value="{{ kw.id }}">
    {% endfor %}

    <div class="bm-card mb-4 border-warning">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-1" style="font-weight:700;color:var(--bm-text)">
                    <i class="bi bi-star-fill text-warning me-2"></i>1. Selecione o Registro Principal (Master)
                </h5>
                <p class="text-muted-bm mb-0" style="font-size:13px">A palavra-chave selecionada como Master será preservada. Os demais registros serão mesclados e convertidos em variações do Tesauro.</p>
            </div>
            <a href="{{ path('app_admin_keywords_index') }}" class="btn btn-sm btn-bm-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancelar
            </a>
        </div>

        <div class="row g-3 mt-2">
            {% for kw in keywords %}
                <div class="col">
                    <div class="card bg-bm-card border-bm p-3 h-100 position-relative" style="border-radius:10px">
                        <div class="form-check">
                            <input class="form-check-input me-2" type="radio" name="master_id" value="{{ kw.id }}" id="master_{{ kw.id }}" {% if loop.first %}checked{% endif %} required>
                            <label class="form-check-label fw-bold" for="master_{{ kw.id }}" style="font-size:14px;color:var(--bm-text)">
                                Registro #{{ kw.id }}
                            </label>
                        </div>
                        <div class="mt-2" style="font-size:13px;color:var(--bm-text)">
                            <div class="fw-bold">{{ kw.keywordOriginal }}</div>
                            <small class="text-muted-bm">Tipo: {{ kw.keywordType }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="bm-card mb-4">
        <h5 class="mb-3" style="font-weight:700">
            <i class="bi bi-layout-split text-accent me-2"></i>2. Escolha os Valores a Serem Mantidos
        </h5>
        
        <div class="table-responsive">
            <table class="table align-middle border-bm mb-0" style="color:var(--bm-text);font-size:13.5px">
                <thead>
                    <tr class="bg-bm-card border-bottom border-bm text-muted-bm" style="font-size:12px">
                        <th style="width:220px">Campo / Propriedade</th>
                        {% for kw in keywords %}
                            <th>
                                <span class="badge bg-secondary me-1">#{{ kw.id }}</span>
                                {{ kw.keywordOriginal|u.truncate(20, '...') }}
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {# Original Keyword #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Termo Original (Chave)</td>
                        {% for kw in keywords %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[keywordOriginal]" value="{{ kw.keywordOriginal }}" id="orig_{{ kw.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label fw-bold" for="orig_{{ kw.id }}">{{ kw.keywordOriginal }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Display Keyword #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Termo de Exibição</td>
                        {% for kw in keywords %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[keywordDisplay]" value="{{ kw.keywordDisplay }}" id="disp_{{ kw.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="disp_{{ kw.id }}">{{ kw.keywordDisplay ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Keyword Type #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Tipo da Palavra-chave</td>
                        {% for kw in keywords %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[keywordType]" value="{{ kw.keywordType }}" id="type_{{ kw.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label font-monospace text-accent" for="type_{{ kw.id }}">{{ kw.keywordType }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Variations Consolidation Preview -->
    <div class="bm-card mb-4 border-info">
        <h5 class="mb-2" style="font-weight:700;color:var(--bm-text)">
            <i class="bi bi-tags-fill text-info me-2"></i>3. Consolidação de Variações e Sinônimos (Tesauro)
        </h5>
        <p class="text-muted-bm mb-3" style="font-size:13px">
            Todas os termos e variações das palavras-chave selecionadas serão unificados e mantidos no registro Master.
        </p>

        <div class="d-flex flex-wrap gap-2 p-3 bg-bm-card border-bm rounded-3" style="max-height:160px;overflow-y:auto">
            {% for var in allVariations %}
                <span class="badge bg-dark-subtle text-body border px-2 py-1" style="font-size:12px">
                    <i class="bi bi-tag me-1"></i>{{ var }}
                </span>
            {% endfor %}
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end gap-3 mb-5">
        <a href="{{ path('app_admin_keywords_index') }}" class="btn btn-bm-secondary px-4 py-2">
            Cancelar
        </a>
        <button type="submit" class="btn btn-bm-primary px-4 py-2" onclick="return confirm('Confirmar a mesclagem? A palavra-chave Master será atualizada e as outras serão removidas.');">
            <i class="bi bi-intersect me-1"></i> Confirmar Mesclagem de Palavras-Chave
        </button>
    </div>
</form>
{% endblock %}
