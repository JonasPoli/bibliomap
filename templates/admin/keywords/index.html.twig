{% extends 'base.html.twig' %}

{% block title %}Gerenciar Palavras-chave — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Palavras-chave</span>
{% endblock %}

{% block topbar_actions %}
<div class="d-inline-flex gap-2">
    <a href="{{ path('app_admin_keywords_export') }}" class="btn btn-sm btn-bm-secondary px-3 py-2" style="text-decoration:none">
        <i class="bi bi-download me-1"></i> Exportar CSV
    </a>
    <button class="btn btn-sm btn-bm-secondary px-3 py-2" data-bs-toggle="modal" data-bs-target="#importModal">
        <i class="bi bi-upload me-1"></i> Importar CSV
    </button>
    <a href="{{ path('app_admin_keywords_new') }}" class="btn btn-sm btn-bm-primary px-3 py-2" style="text-decoration:none">
        <i class="bi bi-plus-circle me-1"></i> Nova Palavra-chave
    </a>
</div>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-tags text-accent me-2"></i>Gerenciamento de Palavras-chave
    </h1>
    <p class="bm-page-subtitle">Gerencie o cadastro de palavras-chave oficiais, tipos (autor, indexadas, mesh) e variações.</p>
</div>

<!-- Search Bar & Filters -->
<div class="bm-card mb-4">
    <form method="GET" action="{{ path('app_admin_keywords_index') }}" class="row g-2">
        <div class="col-md-5">
            <input type="text" name="search" class="form-control" placeholder="Buscar por termo da palavra-chave..." value="{{ search }}">
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="all" {% if type == 'all' %}selected{% endif %}>Todos os Tipos</option>
                <option value="author" {% if type == 'author' %}selected{% endif %}>Autor (Author Keyword)</option>
                <option value="indexed" {% if type == 'indexed' %}selected{% endif %}>Indexada (Keyword Plus)</option>
                <option value="mesh" {% if type == 'mesh' %}selected{% endif %}>Medical Subject Headings (MeSH)</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="all" {% if status == 'all' %}selected{% endif %}>Todos os Status</option>
                <option value="active" {% if status == 'active' %}selected{% endif %}>Ativas (Registradas)</option>
                <option value="inactive" {% if status == 'inactive' %}selected{% endif %}>Inativas (Brutas)</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-bm-secondary w-100"><i class="bi bi-search me-1"></i> Filtrar</button>
        </div>
    </form>
</div>

<!-- Keywords List -->
<div class="bm-card">
    {% if keywords is empty %}
        <div class="text-center py-5 text-muted-bm">
            <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
            Nenhuma palavra-chave encontrada.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle border-bm mb-0" style="color:var(--bm-text);font-size:13.5px">
                <thead>
                    <tr class="bg-bm-card border-bottom border-bm text-muted-bm" style="font-size:12px">
                        <th>Termo</th>
                        <th>Tipo</th>
                        <th>Variações</th>
                        <th>Status</th>
                        <th style="width:140px;text-align:right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for kw in keywords %}
                        <tr class="border-bm">
                            <td>
                                <div style="font-weight:600" class="text-accent">{{ kw.term }}</div>
                            </td>
                            <td>
                                {% if kw.type == 'author' %}
                                    <span class="badge bg-secondary">Autor</span>
                                {% elseif kw.type == 'indexed' %}
                                    <span class="badge bg-info text-dark">Indexada</span>
                                {% else %}
                                    <span class="badge" style="background:rgba(128,128,128,0.15); border:1px solid var(--bm-border); color:var(--bm-text)">MeSH</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge rounded-pill" title="Variações registradas" style="background:rgba(128,128,128,0.15); border:1px solid var(--bm-border); color:var(--bm-text)">
                                    {{ kw.variations|length }} variações
                                </span>
                            </td>
                            <td>
                                {% if kw.isStatus() %}
                                    <span class="badge" style="background:rgba(63,185,80,0.15);color:var(--bm-success);font-size:11px">Ativa</span>
                                {% else %}
                                    <span class="badge" style="background:rgba(210,153,34,0.15);color:var(--bm-warning);font-size:11px">Pendente / Bruto</span>
                                {% endif %}
                            </td>
                            <td style="text-align:right">
                                <div class="d-inline-flex gap-2">
                                    <a href="{{ path('app_admin_keywords_edit', {id: kw.id}) }}" class="btn btn-sm btn-bm-secondary px-2 py-1" style="font-size:12px" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="{{ path('app_admin_keywords_delete', {id: kw.id}) }}" method="POST" onsubmit="return confirm('Deseja realmente excluir esta palavra-chave?');" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_keyword_' ~ kw.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" style="font-size:12px" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block body_end %}
<!-- Import CSV Modal -->
<div class="modal fade animate__animated animate__fadeIn" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-bm" style="background:var(--bm-card-bg);color:var(--bm-text)">
            <div class="modal-header border-bm">
                <h5 class="modal-title" id="importModalLabel" style="font-weight:700">Importar Palavras-chave via CSV</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('app_admin_keywords_import') }}" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_keywords') }}">
                    <p style="font-size:13px;color:var(--bm-text-muted)">
                        Selecione o arquivo CSV contendo as colunas <code>term</code>, <code>type</code> (author, indexed, mesh), <code>status</code> e <code>variations</code> (separadas por ponto e vírgula).
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Arquivo CSV *</label>
                        <input type="file" name="csv_file" class="form-control" accept=".csv" required>
                    </div>
                </div>
                <div class="modal-footer border-bm">
                    <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-bm-primary">Importar Dados</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.querySelectorAll('form').forEach(form => {
            if (form.action.includes('/import')) {
                form.addEventListener('submit', function(e) {
                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        setTimeout(() => {
                            submitBtn.disabled = true;
                        }, 50);

                        const modal = form.closest('.modal');
                        if (modal) {
                            modal.querySelectorAll('button:not([type="submit"]), input, select, textarea').forEach(el => {
                                setTimeout(() => { el.disabled = true; }, 50);
                            });
                        }

                        let seconds = 0;
                        submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Importando... (${seconds}s)`;

                        setInterval(() => {
                            seconds++;
                            submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Importando... (${seconds}s)`;
                        }, 1000);
                    }
                });
            }
        });
    </script>
{% endblock %}
