{% extends 'base.html.twig' %}

{% block title %}Mesclar Instituições — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_institutions_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Instituições</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Mesclar Registros</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-intersect text-warning me-2"></i>Mesclar e Consolidar Instituições
    </h1>
    <p class="bm-page-subtitle">Compare instituições de ensino e pesquisa lado a lado, selecione a instituição Principal (Master) e defina individualmente o valor de cada atributo.</p>
</div>

<form action="{{ path('app_admin_institutions_merge_execute') }}" method="POST">
    <input type="hidden" name="_token" value="{{ csrf_token('merge_institutions') }}">
    {% for inst in institutions %}
        <input type="hidden" name="source_ids[]" value="{{ inst.id }}">
    {% endfor %}

    <div class="bm-card mb-4 border-warning">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-1" style="font-weight:700;color:var(--bm-text)">
                    <i class="bi bi-star-fill text-warning me-2"></i>1. Selecione a Instituição Principal (Master)
                </h5>
                <p class="text-muted-bm mb-0" style="font-size:13px">A instituição selecionada como Master será mantida. As demais serão mescladas e todos os seus nomes/siglas virarão variações do Tesauro.</p>
            </div>
            <a href="{{ path('app_admin_institutions_index') }}" class="btn btn-sm btn-bm-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancelar
            </a>
        </div>

        <div class="row g-3 mt-2">
            {% for inst in institutions %}
                <div class="col">
                    <div class="card bg-bm-card border-bm p-3 h-100 position-relative" style="border-radius:10px">
                        <div class="form-check">
                            <input class="form-check-input me-2" type="radio" name="master_id" value="{{ inst.id }}" id="master_{{ inst.id }}" {% if loop.first %}checked{% endif %} required>
                            <label class="form-check-label fw-bold" for="master_{{ inst.id }}" style="font-size:14px;color:var(--bm-text)">
                                Registro #{{ inst.id }}
                            </label>
                        </div>
                        <div class="mt-2" style="font-size:13px;color:var(--bm-text)">
                            <div class="fw-bold">{{ inst.officialName }}</div>
                            <small class="text-muted-bm">Sigla: {{ inst.sigla ?? '—' }} | IES: {{ inst.codigoIes ?? '—' }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="bm-card mb-4">
        <h5 class="mb-3" style="font-weight:700">
            <i class="bi bi-layout-split text-accent me-2"></i>2. Escolha os Valores a Serem Mantidos
        </h5>
        
        <div class="table-responsive">
            <table class="table align-middle border-bm mb-0" style="color:var(--bm-text);font-size:13.5px">
                <thead>
                    <tr class="bg-bm-card border-bottom border-bm text-muted-bm" style="font-size:12px">
                        <th style="width:240px">Campo / Propriedade</th>
                        {% for inst in institutions %}
                            <th>
                                <span class="badge bg-secondary me-1">#{{ inst.id }}</span>
                                {{ inst.sigla ? inst.sigla : (inst.officialName|length > 25 ? inst.officialName|slice(0, 25) ~ '...' : inst.officialName) }}
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {# Official Name #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Nome Oficial</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[officialName]" value="{{ inst.officialName }}" id="off_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label fw-bold" for="off_{{ inst.id }}">{{ inst.officialName }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Short Name #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Nome Curto</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[shortName]" value="{{ inst.shortName }}" id="short_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="short_{{ inst.id }}">{{ inst.shortName ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Sigla #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Sigla</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[sigla]" value="{{ inst.sigla }}" id="sigla_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label font-monospace fw-bold text-accent" for="sigla_{{ inst.id }}">{{ inst.sigla ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Razão Social #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Razão Social</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[razaoSocial]" value="{{ inst.razaoSocial }}" id="rs_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="rs_{{ inst.id }}">{{ inst.razaoSocial ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# CNPJ #}
                    <tr>
                        <td class="fw-bold bg-bm-card">CNPJ</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[cnpj]" value="{{ inst.cnpj }}" id="cnpj_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label font-monospace" for="cnpj_{{ inst.id }}">{{ inst.cnpj ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Código IES #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Código IES (e-MEC)</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[codigoIes]" value="{{ inst.codigoIes }}" id="ies_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="ies_{{ inst.id }}">{{ inst.codigoIes ? ('#' ~ inst.codigoIes) : '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Código Mantenedora #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Código Mantenedora (e-MEC)</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[codigoMantenedora]" value="{{ inst.codigoMantenedora }}" id="mant_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="mant_{{ inst.id }}">{{ inst.codigoMantenedora ? ('#' ~ inst.codigoMantenedora) : '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Tipo de Instituição #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Tipo de Instituição</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[institutionType]" value="{{ inst.institutionType }}" id="itype_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="itype_{{ inst.id }}">{{ inst.institutionType ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Natureza Jurídica #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Natureza Jurídica</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[natureza]" value="{{ inst.natureza }}" id="nat_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="nat_{{ inst.id }}">{{ inst.natureza ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Categoria #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Categoria</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[categoria]" value="{{ inst.categoria }}" id="cat_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="cat_{{ inst.id }}">{{ inst.categoria ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Categoria Administrativa #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Categoria Administrativa</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[categoriaAdministrativa]" value="{{ inst.categoriaAdministrativa }}" id="catadm_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="catadm_{{ inst.id }}">{{ inst.categoriaAdministrativa ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Organização Acadêmica #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Organização Acadêmica</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[organizacaoAcademica]" value="{{ inst.organizacaoAcademica }}" id="org_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="org_{{ inst.id }}">{{ inst.organizacaoAcademica ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Tipo de Credenciamento #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Tipo de Credenciamento</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[tipoCredenciamento]" value="{{ inst.tipoCredenciamento }}" id="cred_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="cred_{{ inst.id }}">{{ inst.tipoCredenciamento ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Situação da IES #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Situação da IES</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[situacaoIes]" value="{{ inst.situacaoIes }}" id="sit_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="sit_{{ inst.id }}">{{ inst.situacaoIes ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Reitor #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Reitor</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[reitor]" value="{{ inst.reitor }}" id="reitor_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="reitor_{{ inst.id }}">{{ inst.reitor ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Representante Legal #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Representante Legal</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[representanteLegal]" value="{{ inst.representanteLegal }}" id="rep_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="rep_{{ inst.id }}">{{ inst.representanteLegal ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Website Oficial #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Website Oficial</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[officialWebsite]" value="{{ inst.officialWebsite }}" id="web_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="web_{{ inst.id }}">{{ inst.officialWebsite ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Email Institucional #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Email Institucional</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[institutionalEmail]" value="{{ inst.institutionalEmail }}" id="email_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="email_{{ inst.id }}">{{ inst.institutionalEmail ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Telefone #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Telefone</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[telefone]" value="{{ inst.telefone }}" id="tel_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="tel_{{ inst.id }}">{{ inst.telefone ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Endereço da Sede #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Endereço da Sede</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[enderecoSede]" value="{{ inst.enderecoSede }}" id="end_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="end_{{ inst.id }}">{{ inst.enderecoSede ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Coordenadas Geográficas #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Coordenadas (Lat / Long)</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[coordsInstId]" value="{{ inst.id }}" id="coords_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="coords_{{ inst.id }}">
                                        {{ inst.latitude ? (inst.latitude ~ ', ' ~ inst.longitude) : '—' }}
                                    </label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Conceito Institucional (CI) #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Conceito CI / Ano</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[ciInstId]" value="{{ inst.id }}" id="ci_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="ci_{{ inst.id }}">
                                        {{ inst.ci ? ('CI ' ~ inst.ci ~ ' (' ~ inst.anoCi ~ ')') : '—' }}
                                    </label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Conceito CI-EAD #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Conceito CI-EAD / Ano</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[ciEadInstId]" value="{{ inst.id }}" id="ciead_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="ciead_{{ inst.id }}">
                                        {{ inst.ciEad ? ('CI-EAD ' ~ inst.ciEad ~ ' (' ~ inst.anoCiEad ~ ')') : '—' }}
                                    </label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Índice IGC #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Índice IGC / Ano</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[igcInstId]" value="{{ inst.id }}" id="igc_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="igc_{{ inst.id }}">
                                        {{ inst.igc ? ('IGC ' ~ inst.igc ~ ' (' ~ inst.anoIgc ~ ')') : '—' }}
                                    </label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Sinalizações Vigentes #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Sinalizações Vigentes</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[sinalizacoesVigentes]" value="{{ inst.sinalizacoesVigentes }}" id="sin_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="sin_{{ inst.id }}">{{ inst.sinalizacoesVigentes ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# VantagePoint #}
                    <tr>
                        <td class="fw-bold bg-bm-card">VantagePoint</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[vantagepoint]" value="{{ inst.vantagepoint }}" id="vp_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="vp_{{ inst.id }}">{{ inst.vantagepoint ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Localização #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Cidade / Estado / País</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[locationInstId]" value="{{ inst.id }}" id="loc_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="loc_{{ inst.id }}">
                                        {{ inst.city.officialName ?? '—' }} / {{ inst.state.officialName ?? '—' }} ({{ inst.country.commonName ?? '—' }})
                                    </label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Anos de Fundação / Extinção #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Período Histórico</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[foundationYear]" value="{{ inst.foundationYear }}" id="fy_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="fy_{{ inst.id }}">
                                        Fund: {{ inst.foundationYear ?? '—' }} | Ext: {{ inst.extinctionYear ?? '—' }}
                                    </label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# Observações #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Observações</td>
                        {% for inst in institutions %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[notes]" value="{{ inst.notes }}" id="notes_{{ inst.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label" for="notes_{{ inst.id }}">{{ inst.notes ?? '—' }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Variations Consolidation Preview -->
    <div class="bm-card mb-4 border-info">
        <h5 class="mb-2" style="font-weight:700;color:var(--bm-text)">
            <i class="bi bi-tags-fill text-info me-2"></i>3. Consolidação de Variações de Nome (Tesauro)
        </h5>
        <p class="text-muted-bm mb-3" style="font-size:13px">
            Todas os nomes oficiais, siglas e variações cadastradas de todos os registros selecionados serão automaticamente unificados sem duplicações e vinculados ao registro Master.
        </p>

        <div class="d-flex flex-wrap gap-2 p-3 bg-bm-card border-bm rounded-3" style="max-height:160px;overflow-y:auto">
            {% for var in allVariations %}
                <span class="badge bg-dark-subtle text-body border px-2 py-1" style="font-size:12px">
                    <i class="bi bi-tag me-1"></i>{{ var }}
                </span>
            {% endfor %}
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end gap-3 mb-5">
        <a href="{{ path('app_admin_institutions_index') }}" class="btn btn-bm-secondary px-4 py-2">
            Cancelar
        </a>
        <button type="submit" class="btn btn-bm-primary px-4 py-2" onclick="return confirm('Confirmar a mesclagem? A instituição Master será atualizada e as outras serão removidas.');">
            <i class="bi bi-intersect me-1"></i> Confirmar Mesclagem de Instituições
        </button>
    </div>
</form>
{% endblock %}
