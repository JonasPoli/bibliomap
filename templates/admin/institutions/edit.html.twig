{% extends 'base.html.twig' %}

{% block title %}Editar Instituição — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_institutions_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Instituições</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Editar</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-pencil text-accent me-2"></i>Editar: {{ institution.officialName }}
    </h1>
    <p class="bm-page-subtitle">Modifique os dados e-MEC, informações cadastrais e variações desta instituição.</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="bm-card">
            <form method="POST" action="{{ path('app_admin_institutions_edit', {id: institution.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_institution_' ~ institution.id) }}">

                <!-- Section 1: Informações Básicas -->
                <h5 class="fw-bold mb-3 text-accent"><i class="bi bi-info-circle me-1"></i> Informações Principais</h5>
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label">Nome Oficial Completo *</label>
                        <input type="text" name="officialName" class="form-control" value="{{ institution.officialName }}" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Razão Social (Mantenedora)</label>
                        <input type="text" name="razaoSocial" class="form-control" placeholder="Ex: FUNDACAO UNIVERSIDADE DE BRASILIA" value="{{ institution.razaoSocial }}">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Sigla Oficial</label>
                        <input type="text" name="sigla" class="form-control" placeholder="Ex: UNB" value="{{ institution.sigla }}">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">CNPJ</label>
                        <input type="text" name="cnpj" class="form-control" placeholder="00.000.000/0001-00" value="{{ institution.cnpj }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Código IES (e-MEC)</label>
                        <input type="number" name="codigoIes" class="form-control" placeholder="Ex: 2" value="{{ institution.codigoIes }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Código Mantenedora</label>
                        <input type="number" name="codigoMantenedora" class="form-control" placeholder="Ex: 2" value="{{ institution.codigoMantenedora }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Situação e-MEC</label>
                        <input type="text" name="situacaoIes" class="form-control" placeholder="Ex: Ativa" value="{{ institution.situacaoIes }}">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ano de Fundação <span class="text-muted">(opcional)</span></label>
                        <input type="number" name="foundationYear" class="form-control" placeholder="Ex: 1953" value="{{ institution.foundationYear }}">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ano de Extinção / Fim <span class="text-muted">(opcional)</span></label>
                        <input type="number" name="extinctionYear" class="form-control" placeholder="Ex: 1991" value="{{ institution.extinctionYear }}">
                    </div>
                </div>

                <hr class="my-4 border-bm">

                <!-- Section 2: Classificação e Organização Acadêmica -->
                <h5 class="fw-bold mb-3 text-accent"><i class="bi bi-diagram-3 me-1"></i> Classificação Acadêmica & Jurídica</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Organização Acadêmica</label>
                        <input type="text" name="organizacaoAcademica" class="form-control" placeholder="Ex: Universidade" value="{{ institution.organizacaoAcademica }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Categoria Administrativa</label>
                        <input type="text" name="categoriaAdministrativa" class="form-control" placeholder="Ex: Pública Federal" value="{{ institution.categoriaAdministrativa }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Tipo de Credenciamento</label>
                        <input type="text" name="tipoCredenciamento" class="form-control" placeholder="Ex: EAD - Superior / Presencial" value="{{ institution.tipoCredenciamento }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Natureza Jurídica</label>
                        <input type="text" name="natureza" class="form-control" placeholder="Ex: Pessoa Jurídica de Direito Público - Federal" value="{{ institution.natureza }}">
                    </div>
                </div>

                <hr class="my-4 border-bm">

                <!-- Section 3: Indicadores MEC / IGC -->
                <h5 class="fw-bold mb-3 text-accent"><i class="bi bi-award me-1"></i> Indicadores de Qualidade MEC</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label">IGC (Índice Geral)</label>
                        <input type="text" name="igc" class="form-control" placeholder="Ex: 5" value="{{ institution.igc }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ano IGC</label>
                        <input type="number" name="anoIgc" class="form-control" placeholder="2023" value="{{ institution.anoIgc }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">CI (Conceito Inst.)</label>
                        <input type="text" name="ci" class="form-control" placeholder="Ex: 5" value="{{ institution.ci }}">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ano CI</label>
                        <input type="number" name="anoCi" class="form-control" placeholder="2020" value="{{ institution.anoCi }}">
                    </div>
                </div>

                <hr class="my-4 border-bm">

                <!-- Section 4: Endereço e Coordenadas -->
                <h5 class="fw-bold mb-3 text-accent"><i class="bi bi-geo-alt me-1"></i> Localização & Endereço</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">País</label>
                        <select name="countryId" class="form-select">
                            <option value="">Selecione...</option>
                            {% for c in countries %}
                                <option value="{{ c.id }}" {% if institution.country and institution.country.id == c.id %}selected{% endif %}>{{ c.commonName }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Estado</label>
                        <select name="stateId" class="form-select">
                            <option value="">Selecione...</option>
                            {% for s in states %}
                                <option value="{{ s.id }}" {% if institution.state and institution.state.id == s.id %}selected{% endif %}>{{ s.officialName }} ({{ s.sigla }})</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Cidade</label>
                        <select name="cityId" class="form-select">
                            <option value="">Selecione...</option>
                            {% for ct in cities %}
                                <option value="{{ ct.id }}" {% if institution.city and institution.city.id == ct.id %}selected{% endif %}>{{ ct.officialName }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Endereço Sede</label>
                        <input type="text" name="enderecoSede" class="form-control" placeholder="Campus Universitário, CEP, Bairro..." value="{{ institution.enderecoSede }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Latitude</label>
                        <input type="text" name="latitude" class="form-control" placeholder="-15.7655" value="{{ institution.latitude }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Longitude</label>
                        <input type="text" name="longitude" class="form-control" placeholder="-47.8721" value="{{ institution.longitude }}">
                    </div>
                </div>

                <hr class="my-4 border-bm">

                <!-- Section 5: Contato e Gestão -->
                <h5 class="fw-bold mb-3 text-accent"><i class="bi bi-telephone me-1"></i> Contatos e Gestão</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Site Oficial</label>
                        <input type="url" name="officialWebsite" class="form-control" placeholder="www.unb.br" value="{{ institution.officialWebsite }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">E-mail Institucional</label>
                        <input type="email" name="institutionalEmail" class="form-control" placeholder="contato@unb.br" value="{{ institution.institutionalEmail }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Telefone</label>
                        <input type="text" name="telefone" class="form-control" placeholder="(61) 3107-0000" value="{{ institution.telefone }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Reitor / Dirigente Principal</label>
                        <input type="text" name="reitor" class="form-control" value="{{ institution.reitor }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Representante Legal</label>
                        <input type="text" name="representanteLegal" class="form-control" value="{{ institution.representanteLegal }}">
                    </div>

                    <div class="col-12">
                        <label class="form-label">String Vantagepoint</label>
                        <input type="text" name="vantagepoint" class="form-control font-monospace" placeholder="**UNB0 1 UNIVERSIDADE DE BRASILIA" value="{{ institution.vantagepoint }}">
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="status" id="status" value="1" {% if institution.isStatus() %}checked{% endif %}>
                            <label class="form-check-label" for="status">Instituição Ativa</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Observações</label>
                        <textarea name="notes" class="form-control" rows="2">{{ institution.notes }}</textarea>
                    </div>
                </div>

                <!-- Variations Textarea -->
                <div class="mb-4">
                    <h5 class="mb-2 fw-bold">Edição em Massa das Variações</h5>
                    <p style="font-size:12px;color:var(--bm-text-muted)">
                        Adicione variações de escrita da instituição (uma por linha). O sistema usará esta lista para vincular os artigos automaticamente.
                    </p>
                    <textarea name="variationsText" class="form-control font-monospace" rows="5" placeholder="UNB&#10;Univ. de Brasília&#10;Universidade de Brasilia">{{ variationsText }}</textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_admin_institutions_index') }}" class="btn-bm-secondary btn" style="text-decoration:none">Cancelar</a>
                    <button type="submit" class="btn-bm-primary">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Variation list & Merge Card -->
    <div class="col-lg-4">
        <div class="bm-card mb-4">
            <h5 style="font-weight:700" class="mb-3">Variações Cadastradas</h5>
            <p style="font-size:12px;color:var(--bm-text-muted)" class="mb-3">
                Variações registradas para esta instituição. Você pode desmembrar qualquer uma para torná-la uma instituição independente.
            </p>
            {% set hasAlternatives = false %}
            <div class="list-group list-group-flush border-bm rounded">
                {% for v in institution.variations %}
                    {% if v.variationType == 'alternative' or v.variationType == 'razao_social' %}
                        {% set hasAlternatives = true %}
                        <div class="list-group-item bg-bm-card border-bm d-flex justify-content-between align-items-center py-2" style="font-size:13px;color:var(--bm-text)">
                            <span class="font-monospace text-accent">{{ v.variationName }}</span>
                            <form action="{{ path('app_admin_institutions_variation_separate', {id: v.id}) }}" method="POST" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('separate_var_' ~ v.id) }}">
                                <button type="submit" class="btn btn-xs btn-outline-warning px-2 py-0" style="font-size:11px" onclick="return confirm('Deseja transformar esta variação em uma nova instituição independente?');">
                                    Desmembrar
                                </button>
                            </form>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% if not hasAlternatives %}
                <div class="text-center py-3 text-muted-bm" style="font-size:12.5px">Nenhuma variação alternativa cadastrada.</div>
            {% endif %}
        </div>

        <div class="bm-card">
            <h5 style="font-weight:700" class="mb-2 text-danger">Mesclar Instituição</h5>
            <p style="font-size:12px;color:var(--bm-text-muted)" class="mb-3">
                Transfira todos os artigos vinculados e variações para a instituição selecionada abaixo, excluindo este registro permanentemente.
            </p>
            <form action="{{ path('app_admin_institutions_merge', {id: institution.id}) }}" method="POST" onsubmit="return confirm('Deseja realmente mesclar e excluir esta instituição? A ação não poderá ser desfeita.');">
                <input type="hidden" name="_token" value="{{ csrf_token('merge_institution_' ~ institution.id) }}">
                <div class="mb-3">
                    <label class="form-label" style="font-size:12px">Instituição de Destino</label>
                    <select name="targetId" class="form-select" style="font-size:12.5px" required>
                        <option value="">Selecione...</option>
                        {% for other in other_institutions %}
                            <option value="{{ other.id }}">{{ other.officialName }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-danger w-100"><i class="bi bi-shuffle me-1"></i> Mesclar e Excluir</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
