{% extends 'base.html.twig' %}

{% block title %}Gerenciar Instituições — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Instituições</span>
{% endblock %}

{% block topbar_actions %}
<div class="d-inline-flex gap-2">
    <div class="dropdown">
        <button class="btn btn-sm btn-bm-secondary px-3 py-2 dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i> Exportar Tesauro
        </button>
        <ul class="dropdown-menu dropdown-menu-dark">
            <li><a class="dropdown-item" href="{{ path('app_admin_institutions_export_thesaurus', {format: 'the'}) }}"><i class="bi bi-file-earmark-text me-2"></i>VantagePoint (.the)</a></li>
            <li><a class="dropdown-item" href="{{ path('app_admin_institutions_export_thesaurus', {format: 'csv'}) }}"><i class="bi bi-filetype-csv me-2"></i>CSV (.csv)</a></li>
        </ul>
    </div>
    <button class="btn btn-sm btn-bm-secondary px-3 py-2" data-bs-toggle="modal" data-bs-target="#importThesaurusModal">
        <i class="bi bi-upload me-1"></i> Importar Tesauro
    </button>
    <a href="{{ path('app_admin_institutions_export') }}" class="btn btn-sm btn-bm-secondary px-3 py-2" style="text-decoration:none">
        <i class="bi bi-download me-1"></i> Exportar CSV
    </a>
    <button class="btn btn-sm btn-bm-secondary px-3 py-2" data-bs-toggle="modal" data-bs-target="#importModal">
        <i class="bi bi-upload me-1"></i> Importar CSV
    </button>
    <a href="{{ path('app_admin_institutions_new') }}" class="btn btn-sm btn-bm-primary px-3 py-2" style="text-decoration:none">
        <i class="bi bi-plus-circle me-1"></i> Nova Instituição
    </a>
</div>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-building text-accent me-2"></i>Gerenciamento de Instituições e-MEC
    </h1>
    <p class="bm-page-subtitle">Cadastre, padronize e consulte universidades, dados do e-MEC, códigos IES, indicadores e siglas.</p>
</div>

<!-- Search Bar -->
<div class="bm-card mb-4">
    <form method="GET" action="{{ path('app_admin_institutions_index') }}" class="row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="search" class="form-control" placeholder="Buscar por nome oficial, sigla, razão social, CNPJ, código IES, variações ou localização..." value="{{ search }}">
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn-bm-secondary flex-grow-1"><i class="bi bi-search me-1"></i> Filtrar</button>
            {% if search %}
                <a href="{{ path('app_admin_institutions_index') }}" class="btn btn-outline-secondary" title="Limpar Filtro"><i class="bi bi-x-circle"></i></a>
            {% endif %}
        </div>
    </form>
</div>

<!-- Institutions List -->
<div class="bm-card">
    {% if institutions is empty %}
        <div class="text-center py-5 text-muted-bm">
            <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
            Nenhuma instituição encontrada.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle border-bm mb-0" style="color:var(--bm-text);font-size:13.5px">
                <thead>
                    <tr class="bg-bm-card border-bottom border-bm text-muted-bm" style="font-size:12px">
                        <th>Nome Oficial / Razão Social</th>
                        <th>Sigla</th>
                        <th>Identificação e-MEC</th>
                        <th>Tipo / Natureza</th>
                        <th>Localização</th>
                        <th>IGC / CI</th>
                        <th>Variações</th>
                        <th>Status</th>
                        <th style="width:120px;text-align:right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for inst in institutions %}
                        <tr class="border-bm">
                            <td>
                                <div style="font-weight:600">{{ inst.officialName }}</div>
                                {% if inst.razaoSocial and inst.razaoSocial != inst.officialName %}
                                    <small class="text-muted-bm d-block" style="font-size:11.5px">{{ inst.razaoSocial }}</small>
                                {% elseif inst.shortName %}
                                    <small class="text-muted-bm d-block" style="font-size:11.5px">{{ inst.shortName }}</small>
                                {% endif %}
                            </td>
                            <td class="font-monospace text-accent fw-bold">{{ inst.sigla ?? '—' }}</td>
                            <td>
                                {% if inst.codigoIes or inst.cnpj %}
                                    <div style="font-size:11.5px">
                                        {% if inst.codigoIes %}<span class="badge bg-dark-subtle text-body border me-1">IES #{{ inst.codigoIes }}</span>{% endif %}
                                        {% if inst.cnpj %}<small class="text-muted-bm d-block">CNPJ: {{ inst.cnpj }}</small>{% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted-bm">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-secondary" style="font-size:11px">{{ inst.organizacaoAcademica ?? inst.institutionType ?? 'Universidade' }}</span>
                                <span class="badge" style="background:rgba(79,142,247,0.12);color:var(--bm-accent);font-size:11px">{{ inst.categoriaAdministrativa ?? inst.natureza ?? 'Pública' }}</span>
                            </td>
                            <td>
                                {% if inst.country %}
                                    <div style="font-size:12.5px">
                                        <i class="bi bi-geo-alt me-1 text-muted-bm"></i>
                                        {{ inst.city ? inst.city.officialName : '' }}
                                        {{ inst.state ? (inst.city ? ', ' : '') ~ inst.state.sigla : '' }}
                                        {% if not inst.city and not inst.state %}{{ inst.country.commonName }}{% endif %}
                                    </div>
                                {% else %}
                                    <span class="text-muted-bm">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if inst.igc or inst.ci %}
                                    <span class="badge bg-info-subtle text-info-emphasis" style="font-size:11px">IGC: {{ inst.igc ?? '—' }}</span>
                                    <span class="badge bg-primary-subtle text-primary-emphasis" style="font-size:11px">CI: {{ inst.ci ?? '—' }}</span>
                                {% else %}
                                    <span class="text-muted-bm">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge rounded-pill" title="Variações registradas" style="background:rgba(128,128,128,0.15); border:1px solid var(--bm-border); color:var(--bm-text)">
                                    {{ inst.variations|length }} variações
                                </span>
                            </td>
                            <td>
                                {% if inst.isStatus() %}
                                    <span class="badge" style="background:rgba(63,185,80,0.15);color:var(--bm-success);font-size:11px">Ativa</span>
                                {% else %}
                                    <span class="badge" style="background:rgba(248,81,73,0.15);color:var(--bm-danger);font-size:11px">Inativa</span>
                                {% endif %}
                            </td>
                            <td style="text-align:right">
                                <div class="d-inline-flex gap-2">
                                    <a href="{{ path('app_admin_institutions_edit', {id: inst.id}) }}" class="btn btn-sm btn-bm-secondary px-2 py-1" style="font-size:12px" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="{{ path('app_admin_institutions_delete', {id: inst.id}) }}" method="POST" onsubmit="return confirm('Deseja realmente excluir esta instituição?');" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_institution_' ~ inst.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" style="font-size:12px" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        {% if totalPages > 1 %}
            <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top border-bm gap-2">
                <div style="font-size:13px;color:var(--bm-text-muted)">
                    Exibindo <b>{{ institutions|length }}</b> de <b>{{ totalItems|number_format(0, ',', '.') }}</b> instituições (Página <b>{{ currentPage }}</b> de <b>{{ totalPages }}</b>)
                </div>
                <nav aria-label="Navegação de instituições">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item {% if currentPage <= 1 %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_institutions_index', {page: 1, search: search}) }}" title="Primeira Página">&laquo;&laquo;</a>
                        </li>
                        <li class="page-item {% if currentPage <= 1 %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_institutions_index', {page: currentPage - 1, search: search}) }}">&laquo; Anterior</a>
                        </li>
                        
                        {% set startPage = max(1, currentPage - 2) %}
                        {% set endPage = min(totalPages, currentPage + 2) %}
                        
                        {% for p in startPage..endPage %}
                            <li class="page-item {% if p == currentPage %}active{% endif %}">
                                <a class="page-link" href="{{ path('app_admin_institutions_index', {page: p, search: search}) }}">{{ p }}</a>
                            </li>
                        {% endfor %}

                        <li class="page-item {% if currentPage >= totalPages %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_institutions_index', {page: currentPage + 1, search: search}) }}">Próxima &raquo;</a>
                        </li>
                        <li class="page-item {% if currentPage >= totalPages %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_institutions_index', {page: totalPages, search: search}) }}" title="Última Página">&raquo;&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        {% else %}
            <div class="mt-3 pt-3 border-top border-bm" style="font-size:13px;color:var(--bm-text-muted)">
                Total: <b>{{ totalItems|number_format(0, ',', '.') }}</b> instituição(ões) encontrada(s).
            </div>
        {% endif %}
    {% endif %}
</div>

<!-- Import CSV Modal -->
<div class="modal fade animate__animated animate__fadeIn" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-bm" style="background:var(--bm-card-bg);color:var(--bm-text)">
            <div class="modal-header border-bm">
                <h5 class="modal-title" id="importModalLabel" style="font-weight:700">Importar Instituições via CSV</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('app_admin_institutions_import') }}" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_institutions') }}">
                    <p style="font-size:13px;color:var(--bm-text-muted)">
                        Selecione o arquivo CSV formatado com as colunas especificadas. O sistema criará novas instituições ou atualizará as existentes com base no nome oficial para evitar duplicados.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Arquivo CSV *</label>
                        <input type="file" name="csv_file" class="form-control" accept=".csv" required>
                    </div>
                </div>
                <div class="modal-footer border-bm">
                    <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-bm-primary">Importar Dados</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import Thesaurus Modal -->
<div class="modal fade animate__animated animate__fadeIn" id="importThesaurusModal" tabindex="-1" aria-labelledby="importThesaurusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-bm" style="background:var(--bm-card-bg);color:var(--bm-text)">
            <div class="modal-header border-bm">
                <h5 class="modal-title" id="importThesaurusModalLabel" style="font-weight:700">Importar Tesauro de Instituições</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('app_admin_institutions_import_thesaurus') }}" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_institutions_thesaurus') }}">
                    <p style="font-size:13px;color:var(--bm-text-muted)">
                        Envie um arquivo no formato <b>VantagePoint (.the)</b> ou <b>CSV (.csv)</b> contendo termos preferidos e suas variações.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Arquivo de Tesauro (.the ou .csv) *</label>
                        <input type="file" name="thesaurus_file" class="form-control" accept=".the,.csv" required>
                    </div>
                </div>
                <div class="modal-footer border-bm">
                    <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-bm-primary">Importar Tesauro</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
