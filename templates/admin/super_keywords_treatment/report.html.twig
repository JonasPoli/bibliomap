{% extends 'base.html.twig' %}

{% block title %}Relatório de Tratamento #{{ job.id }} — Admin{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_admin_index') }}">Administração</a>
    <span class="mx-2 text-muted">/</span>
    <a href="{{ path('app_super_admin_keyword_treatment_index') }}">Tratamento de Palavras-chave</a>
    <span class="mx-2 text-muted">/</span>
    <span class="current">Relatório do Job #{{ job.id }}</span>
{% endblock %}

{% block body %}
<div class="bm-page-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="bm-page-title"><i class="bi bi-file-earmark-bar-graph me-2"></i>Relatório do Job #{{ job.id }}</h1>
        <p class="bm-page-subtitle">Processamento finalizado em <strong>{{ job.finishedAt|date('d/m/Y H:i:s') }}</strong>. Modo: <code>{{ job.mode }}</code>. Executor: <code>{{ job.startedBy }}</code>.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_super_admin_keyword_treatment_report_export', {id: job.id}) }}" class="btn btn-bm-primary">
            <i class="bi bi-download me-1"></i>Exportar Relatório CSV
        </a>
        <a href="{{ path('app_super_admin_keyword_treatment_index') }}" class="btn btn-bm-secondary">
            <i class="bi bi-arrow-left me-1"></i>Voltar
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-6 col-md-2">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-white">{{ job.totalKeywords }}</div>
            <div class="bm-stat-label">Total Processado</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-info">{{ job.cleanedCount }}</div>
            <div class="bm-stat-label">Higienizados</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-success">{{ job.exactMatchedCount }}</div>
            <div class="bm-stat-label">Match Exato</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-primary">{{ job.thesaurusMatchedCount }}</div>
            <div class="bm-stat-label">Tesauro</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-warning">{{ job.fuzzyAutoMatchedCount }}</div>
            <div class="bm-stat-label">Fuzzy Auto</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-danger">{{ job.suspiciousCount }}</div>
            <div class="bm-stat-label">Suspeitos</div>
        </div>
    </div>
</div>
{% if job.affectedDocumentCount > 0 %}
<div class="row g-4 mb-4">
    <div class="col-6">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-white">{{ job.affectedDocumentKeywordCount }}</div>
            <div class="bm-stat-label">DocumentKeywords Afetados</div>
        </div>
    </div>
    <div class="col-6">
        <div class="bm-card text-center">
            <div class="bm-stat-value text-white">{{ job.affectedDocumentCount }}</div>
            <div class="bm-stat-label">Documentos Afetados</div>
        </div>
    </div>
</div>
{% endif %}

<div class="row g-4">
    <!-- Top 50 Groupings -->
    <div class="col-lg-7">
        <div class="bm-card mb-4">
            <h5 class="text-white mb-3"><i class="bi bi-diagram-3 me-2"></i>Principais Agrupamentos Realizados (Top 50)</h5>
            <div class="table-responsive" style="max-height:450px;overflow-y:auto">
                <table class="table table-dark align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Conceito Alvo (Destino)</th>
                            <th>Termos e Variações Agrupados (P1/P2)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if top_groupings is empty %}
                            <tr>
                                <td colspan="2" class="text-center py-4 text-muted">Nenhum agrupamento de conceito efetuado neste job.</td>
                            </tr>
                        {% else %}
                            {% for concept, items in top_groupings %}
                                <tr>
                                    <td><span class="text-white fw-bold">{{ concept }}</span></td>
                                    <td>
                                        {% for it in items %}
                                            <span class="badge bg-secondary text-dark me-1" style="font-size:10px">{{ it }}</span>
                                        {% endfor %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Invalid & Fuzzy Suggestions -->
    <div class="col-lg-5">
        <!-- Invalid Terms Card -->
        <div class="bm-card mb-4">
            <h5 class="text-white mb-3"><i class="bi bi-x-circle me-2"></i>Termos Identificados como Inválidos</h5>
            <div class="table-responsive" style="max-height:220px;overflow-y:auto">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Termo Original</th>
                            <th>Motivo do Alerta</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if invalid_terms is empty %}
                            <tr>
                                <td colspan="2" class="text-center py-3 text-muted">Nenhum termo inválido detectado.</td>
                            </tr>
                        {% else %}
                            {% for item in invalid_terms %}
                                <tr>
                                    <td><span class="text-danger fw-bold">{{ item.keyword.keywordOriginal }}</span></td>
                                    <td><code>{{ item.reason }}</code></td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Fuzzy Suggestions Card -->
        <div class="bm-card">
            <h5 class="text-white mb-3"><i class="bi bi-question-circle me-2"></i>Sugestões Fuzzy Geradas (Aguardando Revisão)</h5>
            <div class="table-responsive" style="max-height:220px;overflow-y:auto">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Termo</th>
                            <th>Conceito Sugerido</th>
                            <th>Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if fuzzy_suggestions is empty %}
                            <tr>
                                <td colspan="3" class="text-center py-3 text-muted">Nenhuma sugestão fuzzy pendente de revisão.</td>
                            </tr>
                        {% else %}
                            {% for item in fuzzy_suggestions %}
                                <tr>
                                    <td><span class="text-white">{{ item.keyword.keywordDisplay }}</span></td>
                                    <td><span class="text-info">{{ item.newThesaurusConcept ? item.newThesaurusConcept.preferredLabel : (item.newConcept ? item.newConcept.keywordDisplay : item.reason) }}</span></td>
                                    <td><span class="badge bg-warning text-dark">{{ item.score|round(1) }}%</span></td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
