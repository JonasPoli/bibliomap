{% extends 'base.html.twig' %}

{% block title %}Tratamento de Palavras-chave — Super Admin — Plataforma Bibliométrica{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_admin_index') }}">Administração</a>
    <span class="mx-2 text-muted">/</span>
    <span class="current">Tratamento de Palavras-chave</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title"><i class="bi bi-magic me-2"></i>Tratamento de Palavras-chave {{ help('admin.kwtreat.page') }}</h1>
    <p class="bm-page-subtitle">Limpeza, invalidação de lixo, agrupamento de grafias iguais e ligação ao tesauro (exata ou por similaridade) de todas as palavras-chave da plataforma.</p>
</div>

<div class="row g-4">
    <!-- Diagnosis Column -->
    <div class="col-lg-8">
        <div class="bm-card mb-4">
            <h5 class="mb-4 text-white"><i class="bi bi-activity me-2"></i>Diagnóstico da Base de Dados {{ help('admin.kwtreat.diagnosis') }}</h5>
            
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="p-3 border border-secondary rounded text-center">
                        <div class="bm-stat-value text-white">{{ diagnosis.total }}</div>
                        <div class="bm-stat-label">Total de palavras-chave {{ help('admin.kwtreat.kpi_total') }}</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 border border-secondary rounded text-center">
                        <div class="bm-stat-value text-warning">{{ diagnosis.dirtyCount }}</div>
                        <div class="bm-stat-label">Com sujeiras* {{ help('admin.kwtreat.kpi_dirty') }}</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 border border-secondary rounded text-center">
                        <div class="bm-stat-value text-danger">{{ diagnosis.invalidCount }}</div>
                        <div class="bm-stat-label">Inválidas* {{ help('admin.kwtreat.kpi_invalid') }}</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 border border-secondary rounded text-center">
                        <div class="bm-stat-value text-info">{{ diagnosis.duplicatesCount }}</div>
                        <div class="bm-stat-label">Duplicadas {{ help('admin.kwtreat.kpi_duplicates') }}</div>
                    </div>
                </div>
            </div>

            <p class="text-muted small mb-3">* Calculado sobre os primeiros 10.000 termos (por ID).</p>
            <h6 class="text-white mb-3">Resumo Adicional {{ help('admin.kwtreat.summary') }}</h6>
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-muted d-flex justify-content-between px-0">
                            <span>Sem Display Formatado:</span>
                            <span class="text-white fw-bold">{{ diagnosis.noDisplay }}</span>
                        </li>
                        <li class="list-group-item bg-transparent text-muted d-flex justify-content-between px-0">
                            <span>Sem Comparação Normalizada:</span>
                            <span class="text-white fw-bold">{{ diagnosis.noNormalized }}</span>
                        </li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-muted d-flex justify-content-between px-0">
                            <span>Sem Conceito Vinculado:</span>
                            <span class="text-white fw-bold">{{ diagnosis.noThesaurusConcept }}</span>
                        </li>
                        <li class="list-group-item bg-transparent text-muted d-flex justify-content-between px-0">
                            <span>Com Conceito Vinculado:</span>
                            <span class="text-white fw-bold">{{ diagnosis.hasThesaurusConcept }}</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="bm-card">
            <h5 class="mb-4 text-white"><i class="bi bi-clock-history me-2"></i>Histórico de Processamentos Recentes {{ help('admin.kwtreat.history') }}</h5>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Data/Hora</th>
                            <th>Modo</th>
                            <th>Status</th>
                            <th>Total Termos</th>
                            <th>Limpos</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if jobs is empty %}
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Nenhum processamento registrado.</td>
                            </tr>
                        {% else %}
                            {% for job in jobs %}
                                <tr>
                                    <td><code>#{{ job.id }}</code></td>
                                    <td>{{ job.createdAt|date('d/m/Y H:i:s') }}</td>
                                    <td>
                                        <span class="badge {% if job.mode == 'execute' %}bg-success{% else %}bg-secondary text-dark{% endif %}">
                                            {{ job.mode == 'execute' ? 'Real' : 'Simulação' }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge {% if job.status == 'completed' %}bg-info{% elseif job.status == 'failed' %}bg-danger{% else %}bg-warning text-dark{% endif %}">
                                            {{ ({completed: 'Concluído', failed: 'Falhou', running: 'Em execução'})[job.status] ?? job.status }}
                                        </span>
                                    </td>
                                    <td>{{ job.totalKeywords }}</td>
                                    <td>{{ job.cleanedCount }}</td>
                                    <td>
                                        <a href="{{ path('app_super_admin_keyword_treatment_report', {id: job.id}) }}" class="btn btn-sm btn-bm-secondary">
                                            <i class="bi bi-file-earmark-bar-graph"></i> Ver Relatório
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Actions Column -->
    <div class="col-lg-4">
        <div class="bm-card mb-4">
            <h5 class="mb-3 text-white"><i class="bi bi-play-fill me-2"></i>Executar Novo Processamento {{ help('admin.kwtreat.run') }}</h5>
            <p class="text-muted small">Rode sempre uma simulação antes do modo Real.</p>
            
            <form action="{{ path('app_super_admin_keyword_treatment_run') }}" method="post" onsubmit="return confirmAction(this);">
                <input type="hidden" name="_token" value="{{ csrf_token('kw_treatment_run') }}">
                <input type="hidden" name="stages_submitted" value="1">
                <div class="mb-3">
                    <label class="form-label">Modo de Operação {{ help('admin.kwtreat.mode') }}</label>
                    <select name="mode" class="form-select" id="treatment-mode" onchange="updateWarningMsg()">
                        <option value="dry_run">Simulação (não altera palavras-chave)</option>
                        <option value="execute">Real (grava as mudanças no banco)</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Score Mínimo Fuzzy (%) {{ help('admin.kwtreat.min_score') }}</label>
                    <input type="number" name="min_score" class="form-control" value="95" min="70" max="100">
                    <div class="form-text text-muted">A partir deste valor a ligação ao tesauro é automática; entre 75 e ele, vira sugestão para revisão.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Limite Máximo de Termos {{ help('admin.kwtreat.limit') }}</label>
                    <input type="number" name="limit" class="form-control" value="5000" min="100" max="25000">
                </div>

                <div class="mb-4">
                    <label class="form-label">Etapas</label>
                    {% for key, label in {process_invalids: '1. Limpeza e invalidação', process_exact: '2. Agrupamento exato', process_thesaurus: '3. Ligação exata ao tesauro', process_fuzzy: '4. Ligação por similaridade'} %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="{{ key }}" value="1" id="stage-{{ key }}" checked>
                            <label class="form-check-label small" for="stage-{{ key }}">{{ label }}</label>
                        </div>
                    {% endfor %}
                </div>

                <div class="alert alert-warning d-none text-dark" id="warning-alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Atenção:</strong> o modo Real altera exibição e normalização, invalida termos-lixo, vincula termos a conceitos e <strong>funde duplicatas apagando o registro repetido</strong>. Não há desfazer: faça backup do banco antes.
                </div>

                <button type="submit" class="btn btn-bm-primary w-100 fw-bold py-2">
                    <i class="bi bi-cpu me-2"></i>Iniciar Processo
                </button>
            </form>
        </div>

        <div class="bm-card">
            <h5 class="mb-3 text-white"><i class="bi bi-shield-exclamation me-2"></i>Revisão Manual {{ help('admin.kwtreat.review_card') }}</h5>
            <p class="text-muted small">Atualmente existem <strong>{{ pending_reviews_count }}</strong> sugestões fuzzy geradas que necessitam de validação ou recusa manual.</p>
            <a href="{{ path('app_super_admin_keyword_treatment_review') }}" class="btn btn-bm-secondary w-100 fw-bold">
                <i class="bi bi-eye-fill me-2"></i>Abrir Tela de Revisão
            </a>
        </div>
    </div>
</div>

<script>
function updateWarningMsg() {
    const mode = document.getElementById('treatment-mode').value;
    const alert = document.getElementById('warning-alert');
    if (mode === 'execute') {
        alert.classList.remove('d-none');
    } else {
        alert.classList.add('d-none');
    }
}

function confirmAction(form) {
    const mode = document.getElementById('treatment-mode').value;
    if (mode === 'execute') {
        return confirm('Modo REAL: as palavras-chave de TODOS os projetos serão alteradas e duplicatas serão fundidas (registros repetidos apagados). Não há como desfazer. Continuar?');
    }
    return true;
}
</script>
{% endblock %}
