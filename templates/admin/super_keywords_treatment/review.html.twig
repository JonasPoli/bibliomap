{% extends 'base.html.twig' %}

{% block title %}Revisão Manual de Palavras-chave — Admin{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_admin_index') }}">Administração</a>
    <span class="mx-2 text-muted">/</span>
    <a href="{{ path('app_super_admin_keyword_treatment_index') }}">Tratamento de Palavras-chave</a>
    <span class="mx-2 text-muted">/</span>
    <span class="current">Revisão de Sugestões Fuzzy</span>
{% endblock %}

{% block body %}
<div class="bm-page-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="bm-page-title"><i class="bi bi-shield-fill-exclamation me-2"></i>Revisão e Validação de Palavras-chave</h1>
        <p class="bm-page-subtitle">Abaixo estão listadas as variações e sinônimos detectados por similaridade de grafia. Valide ou rejeite as propostas.</p>
    </div>
    <a href="{{ path('app_super_admin_keyword_treatment_index') }}" class="btn btn-bm-secondary">
        <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
</div>

<div class="bm-card">
    <h5 class="text-white mb-4"><i class="bi bi-list-task me-2"></i>Sugestões de Agrupamento Pendentes ({{ logs|length }})</h5>
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Termo Importado</th>
                    <th>Forma Normalizada</th>
                    <th>Conceito Alvo Sugerido</th>
                    <th>Score de Similaridade</th>
                    <th class="text-end" style="min-width:320px">Ações e Resoluções</th>
                </tr>
            </thead>
            <tbody>
                {% if logs is empty %}
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Nenhuma sugestão de agrupamento pendente de revisão.</td>
                    </tr>
                {% else %}
                    {% for log in logs %}
                        <tr>
                            <td>
                                <span class="text-white fw-bold">{{ log.keyword.keywordDisplay }}</span>
                            </td>
                            <td><code>{{ log.keyword.keywordNormalized }}</code></td>
                            <td>
                                <span class="text-info fw-bold"><i class="bi bi-tag-fill me-1"></i>{{ log.newConcept.keywordDisplay }}</span>
                            </td>
                            <td>
                                <span class="badge bg-warning text-dark">{{ log.score|round(1) }}%</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <!-- Approve -->
                                    <form action="{{ path('app_super_admin_keyword_treatment_review_action') }}" method="post" class="d-inline">
                                        <input type="hidden" name="log_id" value="{{ log.id }}">
                                        <input type="hidden" name="decision" value="approve">
                                        <button type="submit" class="btn btn-sm btn-success fw-bold">
                                            <i class="bi bi-check-lg me-1"></i>Aprovar
                                        </button>
                                    </form>

                                    <!-- Reject -->
                                    <form action="{{ path('app_super_admin_keyword_treatment_review_action') }}" method="post" class="d-inline">
                                        <input type="hidden" name="log_id" value="{{ log.id }}">
                                        <input type="hidden" name="decision" value="reject">
                                        <button type="submit" class="btn btn-sm btn-danger fw-bold">
                                            <i class="bi bi-x-lg me-1"></i>Recusar
                                        </button>
                                    </form>

                                    <!-- Edit Trigger Inline -->
                                    <button class="btn btn-sm btn-bm-secondary" type="button" onclick="showInlineEdit({{ log.id }}, '{{ log.keyword.keywordDisplay }}')">
                                        <i class="bi bi-pencil me-1"></i>Editar Termo
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <!-- Inline Edit Box -->
                        <tr class="d-none border-0" id="edit-box-{{ log.id }}">
                            <td colspan="5" class="bg-dark p-3 border-0">
                                <form action="{{ path('app_super_admin_keyword_treatment_review_action') }}" method="post" class="row g-3 align-items-center">
                                    <input type="hidden" name="log_id" value="{{ log.id }}">
                                    <input type="hidden" name="decision" value="edit">
                                    <div class="col-md-8">
                                        <input type="text" name="new_display" class="form-control text-white" value="{{ log.keyword.keywordDisplay }}" required>
                                    </div>
                                    <div class="col-md-4 d-flex gap-2">
                                        <button type="submit" class="btn btn-sm btn-info fw-bold">Salvar Edição</button>
                                        <button type="button" class="btn btn-sm btn-bm-secondary" onclick="hideInlineEdit({{ log.id }})">Cancelar</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

<script>
function showInlineEdit(id, display) {
    const box = document.getElementById('edit-box-' + id);
    box.classList.remove('d-none');
}

function hideInlineEdit(id) {
    const box = document.getElementById('edit-box-' + id);
    box.classList.add('d-none');
}
</script>
{% endblock %}
