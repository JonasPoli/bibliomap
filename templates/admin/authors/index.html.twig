{% extends 'base.html.twig' %}

{% block title %}Gerenciar Autores — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Autores</span>
{% endblock %}

{% block topbar_actions %}
<div class="d-inline-flex gap-2">
    <div class="dropdown">
        <button class="btn btn-sm btn-bm-secondary px-3 py-2 dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-download me-1"></i> Exportar Tesauro
        </button>
        <ul class="dropdown-menu dropdown-menu-dark">
            <li><a class="dropdown-item" href="{{ path('app_admin_authors_export_thesaurus', {format: 'the'}) }}"><i class="bi bi-file-earmark-text me-2"></i>VantagePoint (.the)</a></li>
            <li><a class="dropdown-item" href="{{ path('app_admin_authors_export_thesaurus', {format: 'csv'}) }}"><i class="bi bi-filetype-csv me-2"></i>CSV (.csv)</a></li>
        </ul>
    </div>
    <button class="btn btn-sm btn-bm-secondary px-3 py-2" data-bs-toggle="modal" data-bs-target="#importThesaurusModal">
        <i class="bi bi-upload me-1"></i> Importar Tesauro
    </button>
    <a href="{{ path('app_admin_authors_export') }}" class="btn btn-sm btn-bm-secondary px-3 py-2" style="text-decoration:none">
        <i class="bi bi-download me-1"></i> Exportar CSV
    </a>
    <button class="btn btn-sm btn-bm-secondary px-3 py-2" data-bs-toggle="modal" data-bs-target="#importModal">
        <i class="bi bi-upload me-1"></i> Importar CSV
    </button>
    <button type="submit" form="mergeForm" id="btn-merge-authors" class="btn btn-sm btn-bm-warning px-3 py-2" disabled title="Selecione de 2 a 5 autores na tabela para mesclar">
        <i class="bi bi-intersect me-1"></i> Mesclar (<span id="merge-count">0</span>)
    </button>
    <a href="{{ path('app_admin_authors_new') }}" class="btn btn-sm btn-bm-primary px-3 py-2" style="text-decoration:none">
        <i class="bi bi-plus-circle me-1"></i> Novo Autor
    </a>
</div>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-people text-accent me-2"></i>Gerenciamento de Autores
    </h1>
    <p class="bm-page-subtitle">Gerencie o cadastro de autores oficiais e suas variações de nome.</p>
</div>

<!-- Search Bar & Filters -->
<div class="bm-card mb-4">
    <form method="GET" action="{{ path('app_admin_authors_index') }}" class="row g-2">
        <div class="col-md-7">
            <input type="text" name="search" class="form-control" placeholder="Buscar por nome, sobrenome ou ORCID..." value="{{ search }}">
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="all" {% if status == 'all' %}selected{% endif %}>Todos os Status</option>
                <option value="active" {% if status == 'active' %}selected{% endif %}>Ativos (Registrados)</option>
                <option value="inactive" {% if status == 'inactive' %}selected{% endif %}>Inativos (Brutos)</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-bm-secondary w-100"><i class="bi bi-search me-1"></i> Filtrar</button>
        </div>
    </form>
</div>

<!-- Authors List -->
<div class="bm-card">
    {% if authors is empty %}
        <div class="text-center py-5 text-muted-bm">
            <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
            Nenhum autor encontrado.
        </div>
    {% else %}
        <form id="mergeForm" action="{{ path('app_admin_authors_merge_preview') }}" method="POST">
        <div class="table-responsive">
            <table class="table align-middle border-bm mb-0" style="color:var(--bm-text);font-size:13.5px">
                <thead>
                    <tr class="bg-bm-card border-bottom border-bm text-muted-bm" style="font-size:12px">
                        <th style="width:36px;text-align:center">
                            <i class="bi bi-intersect text-warning" title="Marque até 5 para mesclar"></i>
                        </th>
                        <th>Nome Preferido</th>
                        <th>Nome Normalizado</th>
                        <th>ORCID</th>
                        <th>Variações</th>
                        <th>Status</th>
                        <th style="width:140px;text-align:right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for auth in authors %}
                        <tr class="border-bm">
                            <td style="text-align:center">
                                <input type="checkbox" name="ids[]" value="{{ auth.id }}" class="form-check-input merge-checkbox" style="cursor:pointer">
                            </td>
                            <td>
                                <div style="font-weight:600">{{ auth.preferredName }}</div>
                            </td>
                            <td class="font-monospace text-muted-bm">{{ auth.normalizedName ?? '—' }}</td>
                            <td>
                                {% if auth.orcid %}
                                    <a href="https://orcid.org/{{ auth.orcid }}" target="_blank" class="text-accent" style="text-decoration:none">
                                        <i class="bi bi-person-workspace me-1"></i>{{ auth.orcid }}
                                    </a>
                                {% else %}
                                    <span class="text-muted-bm">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge rounded-pill" title="Variações registradas" style="background:rgba(128,128,128,0.15); border:1px solid var(--bm-border); color:var(--bm-text)">
                                    {{ auth.variations|length }} variações
                                </span>
                            </td>
                            <td>
                                {% if auth.isStatus() %}
                                    <span class="badge" style="background:rgba(63,185,80,0.15);color:var(--bm-success);font-size:11px">Ativo</span>
                                {% else %}
                                    <span class="badge" style="background:rgba(210,153,34,0.15);color:var(--bm-warning);font-size:11px">Pendente / Bruto</span>
                                {% endif %}
                            </td>
                            <td style="text-align:right">
                                <div class="d-inline-flex gap-2">
                                    <a href="{{ path('app_admin_authors_edit', {id: auth.id}) }}" class="btn btn-sm btn-bm-secondary px-2 py-1" style="font-size:12px" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="{{ path('app_admin_authors_delete', {id: auth.id}) }}" method="POST" onsubmit="return confirm('Deseja realmente excluir este autor?');" style="display:inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_author_' ~ auth.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" style="font-size:12px" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        {% if totalPages > 1 %}
            <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top border-bm gap-2">
                <div style="font-size:13px;color:var(--bm-text-muted)">
                    Exibindo <b>{{ authors|length }}</b> de <b>{{ totalItems|number_format(0, ',', '.') }}</b> autores (Página <b>{{ currentPage }}</b> de <b>{{ totalPages }}</b>)
                </div>
                <nav aria-label="Navegação de autores">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item {% if currentPage <= 1 %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_authors_index', {page: 1, search: search, status: status}) }}" title="Primeira Página">&laquo;&laquo;</a>
                        </li>
                        <li class="page-item {% if currentPage <= 1 %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_authors_index', {page: currentPage - 1, search: search, status: status}) }}">&laquo; Anterior</a>
                        </li>
                        
                        {% set startPage = max(1, currentPage - 2) %}
                        {% set endPage = min(totalPages, currentPage + 2) %}
                        
                        {% for p in startPage..endPage %}
                            <li class="page-item {% if p == currentPage %}active{% endif %}">
                                <a class="page-link" href="{{ path('app_admin_authors_index', {page: p, search: search, status: status}) }}">{{ p }}</a>
                            </li>
                        {% endfor %}

                        <li class="page-item {% if currentPage >= totalPages %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_authors_index', {page: currentPage + 1, search: search, status: status}) }}">Próxima &raquo;</a>
                        </li>
                        <li class="page-item {% if currentPage >= totalPages %}disabled{% endif %}">
                            <a class="page-link" href="{{ path('app_admin_authors_index', {page: totalPages, search: search, status: status}) }}" title="Última Página">&raquo;&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        {% else %}
            <div class="mt-3 pt-3 border-top border-bm" style="font-size:13px;color:var(--bm-text-muted)">
                Total: <b>{{ totalItems|number_format(0, ',', '.') }}</b> autor(es) encontrado(s).
            </div>
        {% endif %}
        </form>
    {% endif %}
</div>

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const checkboxes = document.querySelectorAll('.merge-checkbox');
            const btnMerge = document.getElementById('btn-merge-authors');
            const mergeCount = document.getElementById('merge-count');

            function updateMergeState() {
                const checked = document.querySelectorAll('.merge-checkbox:checked');
                const count = checked.length;
                if (mergeCount) mergeCount.textContent = count;

                if (count >= 2 && count <= 5) {
                    btnMerge.disabled = false;
                    btnMerge.classList.remove('btn-bm-warning');
                    btnMerge.classList.add('btn-warning');
                } else {
                    btnMerge.disabled = true;
                    btnMerge.classList.remove('btn-warning');
                    btnMerge.classList.add('btn-bm-warning');
                }

                checkboxes.forEach(cb => {
                    if (!cb.checked && count >= 5) {
                        cb.disabled = true;
                    } else {
                        cb.disabled = false;
                    }
                });
            }

            checkboxes.forEach(cb => cb.addEventListener('change', updateMergeState));
        });
    </script>
{% endblock %}

<!-- Import CSV Modal -->
<div class="modal fade animate__animated animate__fadeIn" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-bm" style="background:var(--bm-card-bg);color:var(--bm-text)">
            <div class="modal-header border-bm">
                <h5 class="modal-title" id="importModalLabel" style="font-weight:700">Importar Autores via CSV</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('app_admin_authors_import') }}" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_authors') }}">
                    <p style="font-size:13px;color:var(--bm-text-muted)">
                        Selecione o arquivo CSV contendo as colunas <code>name</code>, <code>surname</code>, <code>initials</code>, <code>orcid</code>, <code>status</code> e <code>variations</code> (separadas por ponto e vírgula).
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Arquivo CSV *</label>
                        <input type="file" name="csv_file" class="form-control" accept=".csv" required>
                    </div>
                </div>
                <div class="modal-footer border-bm">
                    <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-bm-primary">Importar Dados</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import Thesaurus Modal -->
<div class="modal fade animate__animated animate__fadeIn" id="importThesaurusModal" tabindex="-1" aria-labelledby="importThesaurusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-bm" style="background:var(--bm-card-bg);color:var(--bm-text)">
            <div class="modal-header border-bm">
                <h5 class="modal-title" id="importThesaurusModalLabel" style="font-weight:700">Importar Tesauro de Autores</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ path('app_admin_authors_import_thesaurus') }}" method="POST" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_authors_thesaurus') }}">
                    <p style="font-size:13px;color:var(--bm-text-muted)">
                        Envie um arquivo no formato <b>VantagePoint (.the)</b> ou <b>CSV (.csv)</b> contendo termos preferidos e suas variações.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Arquivo de Tesauro (.the ou .csv) *</label>
                        <input type="file" name="thesaurus_file" class="form-control" accept=".the,.csv" required>
                    </div>
                </div>
                <div class="modal-footer border-bm">
                    <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-bm-primary">Importar Tesauro</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
