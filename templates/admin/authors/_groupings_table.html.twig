{# Tabela de agrupamentos globais (autores e palavras-chave) com o botão Desfazer.
   Variáveis: list (AuthorityMappingService::list), entity ('author'|'keyword'), undoRoute, listRoute #}
{% if list.items is empty %}
    <div class="text-center py-5 text-muted-bm">
        <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
        Nenhum agrupamento global gravado.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table align-middle border-bm mb-0" style="color:var(--bm-text);font-size:13.5px">
            <thead>
                <tr class="bg-bm-card border-bottom border-bm text-muted-bm" style="font-size:12px">
                    <th>{{ entity == 'author' ? 'Autor agrupado' : 'Palavra-chave agrupada' }}</th>
                    <th>Agrupado em</th>
                    <th style="text-align:right">Documentos</th>
                    <th>Quem e quando</th>
                    <th>Origem</th>
                    <th style="width:120px;text-align:right">Ação</th>
                </tr>
            </thead>
            <tbody>
                {% set originLabels = {admin: 'Administração', project: 'Projeto', treatment: 'Tratamento', variation: 'Sincronização', command: 'Comando', screen_admin: 'Administração', screen_project: 'Projeto', enrichment: 'Sincronização'} %}
                {% for it in list.items %}
                    <tr class="border-bm">
                        <td><div style="font-weight:600">{{ it.source_label }}</div><small class="text-muted-bm">#{{ it.source_id }}</small></td>
                        <td>{{ it.target_label }}{% if it.target_id > 0 %} <small class="text-muted-bm">#{{ it.target_id }}</small>{% endif %}</td>
                        <td style="text-align:right">{{ it.documents|number_format(0, ',', '.') }}</td>
                        <td style="font-size:12.5px">
                            {% if it.user_name %}{{ it.user_name }}{% elseif it.origin in ['treatment', 'variation', 'command', 'enrichment'] %}<span class="text-muted-bm">automático</span>{% else %}<span class="text-muted-bm">não registrado</span>{% endif %}
                            {% if it.created_at %}<br><span class="text-muted-bm">{{ it.created_at|date('d/m/Y H:i') }}</span>{% endif %}
                        </td>
                        <td style="font-size:12.5px">
                            {{ it.origin ? (originLabels[it.origin] ?? it.origin) : '—' }}
                            {% if it.kind == 'concept' %}<br><small class="text-muted-bm">conceito agrupador</small>{% endif %}
                            {% if it.note %}<br><small class="text-muted-bm">{{ it.note }}</small>{% endif %}
                        </td>
                        <td style="text-align:right">
                            <form action="{{ path(undoRoute, {sourceId: it.source_id, page: list.page}) }}" method="POST" style="display:inline"
                                  onsubmit="return confirm('Desfazer este agrupamento? {{ entity == 'author' ? 'O autor' : 'A palavra-chave' }} volta a contar por conta própria nas análises.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('undo_grouping_' ~ entity ~ '_' ~ it.source_id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-warning px-2 py-1" style="font-size:12px" title="Desfazer o agrupamento">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Desfazer
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if list.pages > 1 %}
        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top border-bm gap-2">
            <div style="font-size:13px;color:var(--bm-text-muted)">
                Exibindo <b>{{ list.items|length }}</b> de <b>{{ list.total|number_format(0, ',', '.') }}</b> agrupamentos (Página <b>{{ list.page }}</b> de <b>{{ list.pages }}</b>)
            </div>
            <nav aria-label="Navegação de agrupamentos">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item {% if list.page <= 1 %}disabled{% endif %}"><a class="page-link" href="{{ path(listRoute, {page: list.page - 1}) }}">&laquo; Anterior</a></li>
                    <li class="page-item {% if list.page >= list.pages %}disabled{% endif %}"><a class="page-link" href="{{ path(listRoute, {page: list.page + 1}) }}">Próxima &raquo;</a></li>
                </ul>
            </nav>
        </div>
    {% else %}
        <div class="mt-3 pt-3 border-top border-bm" style="font-size:13px;color:var(--bm-text-muted)">
            Total: <b>{{ list.total|number_format(0, ',', '.') }}</b> agrupamento(s).
        </div>
    {% endif %}
{% endif %}
