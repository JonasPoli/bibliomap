{% extends 'base.html.twig' %}

{% block title %}Agrupamentos de Autores — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_authors_index') }}" style="text-decoration:none">Autores</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Agrupamentos</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-diagram-2 text-accent me-2"></i>Agrupamentos de Autores {{ help('admin.authors.groupings') }}
    </h1>
    <p class="bm-page-subtitle">Mesclagens globais gravadas sem apagar nada: os autores agrupados continuam cadastrados e contam como o destino nas análises. Desfazer devolve cada uma ao que era.</p>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_authors_index') }}">Cadastro</a></li>
    <li class="nav-item"><a class="nav-link active" href="#">Agrupamentos ({{ list.total|number_format(0, ',', '.') }})</a></li>
</ul>

<div class="bm-card">
    {% include 'admin/authors/_groupings_table.html.twig' %}
</div>
{% endblock %}
