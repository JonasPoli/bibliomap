{% extends 'base.html.twig' %}

{% block title %}Mesclar Autores — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_authors_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Autores</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Mesclar Registros</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-intersect text-warning me-2"></i>Mesclar e Consolidar Autores {{ help('admin.authors.merge.page') }}
    </h1>
    <p class="bm-page-subtitle">Compare os registros, escolha o principal (Master) e qual nome deve prevalecer.</p>
</div>

<form action="{{ path('app_admin_authors_merge_execute') }}" method="POST">
    <input type="hidden" name="_token" value="{{ csrf_token('merge_authors') }}">
    {% for auth in authors %}
        <input type="hidden" name="source_ids[]" value="{{ auth.id }}">
    {% endfor %}

    <div class="bm-card mb-4 border-warning">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-1" style="font-weight:700;color:var(--bm-text)">
                    <i class="bi bi-star-fill text-warning me-2"></i>1. Selecione o Registro Principal (Master) {{ help('admin.authors.merge.master') }}
                </h5>
                <p class="text-muted-bm mb-0" style="font-size:13px">O autor selecionado como Master será preservado. Os demais serão mesclados e todas as grafias anteriores se tornarão variações.</p>
            </div>
            <a href="{{ path('app_admin_authors_index') }}" class="btn btn-sm btn-bm-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cancelar
            </a>
        </div>

        <div class="row g-3 mt-2">
            {% for auth in authors %}
                <div class="col">
                    <div class="card bg-bm-card border-bm p-3 h-100 position-relative" style="border-radius:10px">
                        <div class="form-check">
                            <input class="form-check-input me-2" type="radio" name="master_id" value="{{ auth.id }}" id="master_{{ auth.id }}" {% if loop.first %}checked{% endif %} required>
                            <label class="form-check-label fw-bold" for="master_{{ auth.id }}" style="font-size:14px;color:var(--bm-text)">
                                Registro #{{ auth.id }}
                            </label>
                        </div>
                        <div class="mt-2" style="font-size:13px;color:var(--bm-text)">
                            <div class="fw-bold">{{ auth.preferredName }}</div>
                            <small class="text-muted-bm">{{ auth.orcid ? ('ORCID: ' ~ auth.orcid) : 'Sem ORCID' }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="bm-card mb-4">
        <h5 class="mb-3" style="font-weight:700">
            <i class="bi bi-layout-split text-accent me-2"></i>2. Escolha os Valores a Serem Mantidos {{ help('admin.authors.merge.fields') }}
        </h5>
        
        <div class="table-responsive">
            <table class="table align-middle border-bm mb-0" style="color:var(--bm-text);font-size:13.5px">
                <thead>
                    <tr class="bg-bm-card border-bottom border-bm text-muted-bm" style="font-size:12px">
                        <th style="width:220px">Campo / Propriedade</th>
                        {% for auth in authors %}
                            <th>
                                <span class="badge bg-secondary me-1">#{{ auth.id }}</span>
                                {{ auth.preferredName|length > 25 ? auth.preferredName|slice(0, 25) ~ '...' : auth.preferredName }}
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {# Preferred Name #}
                    <tr>
                        <td class="fw-bold bg-bm-card">Nome Preferido (Oficial)</td>
                        {% for auth in authors %}
                            <td>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="fields[preferredName]" value="{{ auth.preferredName }}" id="pn_{{ auth.id }}" {% if loop.first %}checked{% endif %}>
                                    <label class="form-check-label fw-bold" for="pn_{{ auth.id }}">{{ auth.preferredName }}</label>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>

                    {# ORCID: todos os identificadores são consolidados no Master (não há escolha) #}
                    <tr>
                        <td class="fw-bold bg-bm-card">ORCID {{ help('admin.authors.merge.orcid') }}</td>
                        {% for auth in authors %}
                            <td>
                                <span class="font-monospace text-accent">{{ auth.orcid ?? '—' }}</span>
                            </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Variations Consolidation Preview -->
    <div class="bm-card mb-4 border-info">
        <h5 class="mb-2" style="font-weight:700;color:var(--bm-text)">
            <i class="bi bi-tags-fill text-info me-2"></i>3. Consolidação de Variações de Nome do Autor {{ help('admin.authors.merge.variations') }}
        </h5>
        <p class="text-muted-bm mb-3" style="font-size:13px">
            Todas as grafias abaixo passarão a apontar para o registro Master.
        </p>

        <div class="d-flex flex-wrap gap-2 p-3 bg-bm-card border-bm rounded-3" style="max-height:160px;overflow-y:auto">
            {% for var in allVariations %}
                <span class="badge bg-dark-subtle text-body border px-2 py-1" style="font-size:12px">
                    <i class="bi bi-person me-1"></i>{{ var }}
                </span>
            {% endfor %}
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end gap-3 mb-5">
        <a href="{{ path('app_admin_authors_index') }}" class="btn btn-bm-secondary px-4 py-2">
            Cancelar
        </a>
        <button type="submit" class="btn btn-bm-primary px-4 py-2" onclick="return confirm('Confirmar a mesclagem? O autor Master será atualizado e os outros serão removidos.');">
            <i class="bi bi-intersect me-1"></i> Confirmar Mesclagem de Autores
        </button>
        <span class="d-inline-flex align-items-center">{{ help('admin.authors.merge.confirm') }}</span>
    </div>
</form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Ao trocar o registro Master, pré-seleciona os valores da coluna dele (ainda é possível ajustar linha a linha).
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('input[name="master_id"]').forEach(master => {
                master.addEventListener('change', () => {
                    if (!master.checked) return;
                    document.querySelectorAll('input[type="radio"][name^="fields["]').forEach(field => {
                        if (field.id.slice(field.id.lastIndexOf('_') + 1) === master.value) field.checked = true;
                    });
                });
            });
        });
    </script>
{% endblock %}
