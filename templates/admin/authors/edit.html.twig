{% extends 'base.html.twig' %}

{% block title %}Editar Autor — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_authors_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Autores</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Editar Autor</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-pencil text-accent me-2"></i>Editar Autor: {{ author.name }} {{ help('admin.authors.form_page') }}
    </h1>
    <p class="bm-page-subtitle">Modifique as informações gerais, ORCID e variações de escrita deste autor.</p>
</div>

<div class="row g-4">
    <!-- Left Column: Form -->
    <div class="col-lg-8">
        <div class="bm-card">
            <form method="POST" action="{{ path('app_admin_authors_edit', {id: author.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_author_' ~ author.id) }}">

                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label">Nome Completo / Preferido * {{ help('admin.authors.form.name') }}</label>
                        <input type="text" name="name" class="form-control" placeholder="Ex: Jonas Poli" value="{{ author.name }}" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">ORCID {{ help('admin.authors.form.orcid') }}</label>
                        <input type="text" name="orcid" class="form-control" placeholder="Ex: 0000-0002-1825-0097" value="{{ orcid }}">
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" name="status" id="status" value="1" {% if author.isStatus() %}checked{% endif %}>
                            <label class="form-check-label" for="status">Autor Ativo (Registrado)</label> {{ help('admin.authors.form.status') }}
                        </div>
                    </div>
                </div>

                <!-- Variations Textarea -->
                <div class="mb-4">
                    <h5 class="mb-2" style="font-weight:700">Variações de Nome {{ help('admin.authors.form.variations') }}</h5>
                    <p style="font-size:12px;color:var(--bm-text-muted)">Uma grafia por linha. Apagar uma linha remove a variação ao salvar.</p>
                    <textarea name="variationsText" class="form-control font-monospace" rows="6" placeholder="Poli J.&#10;Poli, Jonas&#10;Jonas Poli">{{ variationsText }}</textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_admin_authors_index') }}" class="btn-bm-secondary btn" style="text-decoration:none">Cancelar</a>
                    <button type="submit" class="btn-bm-primary">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Variations List & Merge -->
    <div class="col-lg-4">
        <!-- Registered Variations -->
        <div class="bm-card mb-4">
            <h5 style="font-weight:700" class="mb-3">Variações Cadastradas {{ help('admin.authors.edit.variations_list') }}</h5>
            {% set hasAlternatives = false %}
            <div class="list-group list-group-flush border-bm rounded">
                {% for v in author.variations %}
                    {% if v.source in ['alternative', 'import', 'merge'] %}
                        {% set hasAlternatives = true %}
                        <div class="list-group-item bg-bm-card border-bm d-flex justify-content-between align-items-center py-2" style="font-size:13px;color:var(--bm-text)">
                            <span class="font-monospace text-accent">{{ v.originalName }}</span>
                            <form action="{{ path('app_admin_authors_variation_separate', {id: v.id}) }}" method="POST" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('separate_var_' ~ v.id) }}">
                                <button type="submit" class="btn btn-xs btn-outline-warning px-2 py-0" style="font-size:11px" onclick="return confirm('Deseja transformar esta variação em um novo autor independente?');">
                                    Desmembrar
                                </button>
                            </form>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% if not hasAlternatives %}
                <div class="text-center py-3 text-muted-bm" style="font-size:12.5px">Nenhuma variação alternativa cadastrada.</div>
            {% endif %}
        </div>

        <!-- Merge Card -->
        <div class="bm-card">
            <h5 style="font-weight:700" class="mb-2 text-danger">Mesclar Autor {{ help('admin.authors.edit.merge') }}</h5>
            <p style="font-size:12px;color:var(--bm-text-muted)" class="mb-3">
                Move documentos, variações e ORCID deste autor para o destino e exclui este registro. Não pode ser desfeito.
            </p>
            <form action="{{ path('app_admin_authors_merge', {id: author.id}) }}" method="POST" onsubmit="return confirm('Deseja realmente mesclar e excluir este autor? A ação não poderá ser desfeita.');">
                <input type="hidden" name="_token" value="{{ csrf_token('merge_author_' ~ author.id) }}">
                <div class="mb-3">
                    <label class="form-label" style="font-size:12px" for="authorMergeSearch">Autor de Destino</label>
                    <input type="search" id="authorMergeSearch" class="form-control mb-2" style="font-size:12.5px" placeholder="Buscar por nome, grafia normalizada ou ID" autocomplete="off">
                    <select name="targetId" id="authorMergeTarget" class="form-select" style="font-size:12.5px" size="6" required>
                        <option value="" disabled>Digite ao menos 2 letras (ou o ID) para buscar...</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-danger w-100"><i class="bi bi-shuffle me-1"></i> Mesclar e Excluir</button>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    const input = document.getElementById('authorMergeSearch');
    const select = document.getElementById('authorMergeTarget');
    let timer = null;
    input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(async function () {
            const q = input.value.trim();
            select.innerHTML = '';
            if (q.length < 2 && !/^\d+$/.test(q)) {
                select.add(new Option('Digite ao menos 2 letras (ou o ID) para buscar...', '', false, false));
                select.options[0].disabled = true;
                return;
            }
            const res = await fetch({{ path('app_admin_authors_search', {exclude: author.id})|json_encode|raw }} + '&q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } });
            const items = res.ok ? await res.json() : [];
            if (!items.length) {
                select.add(new Option('Nenhum resultado para "' + q + '"', '', false, false));
                select.options[0].disabled = true;
                return;
            }
            items.forEach(function (it) { select.add(new Option(it.label, it.id)); });
        }, 250);
    });
})();
</script>
{% endblock %}
