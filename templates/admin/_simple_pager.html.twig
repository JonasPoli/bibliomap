{# Paginação simples (anterior/próxima). Variáveis: page, pages, total, per_page, route, route_params. #}
{% if pages > 1 %}
    <nav class="d-flex justify-content-between align-items-center mt-3" style="font-size:13px" aria-label="Paginação">
        <span class="text-muted-bm">Página <b>{{ page }}</b> de <b>{{ pages }}</b> ({{ total|number_format(0, ',', '.') }} no total, {{ per_page }} por página)</span>
        <span>
            {% if page > 1 %}<a class="btn btn-sm btn-bm-secondary" href="{{ path(route, route_params|merge({page: page - 1})) }}"><i class="bi bi-chevron-left"></i> Anterior</a>{% endif %}
            {% if page < pages %}<a class="btn btn-sm btn-bm-secondary" href="{{ path(route, route_params|merge({page: page + 1})) }}">Próxima <i class="bi bi-chevron-right"></i></a>{% endif %}
        </span>
    </nav>
{% endif %}
