{% extends 'base.html.twig' %}

{% block title %}Projetos de {{ owner.name }} — Admin{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_admin_users') }}" class="bm-breadcrumb-link">Usuários</a>
    <span class="bm-breadcrumb-sep">/</span>
    <span class="current">Projetos de {{ owner.name|split(' ')|slice(0,2)|join(' ') }}</span>
{% endblock %}

{% block body %}
<div style="padding:0 0 40px">

    {# ── Header ── #}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px">
        <div style="display:flex;align-items:center;gap:14px">
            <a href="{{ path('app_admin_users') }}"
               style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:10px;background:var(--bm-card-bg);border:1px solid var(--bm-border);color:var(--bm-text-muted);text-decoration:none;transition:all .2s"
               onmouseover="this.style.borderColor='var(--bm-accent)';this.style.color='var(--bm-accent)'"
               onmouseout="this.style.borderColor='var(--bm-border)';this.style.color='var(--bm-text-muted)'">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <div style="display:flex;align-items:center;gap:10px">
                    <div style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#4f8ef7,#a855f7);display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:white">
                        {{ owner.name|first|upper }}
                    </div>
                    <div>
                        <h1 style="font-size:20px;font-weight:700;color:var(--bm-text);margin:0">{{ owner.name }}</h1>
                        <div style="font-size:12px;color:var(--bm-text-muted)">{{ owner.email }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            <span style="font-size:13px;color:var(--bm-text-muted);background:var(--bm-card-bg);border:1px solid var(--bm-border);padding:5px 14px;border-radius:20px">
                <i class="bi bi-folder2" style="margin-right:5px"></i>
                {{ projects|length }} projeto{% if projects|length != 1 %}s{% endif %}
            </span>
        </div>
    </div>

    {# ── Flash messages ── #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible mb-4"
                 style="border-radius:10px;font-size:13.5px">
                <i class="bi bi-{{ type == 'success' ? 'check-circle' : 'exclamation-triangle' }} me-2"></i>
                {{ message|raw }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# ── Empty state ── #}
    {% if projects is empty %}
        <div style="text-align:center;padding:80px 20px;background:var(--bm-card-bg);border:1px solid var(--bm-border);border-radius:16px">
            <div style="font-size:48px;margin-bottom:16px">📂</div>
            <h3 style="font-size:18px;font-weight:600;color:var(--bm-text);margin:0 0 8px">Nenhum projeto</h3>
            <p style="color:var(--bm-text-muted);font-size:14px;margin:0">Este usuário ainda não criou projetos.</p>
        </div>
    {% else %}

    {# ── Projects grid ── #}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px">
        {% for project in projects %}
        <div class="project-card" style="background:var(--bm-card-bg);border:1px solid var(--bm-border);border-radius:16px;padding:0;overflow:hidden;transition:border-color .2s,box-shadow .2s"
             onmouseover="this.style.borderColor='rgba(79,142,247,.35)';this.style.boxShadow='0 4px 24px rgba(0,0,0,.2)'"
             onmouseout="this.style.borderColor='var(--bm-border)';this.style.boxShadow='none'">

            {# Status bar #}
            <div style="height:3px;background:{% if project.status == 'done' %}linear-gradient(90deg,#3fb950,#2ea043){% elseif project.status == 'error' %}#f85149{% elseif project.status in ['importing','normalizing','processing'] %}linear-gradient(90deg,#d29922,#e3b341){% elseif project.status == 'ready' %}linear-gradient(90deg,#4f8ef7,#a855f7){% else %}#30363d{% endif %}"></div>

            <div style="padding:20px 22px">
                {# Header row #}
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px">
                    <div style="flex:1;min-width:0">
                        <h3 style="font-size:15px;font-weight:700;color:var(--bm-text);margin:0 0 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"
                            title="{{ project.title }}">
                            {{ project.title }}
                        </h3>
                        <div style="font-size:11.5px;color:var(--bm-text-muted);font-family:monospace">
                            /{{ project.slug }}
                        </div>
                    </div>
                    <span class="badge bg-{{ project.statusColor }}"
                          style="font-size:10.5px;padding:4px 10px;border-radius:20px;white-space:nowrap;flex-shrink:0">
                        {{ project.statusLabel }}
                    </span>
                </div>

                {# Description #}
                {% if project.description %}
                    <p style="font-size:13px;color:var(--bm-text-muted);margin:0 0 14px;line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                        {{ project.description }}
                    </p>
                {% endif %}

                {# Stats row #}
                <div style="display:flex;gap:16px;margin-bottom:16px">
                    <div style="font-size:12px;color:var(--bm-text-muted)">
                        <i class="bi bi-database" style="margin-right:4px"></i>
                        {{ project.datasets|length }} dataset{% if project.datasets|length != 1 %}s{% endif %}
                    </div>
                    {% if project.startYear %}
                    <div style="font-size:12px;color:var(--bm-text-muted)">
                        <i class="bi bi-calendar3" style="margin-right:4px"></i>
                        {{ project.startYear }}{% if project.endYear %} – {{ project.endYear }}{% endif %}
                    </div>
                    {% endif %}
                    <div style="font-size:12px;color:var(--bm-text-muted);margin-left:auto">
                        <i class="bi bi-clock" style="margin-right:3px"></i>
                        {{ project.updatedAt|date('d/m/Y') }}
                    </div>
                </div>

                {# Actions #}
                <div style="display:flex;gap:8px">
                    <button type="button"
                            class="btn-copy-trigger"
                            data-project-id="{{ project.id }}"
                            data-project-title="{{ project.title|e('html_attr') }}"
                            data-csrf="{{ csrf_token('copy_project_' ~ project.id) }}"
                            style="flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:8px 14px;border-radius:9px;background:rgba(79,142,247,.08);border:1px solid rgba(79,142,247,.25);color:var(--bm-accent);font-size:13px;font-weight:600;cursor:pointer;transition:all .2s"
                            onmouseover="this.style.background='rgba(79,142,247,.15)';this.style.borderColor='rgba(79,142,247,.5)'"
                            onmouseout="this.style.background='rgba(79,142,247,.08)';this.style.borderColor='rgba(79,142,247,.25)'">
                        <i class="bi bi-copy"></i>
                        Copiar projeto
                    </button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>

{# ════════════════════════════════════════════════════════════
   Copy Modal
════════════════════════════════════════════════════════════ #}
<div id="copyModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.65);backdrop-filter:blur(4px);align-items:center;justify-content:center;padding:20px">
    <div style="background:#0d1520;border:1px solid #1e2d45;border-radius:20px;width:100%;max-width:480px;overflow:hidden;animation:modalIn .25s ease">

        {# Modal header #}
        <div style="padding:24px 28px 20px;border-bottom:1px solid #1e2d45;display:flex;align-items:center;justify-content:space-between">
            <div>
                <h2 style="font-size:17px;font-weight:700;color:#e2e8f0;margin:0 0 4px">
                    <i class="bi bi-copy" style="color:#4f8ef7;margin-right:8px"></i>Copiar Projeto
                </h2>
                <p id="modalProjectTitle" style="font-size:13px;color:#64748b;margin:0"></p>
            </div>
            <button onclick="closeModal()" style="background:none;border:none;color:#475569;cursor:pointer;font-size:20px;padding:4px;border-radius:8px;line-height:1;transition:color .2s"
                    onmouseover="this.style.color='#e2e8f0'" onmouseout="this.style.color='#475569'">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        {# Modal body #}
        <form id="copyForm" method="POST" action="">
            <div style="padding:24px 28px">

                <input type="hidden" name="_token" id="csrfToken">

                {# User search #}
                <div style="margin-bottom:20px">
                    <label style="display:block;font-size:13px;font-weight:600;color:#94a3b8;margin-bottom:8px">
                        Copiar para o usuário:
                    </label>

                    {# Live search input #}
                    <div style="position:relative;margin-bottom:8px">
                        <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#475569;font-size:14px;pointer-events:none"></i>
                        <input type="text" id="userSearch"
                               placeholder="Buscar por nome ou e-mail..."
                               autocomplete="off"
                               style="width:100%;padding:10px 12px 10px 36px;background:#060b14;border:1px solid #1e2d45;border-radius:10px;color:#e2e8f0;font-size:13.5px;outline:none;transition:border-color .2s"
                               onfocus="this.style.borderColor='#4f8ef7'"
                               onblur="this.style.borderColor='#1e2d45'">
                    </div>

                    {# Scrollable user list #}
                    <div id="userList"
                         style="max-height:240px;overflow-y:auto;border:1px solid #1e2d45;border-radius:10px;background:#060b14">
                        {% if users is empty %}
                            <div style="padding:20px;text-align:center;color:#475569;font-size:13px">
                                Nenhum outro usuário ativo disponível.
                            </div>
                        {% else %}
                            {% for user in users %}
                            <label class="user-option"
                                   style="display:flex;align-items:center;gap:12px;padding:12px 14px;cursor:pointer;border-bottom:1px solid #0d1520;transition:background .15s"
                                   onmouseover="this.style.background='rgba(79,142,247,.07)'"
                                   onmouseout="this.style.background='transparent'">
                                <input type="radio" name="target_user_id" value="{{ user.id }}"
                                       style="accent-color:#4f8ef7;width:16px;height:16px;flex-shrink:0">
                                <div style="width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#4f8ef7,#a855f7);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:white;flex-shrink:0">
                                    {{ user.name|first|upper }}
                                </div>
                                <div style="flex:1;min-width:0">
                                    <div class="user-name" style="font-size:13.5px;font-weight:600;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                        {{ user.name }}
                                    </div>
                                    <div class="user-email" style="font-size:11.5px;color:#475569;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                        {{ user.email }}
                                    </div>
                                </div>
                            </label>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>

                {# Warning notice #}
                <div style="background:rgba(210,153,34,.07);border:1px solid rgba(210,153,34,.2);border-radius:10px;padding:12px 14px;display:flex;gap:10px;margin-bottom:20px">
                    <i class="bi bi-info-circle" style="color:#d29922;flex-shrink:0;margin-top:1px"></i>
                    <p style="font-size:12.5px;color:#8b949e;margin:0;line-height:1.6">
                        O projeto será copiado <strong style="color:#94a3b8">integralmente</strong> — incluindo datasets, documentos, autores e palavras-chave —
                        com status <strong style="color:#94a3b8">privado</strong> para o usuário selecionado. Os arquivos originais são copiados fisicamente no servidor.
                    </p>
                </div>
            </div>

            {# Modal footer #}
            <div style="padding:0 28px 24px;display:flex;gap:10px;justify-content:flex-end">
                <button type="button" onclick="closeModal()"
                        style="padding:9px 20px;border-radius:10px;border:1px solid #1e2d45;background:transparent;color:#64748b;font-size:13.5px;font-weight:500;cursor:pointer;transition:all .2s"
                        onmouseover="this.style.borderColor='#2d3f5a';this.style.color='#94a3b8'"
                        onmouseout="this.style.borderColor='#1e2d45';this.style.color='#64748b'">
                    Cancelar
                </button>
                <button type="submit" id="copySubmit"
                        style="padding:9px 22px;border-radius:10px;border:none;background:linear-gradient(135deg,#4f8ef7,#a855f7);color:white;font-size:13.5px;font-weight:700;cursor:pointer;transition:opacity .2s;display:flex;align-items:center;gap:7px">
                    <i class="bi bi-copy"></i>
                    Copiar agora
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    @keyframes modalIn {
        from { opacity:0; transform:scale(.96) translateY(8px) }
        to   { opacity:1; transform:none }
    }
    /* Custom scrollbar for user list */
    #userList::-webkit-scrollbar { width: 6px; }
    #userList::-webkit-scrollbar-track { background: transparent; }
    #userList::-webkit-scrollbar-thumb { background: #1e2d45; border-radius: 3px; }
</style>

<script>
const modal    = document.getElementById('copyModal');
const copyForm = document.getElementById('copyForm');
const searchEl = document.getElementById('userSearch');

// ── Open modal ────────────────────────────────────────────────────────────────
document.querySelectorAll('.btn-copy-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
        const projectId    = btn.dataset.projectId;
        const projectTitle = btn.dataset.projectTitle;
        const csrf         = btn.dataset.csrf;

        document.getElementById('modalProjectTitle').textContent = '"' + projectTitle + '"';
        document.getElementById('csrfToken').value = csrf;
        copyForm.action = '/admin/projetos/' + projectId + '/copiar';

        // Reset search + selection
        searchEl.value = '';
        filterUsers('');
        document.querySelectorAll('input[name="target_user_id"]').forEach(r => r.checked = false);

        modal.style.display = 'flex';
        setTimeout(() => searchEl.focus(), 50);
    });
});

// ── Close modal ───────────────────────────────────────────────────────────────
function closeModal() {
    modal.style.display = 'none';
}
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// ── Live search ───────────────────────────────────────────────────────────────
searchEl.addEventListener('input', () => filterUsers(searchEl.value.toLowerCase().trim()));

function filterUsers(query) {
    document.querySelectorAll('.user-option').forEach(opt => {
        const name  = opt.querySelector('.user-name').textContent.toLowerCase();
        const email = opt.querySelector('.user-email').textContent.toLowerCase();
        opt.style.display = (!query || name.includes(query) || email.includes(query)) ? '' : 'none';
    });
}

// ── Submit guard (must select a user) ────────────────────────────────────────
copyForm.addEventListener('submit', e => {
    if (!copyForm.querySelector('input[name="target_user_id"]:checked')) {
        e.preventDefault();
        searchEl.style.borderColor = '#f87171';
        searchEl.placeholder = '⚠ Selecione um usuário antes de continuar';
        setTimeout(() => {
            searchEl.style.borderColor = '#1e2d45';
            searchEl.placeholder = 'Buscar por nome ou e-mail...';
        }, 2500);
    }
});
</script>
{% endblock %}
