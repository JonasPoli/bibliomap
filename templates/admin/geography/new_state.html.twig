{% extends 'base.html.twig' %}

{% block title %}Novo Estado — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_geography_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Geografia</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Novo Estado</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-plus-circle text-accent me-2"></i>Cadastrar Estado / Província {{ help('admin.geography.state.form_page') }}
    </h1>
    <p class="bm-page-subtitle">Adicione um novo estado vinculado a um país e região.</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="bm-card">
            <form method="POST" action="{{ path('app_admin_geography_state_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('new_state') }}">

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Nome do Estado * {{ help('admin.geography.state.name') }}</label>
                        <input type="text" name="officialName" class="form-control" placeholder="Ex: São Paulo" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Sigla / UF * {{ help('admin.geography.state.sigla') }}</label>
                        <input type="text" name="sigla" class="form-control" placeholder="Ex: SP" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">País * {{ help('admin.geography.state.country') }}</label>
                        <select name="countryId" class="form-select" required>
                            <option value="">Selecione...</option>
                            {% for c in countries %}
                                <option value="{{ c.id }}">{{ c.commonName }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Região (se aplicável) {{ help('admin.geography.state.region') }}</label>
                        <select name="regionId" class="form-select">
                            <option value="">Selecione...</option>
                            {% for r in regions %}
                                <option value="{{ r.id }}">{{ r.name }} ({{ r.country.commonName }})</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Código Oficial (ex: IBGE) {{ help('admin.geography.state.code') }}</label>
                        <input type="text" name="officialCode" class="form-control" placeholder="Ex: 35">
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input type="hidden" name="status" value="0">
                            <input class="form-check-input" type="checkbox" name="status" id="status" value="1" checked>
                            <label class="form-check-label" for="status">Estado Ativo</label> {{ help('admin.geography.status') }}
                        </div>
                    </div>
                </div>

                <!-- Variations Input -->
                <div class="mb-4">
                    <h5 class="mb-2" style="font-weight:700">Variações de Escrita {{ help('admin.geography.state.variations') }}</h5>
                    <p style="font-size:12px;color:var(--bm-text-muted)">Uma grafia por linha.</p>
                    <textarea name="variationsText" class="form-control font-monospace" rows="6" placeholder="SP&#10;Sao Paulo&#10;Estado de São Paulo"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_admin_geography_index') }}" class="btn-bm-secondary btn" style="text-decoration:none">Cancelar</a>
                    <button type="submit" class="btn-bm-primary">Salvar Estado</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
