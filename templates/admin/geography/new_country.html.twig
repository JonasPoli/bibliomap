{% extends 'base.html.twig' %}

{% block title %}Novo País — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_geography_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Geografia</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Novo País</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-plus-circle text-accent me-2"></i>Cadastrar País
    </h1>
    <p class="bm-page-subtitle">Adicione um novo país e suas variações linguísticas de escrita.</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="bm-card">
            <form method="POST" action="{{ path('app_admin_geography_country_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('new_country') }}">

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Nome Oficial Completo *</label>
                        <input type="text" name="officialName" class="form-control" placeholder="Ex: Republic of Brazil" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nome Comum *</label>
                        <input type="text" name="commonName" class="form-control" placeholder="Ex: Brasil" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Sigla</label>
                        <input type="text" name="sigla" class="form-control" placeholder="Ex: BR">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Código ISO</label>
                        <input type="text" name="isoCode" class="form-control" placeholder="Ex: BRA">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Continente</label>
                        <input type="text" name="continente" class="form-control" placeholder="Ex: América do Sul">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nacionalidade</label>
                        <input type="text" name="nationality" class="form-control" placeholder="Ex: Brasileiro">
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" name="status" id="status" value="1" checked>
                            <label class="form-check-label" for="status">País Ativo</label>
                        </div>
                    </div>
                </div>

                <!-- Variations Input -->
                <div class="mb-4">
                    <h5 class="mb-2" style="font-weight:700">Variações de Escrita</h5>
                    <p style="font-size:12px;color:var(--bm-text-muted)">
                        Adicione variações de escrita do país (uma por linha). O sistema usará esta lista para vincular os artigos automaticamente.
                    </p>
                    <textarea name="variationsText" class="form-control font-monospace" rows="6" placeholder="Brasil&#10;Brazil&#10;BR&#10;República Federativa do Brasil"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_admin_geography_index') }}" class="btn-bm-secondary btn" style="text-decoration:none">Cancelar</a>
                    <button type="submit" class="btn-bm-primary">Salvar País</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
