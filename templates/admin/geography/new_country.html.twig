{% extends 'base.html.twig' %}

{% block title %}Novo País — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_geography_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Geografia</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Novo País</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-plus-circle text-accent me-2"></i>Cadastrar País {{ help('admin.geography.country.form_page') }}
    </h1>
    <p class="bm-page-subtitle">Adicione um novo país e suas variações linguísticas de escrita.</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="bm-card">
            <form method="POST" action="{{ path('app_admin_geography_country_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('new_country') }}">

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Nome Oficial Completo * {{ help('admin.geography.country.official_name') }}</label>
                        <input type="text" name="officialName" class="form-control" placeholder="Ex: Republic of Brazil" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nome Comum * {{ help('admin.geography.country.common_name') }}</label>
                        <input type="text" name="commonName" class="form-control" placeholder="Ex: Brasil" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Sigla {{ help('admin.geography.country.sigla') }}</label>
                        <input type="text" name="sigla" class="form-control" placeholder="Ex: BR">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Código ISO {{ help('admin.geography.country.iso_code') }}</label>
                        <input type="text" name="isoCode" class="form-control" placeholder="Ex: BRA">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Continente {{ help('admin.geography.country.continent') }}</label>
                        <input type="text" name="continente" class="form-control" placeholder="Ex: América do Sul">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nacionalidade {{ help('admin.geography.country.nationality') }}</label>
                        <input type="text" name="nationality" class="form-control" placeholder="Ex: Brasileiro">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ano de Fundação <span class="text-muted">(opcional)</span> {{ help('admin.geography.country.period') }}</label>
                        <input type="number" name="foundationYear" class="form-control" placeholder="Ex: 1918">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ano de Extinção / Fim <span class="text-muted">(opcional)</span> {{ help('admin.geography.country.period') }}</label>
                        <input type="number" name="extinctionYear" class="form-control" placeholder="Ex: 1992">
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input type="hidden" name="status" value="0">
                            <input class="form-check-input" type="checkbox" name="status" id="status" value="1" checked>
                            <label class="form-check-label" for="status">País Ativo</label> {{ help('admin.geography.status') }}
                        </div>
                    </div>
                </div>

                <!-- Variations Input -->
                <div class="mb-4">
                    <h5 class="mb-2" style="font-weight:700">Variações de Escrita {{ help('admin.geography.country.variations') }}</h5>
                    <p style="font-size:12px;color:var(--bm-text-muted)">Uma grafia por linha.</p>
                    <textarea name="variationsText" class="form-control font-monospace" rows="6" placeholder="Brasil&#10;Brazil&#10;BR&#10;República Federativa do Brasil"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_admin_geography_index') }}" class="btn-bm-secondary btn" style="text-decoration:none">Cancelar</a>
                    <button type="submit" class="btn-bm-primary">Salvar País</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
