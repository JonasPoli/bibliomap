{% extends 'base.html.twig' %}

{% block title %}Editar País — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_geography_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Geografia</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Editar País</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-pencil text-accent me-2"></i>Editar País: {{ country.commonName }}
    </h1>
    <p class="bm-page-subtitle">Modifique as informações gerais e variações para este país.</p>
</div>

<div class="row g-4">
    <!-- Left Column: Form -->
    <div class="col-lg-8">
        <div class="bm-card">
            <form method="POST" action="{{ path('app_admin_geography_country_edit', {id: country.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_country_' ~ country.id) }}">

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Nome Oficial Completo *</label>
                        <input type="text" name="officialName" class="form-control" placeholder="Ex: Republic of Brazil" value="{{ country.officialName }}" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nome Comum *</label>
                        <input type="text" name="commonName" class="form-control" placeholder="Ex: Brasil" value="{{ country.commonName }}" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Sigla</label>
                        <input type="text" name="sigla" class="form-control" placeholder="Ex: BR" value="{{ country.sigla }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Código ISO</label>
                        <input type="text" name="isoCode" class="form-control" placeholder="Ex: BRA" value="{{ country.isoCode }}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Continente</label>
                        <input type="text" name="continente" class="form-control" placeholder="Ex: América do Sul" value="{{ country.continente }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nacionalidade</label>
                        <input type="text" name="nationality" class="form-control" placeholder="Ex: Brasileiro" value="{{ country.nationality }}">
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" name="status" id="status" value="1" {% if country.isStatus() %}checked{% endif %}>
                            <label class="form-check-label" for="status">País Ativo</label>
                        </div>
                    </div>
                </div>

                <!-- Variations Input -->
                <div class="mb-4">
                    <h5 class="mb-2" style="font-weight:700">Edição em Massa das Variações</h5>
                    <p style="font-size:12px;color:var(--bm-text-muted)">
                        Adicione variações de escrita do país (uma por linha). O sistema usará esta lista para vincular os artigos automaticamente.
                    </p>
                    <textarea name="variationsText" class="form-control font-monospace" rows="6" placeholder="Brasil&#10;Brazil&#10;BR&#10;República Federativa do Brasil">{{ variationsText }}</textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_admin_geography_index') }}" class="btn-bm-secondary btn" style="text-decoration:none">Cancelar</a>
                    <button type="submit" class="btn-bm-primary">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Variations List and Merge Card -->
    <div class="col-lg-4">
        <!-- Variations List -->
        <div class="bm-card mb-4">
            <h5 style="font-weight:700" class="mb-3">Variações Cadastradas</h5>
            <p style="font-size:12px;color:var(--bm-text-muted)" class="mb-3">
                Variações registradas para este país. Você pode desmembrar qualquer uma para torná-la um país independente.
            </p>
            {% set hasAlternatives = false %}
            <div class="list-group list-group-flush border-bm rounded">
                {% for v in country.variations %}
                    {% if v.variationType == 'alternative' %}
                        {% set hasAlternatives = true %}
                        <div class="list-group-item bg-bm-card border-bm d-flex justify-content-between align-items-center py-2" style="font-size:13px;color:var(--bm-text)">
                            <span class="font-monospace text-accent">{{ v.variationName }}</span>
                            <form action="{{ path('app_admin_geography_country_variation_separate', {id: v.id}) }}" method="POST" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('separate_var_' ~ v.id) }}">
                                <button type="submit" class="btn btn-xs btn-outline-warning px-2 py-0" style="font-size:11px" onclick="return confirm('Deseja transformar esta variação em um novo país independente?');">
                                    Desmembrar
                                </button>
                            </form>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% if not hasAlternatives %}
                <div class="text-center py-3 text-muted-bm" style="font-size:12.5px">Nenhuma variação alternativa cadastrada.</div>
            {% endif %}
        </div>

        <!-- Merge Card -->
        <div class="bm-card">
            <h5 style="font-weight:700" class="mb-2 text-danger">Mesclar País</h5>
            <p style="font-size:12px;color:var(--bm-text-muted)" class="mb-3">
                Transfira todos os artigos vinculados e variações para o país selecionado abaixo, excluindo este registro permanentemente.
            </p>
            <form action="{{ path('app_admin_geography_country_merge', {id: country.id}) }}" method="POST" onsubmit="return confirm('Deseja realmente mesclar e excluir este país? A ação não poderá ser desfeita.');">
                <input type="hidden" name="_token" value="{{ csrf_token('merge_country_' ~ country.id) }}">
                <div class="mb-3">
                    <label class="form-label" style="font-size:12px">País de Destino</label>
                    <select name="targetId" class="form-select" style="font-size:12.5px" required>
                        <option value="">Selecione...</option>
                        {% for other in other_countries %}
                            <option value="{{ other.id }}">{{ other.commonName }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-danger w-100"><i class="bi bi-shuffle me-1"></i> Mesclar e Excluir</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
