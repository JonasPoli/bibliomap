{% extends 'base.html.twig' %}

{% block title %}Editar Estado — Admin{% endblock %}

{% block breadcrumb %}
    <span>Admin</span>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <a href="{{ path('app_admin_geography_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Geografia</a>
    <span style="margin:0 6px;opacity:0.4">/</span>
    <span class="current">Editar Estado</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-pencil text-accent me-2"></i>Editar Estado: {{ state.officialName }} {{ help('admin.geography.state.form_page') }}
    </h1>
    <p class="bm-page-subtitle">Modifique as informações gerais e variações para este estado.</p>
</div>

<div class="row g-4">
    <!-- Left Column: Form -->
    <div class="col-lg-8">
        <div class="bm-card">
            <form method="POST" action="{{ path('app_admin_geography_state_edit', {id: state.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_state_' ~ state.id) }}">

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Nome do Estado * {{ help('admin.geography.state.name') }}</label>
                        <input type="text" name="officialName" class="form-control" placeholder="Ex: São Paulo" value="{{ state.officialName }}" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Sigla / UF * {{ help('admin.geography.state.sigla') }}</label>
                        <input type="text" name="sigla" class="form-control" placeholder="Ex: SP" value="{{ state.sigla }}" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">País * {{ help('admin.geography.state.country') }}</label>
                        <select name="countryId" class="form-select" required>
                            <option value="">Selecione...</option>
                            {% for c in countries %}
                                <option value="{{ c.id }}" {% if state.country.id == c.id %}selected{% endif %}>{{ c.commonName }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Região (se aplicável) {{ help('admin.geography.state.region') }}</label>
                        <select name="regionId" class="form-select">
                            <option value="">Selecione...</option>
                            {% for r in regions %}
                                <option value="{{ r.id }}" {% if state.region and state.region.id == r.id %}selected{% endif %}>{{ r.name }} ({{ r.country.commonName }})</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Código Oficial (ex: IBGE) {{ help('admin.geography.state.code') }}</label>
                        <input type="text" name="officialCode" class="form-control" placeholder="Ex: 35" value="{{ state.officialCode }}">
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input type="hidden" name="status" value="0">
                            <input class="form-check-input" type="checkbox" name="status" id="status" value="1" {% if state.isStatus() %}checked{% endif %}>
                            <label class="form-check-label" for="status">Estado Ativo</label> {{ help('admin.geography.status') }}
                        </div>
                    </div>
                </div>

                <!-- Variations Input -->
                <div class="mb-4">
                    <h5 class="mb-2" style="font-weight:700">Variações de Escrita {{ help('admin.geography.state.variations') }}</h5>
                    <p style="font-size:12px;color:var(--bm-text-muted)">Uma grafia por linha. Apagar uma linha remove a variação ao salvar.</p>
                    <textarea name="variationsText" class="form-control font-monospace" rows="6" placeholder="SP&#10;Sao Paulo&#10;Estado de São Paulo">{{ variationsText }}</textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_admin_geography_index') }}" class="btn-bm-secondary btn" style="text-decoration:none">Cancelar</a>
                    <button type="submit" class="btn-bm-primary">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Variations List and Merge Card -->
    <div class="col-lg-4">
        <!-- Variations List -->
        <div class="bm-card mb-4">
            <h5 style="font-weight:700" class="mb-3">Variações Cadastradas {{ help('admin.geography.state.variations_list') }}</h5>
            {% set hasAlternatives = false %}
            <div class="list-group list-group-flush border-bm rounded">
                {% for v in state.variations %}
                    {% if v.variationType == 'alternative' %}
                        {% set hasAlternatives = true %}
                        <div class="list-group-item bg-bm-card border-bm d-flex justify-content-between align-items-center py-2" style="font-size:13px;color:var(--bm-text)">
                            <span class="font-monospace text-accent">{{ v.variationName }}</span>
                            <form action="{{ path('app_admin_geography_state_variation_separate', {id: v.id}) }}" method="POST" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('separate_var_' ~ v.id) }}">
                                <button type="submit" class="btn btn-xs btn-outline-warning px-2 py-0" style="font-size:11px" onclick="return confirm('Deseja transformar esta variação em um novo estado independente?');">
                                    Desmembrar
                                </button>
                            </form>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% if not hasAlternatives %}
                <div class="text-center py-3 text-muted-bm" style="font-size:12.5px">Nenhuma variação alternativa cadastrada.</div>
            {% endif %}
        </div>

        <!-- Merge Card -->
        <div class="bm-card">
            <h5 style="font-weight:700" class="mb-2 text-danger">Mesclar Estado {{ help('admin.geography.state.merge') }}</h5>
            <p style="font-size:12px;color:var(--bm-text-muted)" class="mb-3">
                Move os documentos e as variações deste estado para o destino e o exclui. As cidades dele ficam sem estado. Não pode ser desfeito.
            </p>
            <form action="{{ path('app_admin_geography_state_merge', {id: state.id}) }}" method="POST" onsubmit="return confirm('Deseja realmente mesclar e excluir este estado? A ação não poderá ser desfeita.');">
                <input type="hidden" name="_token" value="{{ csrf_token('merge_state_' ~ state.id) }}">
                <div class="mb-3">
                    <label class="form-label" style="font-size:12px">Estado de Destino</label>
                    <select name="targetId" class="form-select" style="font-size:12.5px" required>
                        <option value="">Selecione...</option>
                        {% for other in other_states %}
                            <option value="{{ other.id }}">{{ other.officialName }} ({{ other.country.commonName }})</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-danger w-100"><i class="bi bi-shuffle me-1"></i> Mesclar e Excluir</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
