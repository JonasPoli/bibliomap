        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { grid: { color: cl.grid }, ticks: { color: cl.text }, min: 0 },
                x: { grid: { display: false }, ticks: { color: cl.text } }
            }
        }
    });
}

// ── CSV Export Implementations (Client-Side, UTF-8 BOM, accents-friendly) ────
function downloadCSV(data, filename, headers, mapper) {
    if (!data || data.length === 0) {
        alert("Sem dados disponíveis para exportação.");
        return;
    }
    let csvContent = "\uFEFF"; // Excel BOM
    csvContent += headers.join(";") + "\r\n";
    data.forEach(item => {
        const row = mapper(item).map(val => {
            const strVal = String(val === null || val === undefined ? '' : val);
            if (strVal.includes(';') || strVal.includes('"') || strVal.includes('\n') || strVal.includes('\r')) {
                return '"' + strVal.replace(/"/g, '""') + '"';
            }
            return strVal;
        });
        csvContent += row.join(";") + "\r\n";
    });
    
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = filename + ".csv";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

function exportProduction() {
    downloadCSV(productionData, 'producao_cientifica_anual', ['Ano', 'Documentos'], d => [d.year, d.count]);
}
function exportCitations() {
    downloadCSV(citationsData, 'citacoes_por_ano', ['Ano', 'Total Citacoes', 'Media por Artigo'], d => [d.year, d.total_citations, parseFloat(d.avg_citations||0).toFixed(2).replace('.', ',')]);
}
function exportAuthors() {
    downloadCSV(authorsData, 'top_autores', ['Autor', 'Documentos', 'Citacoes'], d => [d.name || 'Desconhecido', d.doc_count, d.total_citations || 0]);
}
function exportSources() {
    downloadCSV(sourcesData, 'top_periodicos', ['Periodico', 'Documentos'], d => [d.source_title || 'Desconhecido', d.doc_count]);
}
function exportKeywords() {
    downloadCSV(keywordsData, 'frequencia_palavras_chave', ['Palavra-Chave', 'Documentos'], d => [d.term || 'Desconhecido', d.doc_count]);
}
function exportDocTypes() {
    downloadCSV(docTypesData, 'tipos_de_documento', ['Tipo de Documento', 'Documentos'], d => [d.type || 'Desconhecido', d.count]);
}
function exportOA() {
    downloadCSV(openAccessData, 'acesso_aberto', ['Status de Acesso', 'Documentos'], d => [d.status || 'Desconhecido', d.count]);
}
function exportCollab() {
    downloadCSV(collaborationData, 'autores_por_documento', ['Ano', 'Media Autores por Documento'], d => [d.year, parseFloat(d.avg_authors_per_doc||0).toFixed(2).replace('.', ',')]);
}

// ── Load all widgets in parallel ──────────────────────────────────────────────
Promise.all([
    loadProduction(),
    loadCitations(),
    loadAuthors(),
    loadSources(),
    loadKeywords('author'),
    loadDocTypes(),
    loadOpenAccess(),
    loadCollaboration(),
]);
</script>
