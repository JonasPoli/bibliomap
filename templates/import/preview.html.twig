{% extends 'base.html.twig' %}

{% block title %}Prévia da Importação — {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Projetos</a>
    <span style="margin:0 8px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_projects_show', {id: project.id}) }}" style="color:var(--bm-text-muted);text-decoration:none">{{ project.title|slice(0,30) }}…</a>
    <span style="margin:0 8px;color:var(--bm-border)">/</span>
    <span class="current">Prévia da importação</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title"><i class="bi bi-eye me-2 text-accent"></i>Prévia da Importação {{ help('import.preview.page') }}</h1>
    <p class="bm-page-subtitle">Passo 2 de 2 — Verifique os dados antes de confirmar. Nada foi gravado no projeto ainda.</p>
</div>

{# Base pré-selecionada: a detectada; se nada for reconhecido, "Outra" (o sistema tenta detectar sozinho ao importar) #}
{% set active_src = 'generic' %}
{% if detected %}
    {% set det = detected.source|lower %}
    {% if det == 'scopus' %}{% set active_src = 'scopus' %}
    {% elseif det == 'web of science' or det == 'wos' %}{% set active_src = 'wos' %}
    {% elseif det == 'lens.org' or det == 'lens' %}{% set active_src = 'lens' %}
    {% elseif det == 'pubmed' %}{% set active_src = 'pubmed' %}
    {% elseif det == 'openalex' %}{% set active_src = 'openalex' %}
    {% elseif det == 'crossref' %}{% set active_src = 'crossref' %}
    {% endif %}
{% endif %}

{# Detecção #}
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="bm-stat-card">
            <div style="font-size:11px;color:var(--bm-text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Arquivo {{ help('import.preview.file') }}</div>
            <div style="font-size:13px;font-weight:500;color:var(--bm-text);word-break:break-all">{{ originalFilename }}</div>
            <div style="font-size:11px;color:var(--bm-text-muted);margin-top:2px">
                {{ (fileSize / 1024 / 1024)|number_format(1) }} MB
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="bm-stat-card">
            <div style="font-size:11px;color:var(--bm-text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Fonte detectada {{ help('import.preview.detected_source') }}</div>
            {% if detected %}
                <div class="bm-stat-value" style="font-size:22px">{{ active_src != 'generic' ? data_sources[active_src].label : detected.source }}</div>
                <div style="font-size:11px;color:var(--bm-success)">
                    <i class="bi bi-check-circle-fill me-1"></i>Confiança: {{ (detected.score * 100)|number_format(0) }}%
                </div>
            {% else %}
                <div style="font-size:14px;font-weight:500;color:var(--bm-warning)">Não detectada</div>
                <div style="font-size:11px;color:var(--bm-text-muted)">Formato provavelmente sem leitor (RIS, BibTeX, XLSX, OpenAlex...). Confira a prévia abaixo.</div>
            {% endif %}
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="bm-stat-card">
            <div style="font-size:11px;color:var(--bm-text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Registros na prévia {{ help('import.preview.preview_count') }}</div>
            <div class="bm-stat-value">{{ previewRecords|length|number_format }}</div>
            <div style="font-size:11px;color:var(--bm-text-muted)">primeiros registros lidos (máx. 10) — o total é contado ao importar</div>
        </div>
    </div>
</div>

{# Preview table #}
<div class="bm-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 style="font-size:15px;font-weight:600;color:var(--bm-text);margin:0">
            Prévia — primeiros {{ previewRecords|length }} registros {{ help('import.preview.table') }}
        </h3>
        <span style="font-size:12px;color:var(--bm-text-muted)">Resumo, palavras-chave e afiliações também serão importados</span>
    </div>

    <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:12px">
            <thead>
                <tr style="border-bottom:2px solid var(--bm-border)">
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;white-space:nowrap">#</th>
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;min-width:300px">Título</th>
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;white-space:nowrap">Autores</th>
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;white-space:nowrap">Ano</th>
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;white-space:nowrap">Fonte</th>
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;white-space:nowrap">DOI</th>
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;white-space:nowrap">Citações {{ help('import.preview.citations') }}</th>
                    <th style="padding:8px 12px;text-align:left;color:var(--bm-text-muted);font-weight:600;white-space:nowrap">Tipo</th>
                </tr>
            </thead>
            <tbody>
                {% for i, rec in previewRecords %}
                    <tr style="border-bottom:1px solid var(--bm-border);transition:background 0.1s"
                        onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background=''">
                        <td style="padding:10px 12px;color:var(--bm-text-muted)">{{ i + 1 }}</td>
                        <td style="padding:10px 12px;color:var(--bm-text);max-width:300px">
                            <div style="font-weight:500;line-height:1.4">
                                {{ rec.title|default('—')|slice(0, 80) }}{% if rec.title|length > 80 %}…{% endif %}
                            </div>
                        </td>
                        <td style="padding:10px 12px;color:var(--bm-text-muted);white-space:nowrap;max-width:200px;overflow:hidden;text-overflow:ellipsis">
                            {{ rec.authorNames|join('; ')|slice(0, 60) }}{% if rec.authorNames|join('; ')|length > 60 %}…{% endif %}
                        </td>
                        <td style="padding:10px 12px;color:var(--bm-text);font-weight:500">
                            {{ rec.year ?? '—' }}
                        </td>
                        <td style="padding:10px 12px;color:var(--bm-text-muted);white-space:nowrap">
                            {{ rec.sourceTitle|default('—')|slice(0,30) }}{% if rec.sourceTitle|length > 30 %}…{% endif %}
                        </td>
                        <td style="padding:10px 12px">
                            {% if rec.doi %}
                                <a href="https://doi.org/{{ rec.doi }}" target="_blank"
                                   style="color:var(--bm-accent);font-size:11px;font-family:monospace">
                                    {{ rec.doi|slice(0,25) }}…
                                </a>
                                <a href="https://sci-hub.box/{{ rec.doi }}" target="_blank" class="ms-1"
                                   style="color:var(--bm-accent)" title="Sci-Hub">
                                    <i class="bi bi-key"></i>
                                </a>
                            {% else %}
                                <span style="color:var(--bm-text-muted)">—</span>
                            {% endif %}
                        </td>
                        <td style="padding:10px 12px;text-align:center">
                            {% if rec.citedBy is not null %}
                                <span style="font-weight:600;color:{{ rec.citedBy > 10 ? 'var(--bm-accent)' : 'var(--bm-text-muted)' }}">{{ rec.citedBy }}</span>
                            {% else %}
                                <span style="color:var(--bm-text-muted)">—</span>
                            {% endif %}
                        </td>
                        <td style="padding:10px 12px">
                            {% if rec.documentType %}
                                <span style="font-size:10px;background:rgba(79,142,247,0.1);color:var(--bm-accent);padding:2px 8px;border-radius:4px;white-space:nowrap">{{ rec.documentType }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" style="padding:24px;text-align:center;color:var(--bm-text-muted)">Nenhum registro reconhecido na prévia. Se você confirmar, provavelmente nenhum documento será importado — verifique se o arquivo é Scopus CSV, WoS TXT, Lens CSV ou PubMed NBIB/CSV.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Confirm form #}
<div class="bm-card">
    <h3 style="font-size:15px;font-weight:600;color:var(--bm-text);margin:0 0 16px">
        <i class="bi bi-gear me-2 text-accent"></i>Configurações da importação {{ help('import.preview.settings') }}
    </h3>

    <form method="post" action="{{ path('app_import_confirm', {projectId: project.id}) }}" id="confirm-form">

        <style>
        .src-pick-card {
            display:flex; flex-direction:column; align-items:center; justify-content:center;
            gap:8px; padding:12px 8px;
            border:1.5px solid var(--bm-border);
            border-radius:10px;
            background:rgba(255,255,255,.02);
            transition:all .15s;
            user-select:none;
        }
        .src-pick-card:hover {
            border-color:var(--bm-accent);
            background:rgba(79,142,247,.05);
        }
        .src-pick-card.active {
            border-color:var(--bm-accent);
            background:rgba(79,142,247,.10);
            box-shadow:0 0 0 2px rgba(79,142,247,.2);
        }
        .src-pick-logo {
            height:24px;
            display:inline-flex;
            align-items:center;
            justify-content:center;
        }
        .src-pick-logo img { height:22px; width:auto; max-width:80px; object-fit:contain; display:block; }
        .src-pick-name {
            font-size:11px;
            font-weight:600;
            color:var(--bm-text-muted);
            text-align:center;
            line-height:1.2;
        }
        .src-pick-card.active .src-pick-name { color:var(--bm-accent); }
        </style>

        <div class="row g-3 mb-4">
            <div class="col-12">
                <label class="form-label" for="dataset-name">Nome desta importação</label> {{ help('import.preview.name') }}
                <input type="text" id="dataset-name" name="dataset_name" class="form-control"
                       value="{{ originalFilename }}"
                       placeholder="Ex: Scopus — busca principal 2024">
                <div style="font-size:11px;color:var(--bm-text-muted);margin-top:4px">Identifique esta importação dentro do projeto</div>
            </div>
            <div class="col-12">
                <label class="form-label">Fonte dos dados</label> {{ help('import.preview.source') }}
                <div id="source-picker" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:10px;margin-top:4px">
                    {% for src_key, src in data_sources %}
                        {% if src_key != 'generic' %}
                        <label class="src-pick-card {{ active_src == src_key ? 'active' : '' }}"
                               for="src_{{ src_key }}" title="{{ src.label }}" style="cursor:pointer">
                            <input type="radio" id="src_{{ src_key }}" name="source"
                                   value="{{ src_key }}" style="display:none"
                                   {{ active_src == src_key ? 'checked' : '' }}>
                            <span class="src-pick-logo">{{ source_logo(src_key, 22) }}</span>
                            <span class="src-pick-name">{{ src.label }}</span>
                        </label>
                        {% endif %}
                    {% endfor %}
                    <label class="src-pick-card {{ active_src not in ['scopus','wos','lens','pubmed','openalex','crossref'] ? 'active' : '' }}"
                           for="src_generic" title="Outra base" style="cursor:pointer">
                        <input type="radio" id="src_generic" name="source"
                               value="generic" style="display:none"
                               {{ active_src not in ['scopus','wos','lens','pubmed','openalex','crossref'] ? 'checked' : '' }}>
                        <span class="src-pick-logo" style="font-size:20px">📄</span>
                        <span class="src-pick-name">Outra</span>
                    </label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label" for="dataset-description">Descrição (opcional)</label> {{ help('import.preview.description') }}
                <textarea id="dataset-description" name="description" class="form-control" rows="2"
                          placeholder="Descreva a string de busca, filtros aplicados, data de acesso à base..."></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="period-start">Período de busca — início</label> {{ help('import.preview.search_period') }}
                <input type="date" id="period-start" name="search_period_start" class="form-control">
            </div>
            <div class="col-md-6">
                <label class="form-label" for="period-end">Período de busca — fim</label>
                <input type="date" id="period-end" name="search_period_end" class="form-control">
            </div>
            <div class="col-12">
                <div class="form-label">O que acontece ao confirmar {{ help('import.preview.processing_rules') }}</div>
                <ul style="font-size:13px;color:var(--bm-text-muted);margin:0;padding-left:18px;line-height:1.7">
                    <li>Registros que já existem no projeto (mesmo DOI ou mesmo título + ano) são ignorados e listados na aba "Duplicados ignorados". {{ help('import.dedup') }}</li>
                    <li>Palavras-chave do autor e indexadas são sempre importadas.</li>
                    <li>O processamento roda em segundo plano; você pode fechar a página.</li>
                </ul>
            </div>
        </div>

        <div class="d-flex gap-3 align-items-center">
            <button type="submit" id="confirm-btn" class="btn-bm-primary" style="font-size:15px;padding:10px 28px">
                <i class="bi bi-check2-circle me-2"></i>Confirmar e importar
            </button>
            {{ help('import.preview.confirm') }}
            <a href="{{ path('app_import_index', {projectId: project.id}) }}" class="btn-bm-secondary">
                Voltar
            </a>
        </div>
    </form>
</div>

{# Loading overlay #}
<div id="import-overlay" style="display:none;position:fixed;inset:0;background:rgba(13,17,23,0.85);z-index:9999;display:none;flex-direction:column;align-items:center;justify-content:center;gap:20px">
    <div style="font-size:48px">⚙️</div>
    <div style="font-size:20px;font-weight:600;color:var(--bm-text)">Criando a importação...</div>
    <div style="font-size:14px;color:var(--bm-text-muted);max-width:400px;text-align:center">
        Em instantes você verá o andamento do processamento, que roda em segundo plano.
    </div>
    <div style="width:300px;height:8px;background:var(--bm-border);border-radius:4px;overflow:hidden">
        <div class="progress-indeterminate" style="height:100%;background:linear-gradient(90deg,#4f8ef7,#a855f7);border-radius:4px"></div>
    </div>
</div>

<style>
@keyframes indeterminate { 0% { transform: translateX(-100%); } 100% { transform: translateX(400%); } }
.progress-indeterminate { width: 40%; animation: indeterminate 1.5s ease-in-out infinite; }
</style>

<script>
document.querySelectorAll('.src-pick-card').forEach(card => {
    card.addEventListener('click', () => {
        document.querySelectorAll('.src-pick-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        const radio = card.querySelector('input[type=radio]');
        if (radio) radio.checked = true;
    });
});

document.getElementById('confirm-form').addEventListener('submit', function() {
    document.getElementById('confirm-btn').disabled = true;
    document.getElementById('confirm-btn').innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Importando...';
    const overlay = document.getElementById('import-overlay');
    overlay.style.display = 'flex';
});
</script>
{% endblock %}
