{% extends 'base.html.twig' %}

{% block title %}Importar Dados — {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Projetos</a>
    <span style="margin:0 8px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_projects_show', {id: project.id}) }}" style="color:var(--bm-text-muted);text-decoration:none">{{ project.title|slice(0,30) }}…</a>
    <span style="margin:0 8px;color:var(--bm-border)">/</span>
    <span class="current">Importar dados</span>
{% endblock %}

{% block stylesheets %}
<style>
/* ── Source tabs ── */
.src-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:20px; }
.src-tab {
    display:flex; align-items:center; gap:7px;
    padding:7px 14px; border-radius:10px;
    border:1px solid var(--bm-border); background:transparent;
    color:var(--bm-text-muted); font-size:13px; font-weight:500;
    cursor:pointer; transition:all .18s;
    font-family: inherit;
}
.src-tab:hover { border-color:var(--bm-accent); color:var(--bm-accent); background:rgba(79,142,247,.05); }
.src-tab.active {
    background:rgba(79,142,247,.12); color:var(--bm-accent);
    border-color:rgba(79,142,247,.45); font-weight:700;
}
.src-panel { display:none; }
.src-panel.active { display:block; }

/* ── Steps ── */
.step-list { list-style:none; padding:0; margin:0; }
.step-list li {
    display:flex; gap:14px; align-items:flex-start;
    padding:11px 0; border-bottom:1px solid var(--bm-border);
}
.step-list li:last-child { border-bottom:none; }
.step-num {
    width:26px; height:26px; border-radius:50%; flex-shrink:0;
    background:rgba(79,142,247,.13); border:1.5px solid rgba(79,142,247,.3);
    color:var(--bm-accent); font-size:12px; font-weight:700;
    display:flex; align-items:center; justify-content:center;
}
.step-text { font-size:13.5px; color:var(--bm-text); line-height:1.55; }
.step-text strong { color:var(--bm-text); }
.step-text code {
    font-family: 'Fira Mono', 'Cascadia Code', monospace;
    font-size:12px; padding:2px 7px; border-radius:5px;
    background:rgba(255,255,255,.06); color:#c9d1d9;
    border:1px solid rgba(255,255,255,.08);
}
.step-note {
    display:flex; gap:10px; align-items:flex-start;
    background:rgba(210,153,34,.06);
    border:1px solid rgba(210,153,34,.2);
    border-radius:10px; padding:12px 14px;
    margin-top:16px; font-size:12.5px; color:#94a3b8; line-height:1.6;
}
.step-note-warn {
    background:rgba(239,68,68,.06);
    border-color:rgba(239,68,68,.2);
}
.step-note-tip {
    background:rgba(63,185,80,.06);
    border-color:rgba(63,185,80,.2);
}
.fmt-badge {
    display:inline-flex; align-items:center; gap:5px;
    padding:3px 10px; border-radius:6px; font-size:11.5px; font-weight:700;
    letter-spacing:.3px; text-transform:uppercase;
}
.fmt-csv  { background:rgba(63,185,80,.12);  color:#3fb950; border:1px solid rgba(63,185,80,.3); }
.fmt-txt  { background:rgba(210,153,34,.12); color:#d29922; border:1px solid rgba(210,153,34,.3); }
.fmt-ris  { background:rgba(79,142,247,.12); color:#4f8ef7; border:1px solid rgba(79,142,247,.3); }
.fmt-bib  { background:rgba(168,85,247,.12); color:#a855f7; border:1px solid rgba(168,85,247,.3); }
.fmt-xlsx { background:rgba(16,185,129,.12); color:#10b981; border:1px solid rgba(16,185,129,.3); }
.fmt-xml  { background:rgba(244,114,182,.12);color:#f472b6; border:1px solid rgba(244,114,182,.3); }

/* ── Source header ── */
.src-header {
    display:flex; align-items:center; gap:14px;
    padding:16px 20px; margin:-4px -4px 20px;
    background:rgba(255,255,255,.02);
    border:1px solid var(--bm-border); border-radius:12px;
}
.src-logo {
    width:44px; height:44px; border-radius:11px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:22px; font-weight:900; letter-spacing:-1px;
}

/* ── Source logo containers ── */
.src-tab-img {
    display:inline-flex;
    align-items:center;
    height:20px;
    flex-shrink:0;
}
.src-tab-img img { height:18px; width:auto; max-width:90px; display:block; object-fit:contain; }
.src-logo-box {
    display:flex; align-items:center; justify-content:center;
    min-width:54px; max-width:170px; height:48px;
    flex-shrink:0;
}
.src-logo-box img { height:36px; width:auto; max-width:160px; display:block; object-fit:contain; }
</style>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title"><i class="bi bi-upload me-2 text-accent"></i>Importar Base Bibliográfica</h1>
    <p class="bm-page-subtitle">Passo 1 de 2 — Selecione o arquivo exportado da base de dados</p>
</div>

<div class="row">
    <div class="col-12 col-lg-8">

        {# Upload Card #}
        <div class="bm-card mb-4">
            <form method="post" action="{{ path('app_import_upload', {projectId: project.id}) }}"
                  enctype="multipart/form-data" id="upload-form">

                <h3 style="font-size:15px;font-weight:600;color:var(--bm-text);margin:0 0 20px">Selecionar arquivo</h3>

                {# Drop zone #}
                <div id="drop-zone"
                     style="border:2px dashed var(--bm-border);border-radius:12px;padding:48px 24px;text-align:center;cursor:pointer;transition:all 0.2s;position:relative"
                     onclick="document.getElementById('file-input').click()">
                    <div id="drop-icon" style="font-size:48px;margin-bottom:12px">📁</div>
                    <div style="font-size:15px;font-weight:500;color:var(--bm-text);margin-bottom:4px">
                        Arraste o arquivo aqui ou <span style="color:var(--bm-accent)">clique para selecionar</span>
                    </div>
                    <div style="font-size:12px;color:var(--bm-text-muted)">
                        CSV, TXT (Web of Science), RIS, BibTeX, XLSX — até 500&nbsp;MB
                    </div>
                    <div id="file-info" style="display:none;margin-top:16px;padding:12px;background:rgba(79,142,247,0.1);border-radius:8px;border:1px solid rgba(79,142,247,0.2)">
                        <div id="file-name" style="font-size:14px;font-weight:500;color:var(--bm-accent)"></div>
                        <div id="file-size" style="font-size:12px;color:var(--bm-text-muted)"></div>
                    </div>
                    <input type="file" id="file-input" name="file" accept=".csv,.txt,.ris,.bib,.xlsx,.json,.nbib"
                           style="position:absolute;inset:0;opacity:0;cursor:pointer" required>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a href="{{ path('app_projects_show', {id: project.id}) }}" class="btn-bm-secondary">Cancelar</a>
                    <button type="submit" id="upload-btn" class="btn-bm-primary" disabled>
                        <i class="bi bi-arrow-right-circle me-1"></i>Próximo passo
                    </button>
                </div>
            </form>
        </div>

        {# Progress bar #}
        <div id="upload-progress" style="display:none" class="bm-card">
            <div style="font-size:14px;font-weight:500;color:var(--bm-text);margin-bottom:12px">
                <i class="bi bi-arrow-repeat spin me-2" style="color:var(--bm-accent)"></i>Enviando arquivo...
            </div>
            <div style="height:6px;background:var(--bm-border);border-radius:3px;overflow:hidden">
                <div id="progress-bar" style="height:100%;background:linear-gradient(90deg,#4f8ef7,#a855f7);width:0%;transition:width 0.3s"></div>
            </div>
        </div>

        {# ════════════════════════════════════════════════
           HELP PANEL
        ════════════════════════════════════════════════ #}
        <div class="bm-card mt-2">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px">
                <div style="width:32px;height:32px;border-radius:9px;background:rgba(210,153,34,.12);border:1px solid rgba(210,153,34,.25);display:flex;align-items:center;justify-content:center">
                    <i class="bi bi-question-circle" style="color:#d29922;font-size:15px"></i>
                </div>
                <div>
                    <div style="font-size:14px;font-weight:700;color:var(--bm-text)">Como exportar o arquivo da minha base de dados?</div>
                    <div style="font-size:12px;color:var(--bm-text-muted)">Selecione a base e siga o passo a passo</div>
                </div>
            </div>

            {# ── Tabs ── #}
            <div class="src-tabs" id="srcTabs">
                <button class="src-tab active" data-src="scopus">
                    <span class="src-tab-img">{{ source_logo('scopus', 18) }}</span> Scopus
                </button>
                <button class="src-tab" data-src="wos">
                    <span class="src-tab-img">{{ source_logo('wos', 18) }}</span> Web of Science
                </button>
                <button class="src-tab" data-src="lens">
                    <span class="src-tab-img">{{ source_logo('lens', 18) }}</span> Lens.org
                </button>
                <button class="src-tab" data-src="pubmed">
                    <span class="src-tab-img">{{ source_logo('pubmed', 18) }}</span> PubMed
                </button>
                <button class="src-tab" data-src="openalex">
                    <span class="src-tab-img">{{ source_logo('openalex', 18) }}</span> OpenAlex
                </button>
                <button class="src-tab" data-src="crossref">
                    <span class="src-tab-img">{{ source_logo('crossref', 18) }}</span> Crossref
                </button>
                <button class="src-tab" data-src="other">
                    <span style="font-size:16px">📄</span> Outra base
                </button>
            </div>

            {# ════ SCOPUS ════ #}
            <div class="src-panel active" id="panel-scopus">
                <div class="src-header">
                    <div class="src-logo-box">{{ source_logo('scopus', 36) }}</div>
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--bm-text)">Scopus (Elsevier)</div>
                        <div style="font-size:12px;color:var(--bm-text-muted)">scopus.com &nbsp;·&nbsp; Formato aceito: <span class="fmt-badge fmt-csv">CSV</span></div>
                    </div>
                </div>
                <ol class="step-list">
                    <li><div class="step-num">1</div><div class="step-text">Acesse <a href="https://www.scopus.com" target="_blank" style="color:var(--bm-accent)">scopus.com</a> e realize sua busca normalmente.</div></li>
                    <li><div class="step-num">2</div><div class="step-text">Selecione os registros desejados. Para todos: marque o checkbox no topo e clique em <strong>"Select all"</strong> (pode selecionar até 2.000 por vez).</div></li>
                    <li><div class="step-num">3</div><div class="step-text">Clique no botão <strong>"Export"</strong> no menu superior dos resultados.</div></li>
                    <li><div class="step-num">4</div><div class="step-text">Escolha o formato <strong>CSV (Excel)</strong>.</div></li>
                    <li><div class="step-num">5</div><div class="step-text">
                        Na tela de seleção de campos, marque ao menos:
                        <ul style="margin:6px 0 0 4px;padding-left:16px;font-size:13px;color:var(--bm-text-muted);line-height:1.7">
                            <li>Citation Information</li>
                            <li>Bibliographical Information</li>
                            <li>Abstract &amp; Keywords</li>
                            <li>Funding Details</li>
                            <li>Other Information</li>
                        </ul>
                    </div></li>
                    <li><div class="step-num">6</div><div class="step-text">Clique em <strong>"Export"</strong>. O arquivo <code>.csv</code> será baixado automaticamente.</div></li>
                </ol>
                <div class="step-note">
                    <i class="bi bi-info-circle" style="color:#d29922;flex-shrink:0;margin-top:2px"></i>
                    <span><strong style="color:#94a3b8">Limite:</strong> o Scopus exporta até 2.000 registros por vez. Para buscas maiores, use filtros de ano ou exporte em lotes e importe cada arquivo separadamente no mesmo projeto.</span>
                </div>
            </div>

            {# ════ WEB OF SCIENCE ════ #}
            <div class="src-panel" id="panel-wos">
                <div class="src-header">
                    <div class="src-logo-box">{{ source_logo('wos', 36) }}</div>
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--bm-text)">Web of Science (Clarivate)</div>
                        <div style="font-size:12px;color:var(--bm-text-muted)">webofscience.com &nbsp;·&nbsp; Formato aceito: <span class="fmt-badge fmt-txt">Plain Text (.txt)</span></div>
                    </div>
                </div>

                <ol class="step-list">
                    <li>
                        <div class="step-num">1</div>
                        <div class="step-text">
                            Acesse <a href="https://www.webofscience.com" target="_blank" style="color:var(--bm-accent)">webofscience.com</a>
                            e execute sua busca. Anote o número total de resultados (ex: <em>"42.791 Documents"</em>).
                        </div>
                    </li>
                    <li>
                        <div class="step-num">2</div>
                        <div class="step-text">
                            Clique no botão <strong>"Export"</strong> (menu dropdown acima da lista de resultados, ao lado de "Add To Marked List").
                        </div>
                    </li>
                    <li>
                        <div class="step-num">3</div>
                        <div class="step-text">
                            No menu que abre, selecione <strong>"Plain text file"</strong>.<br>
                            <span style="font-size:12px;color:var(--bm-text-muted)">⚠ Não escolha "EndNote desktop", "RIS" ou "BibTeX" — o BiblioMap identifica melhor o formato Plain Text do WoS, que inclui todas as tags de campo.</span>
                        </div>
                    </li>
                    <li>
                        <div class="step-num">4</div>
                        <div class="step-text">
                            Na janela <strong>"Export Records to Plain Text File"</strong>:
                            <ul style="margin:8px 0 0 4px;padding-left:16px;line-height:1.9;font-size:13px;color:var(--bm-text-muted)">
                                <li>Selecione <strong style="color:var(--bm-text)">"Records from:"</strong> e defina o intervalo — ex: <code>1</code> a <code>500</code></li>
                                <li>Em <strong style="color:var(--bm-text)">"Record Content"</strong>, selecione <strong style="color:var(--bm-text)">"Full Record and Cited References"</strong></li>
                            </ul>
                        </div>
                    </li>
                    <li>
                        <div class="step-num">5</div>
                        <div class="step-text">
                            Clique em <strong>"Export"</strong>. O arquivo <code>savedrecs.txt</code> será baixado automaticamente.
                            Renomeie para algo identificável (ex: <code>wos_1_500.txt</code>) antes de importar.
                        </div>
                    </li>
                </ol>

                {# Batch export section #}
                <div style="margin:20px 0 12px;padding:14px 16px;background:rgba(79,142,247,.06);border:1px solid rgba(79,142,247,.18);border-radius:12px">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                        <i class="bi bi-stack" style="color:var(--bm-accent);font-size:15px"></i>
                        <strong style="font-size:13.5px;color:var(--bm-text)">Como exportar mais de 500 registros (em lotes)</strong>
                    </div>
                    <p style="font-size:13px;color:var(--bm-text-muted);margin:0 0 10px;line-height:1.6">
                        O WoS limita cada exportação a <strong style="color:var(--bm-text)">500 registros por vez</strong>.
                        Para buscas com mais resultados, repita o processo ajustando o intervalo a cada exportação:
                    </p>
                    <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:13px;align-items:center">
                        <code style="background:rgba(255,255,255,.05);padding:3px 10px;border-radius:6px;border:1px solid rgba(255,255,255,.08);color:#c9d1d9;white-space:nowrap">1 → 500</code>
                        <span style="color:var(--bm-text-muted)">1º arquivo → <code>wos_1_500.txt</code></span>
                        <code style="background:rgba(255,255,255,.05);padding:3px 10px;border-radius:6px;border:1px solid rgba(255,255,255,.08);color:#c9d1d9;white-space:nowrap">501 → 1000</code>
                        <span style="color:var(--bm-text-muted)">2º arquivo → <code>wos_501_1000.txt</code></span>
                        <code style="background:rgba(255,255,255,.05);padding:3px 10px;border-radius:6px;border:1px solid rgba(255,255,255,.08);color:#c9d1d9;white-space:nowrap">1001 → 1500</code>
                        <span style="color:var(--bm-text-muted)">3º arquivo → e assim por diante…</span>
                    </div>
                    <p style="font-size:12.5px;color:var(--bm-text-muted);margin:10px 0 0;line-height:1.6">
                        Importe cada arquivo separadamente no mesmo projeto. O BiblioMap faz a
                        <strong style="color:var(--bm-text)">deduplicação automática</strong> entre os lotes, eliminando registros duplicados pelo hash título+ano.
                    </p>
                </div>

                {# File format reference #}
                <div style="margin-top:16px">
                    <div style="font-size:12px;font-weight:700;color:var(--bm-text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px">
                        Estrutura do arquivo gerado
                    </div>
                    <div style="font-family:'Fira Mono','Cascadia Code',monospace;font-size:11.5px;background:#060b14;border:1px solid #1e2d45;border-radius:10px;padding:14px 16px;line-height:1.8;overflow-x:auto">
                        <span style="color:#6a9955">FN Clarivate Analytics Web of Science</span><br>
                        <span style="color:#6a9955">VR 1.0</span><br>
                        <span style="color:#569cd6">PT</span> <span style="color:#ce9178">J</span> &nbsp;<span style="color:#4a5568">← tipo: J=artigo, C=conferência, B=livro</span><br>
                        <span style="color:#569cd6">AU</span> <span style="color:#ce9178">Sobrenome, N</span> &nbsp;<span style="color:#4a5568">← autores (um por linha com indentação)</span><br>
                        <span style="color:#569cd6">AF</span> <span style="color:#ce9178">Nome Completo</span> &nbsp;<span style="color:#4a5568">← nome completo dos autores</span><br>
                        <span style="color:#569cd6">TI</span> <span style="color:#ce9178">Título do artigo</span><br>
                        <span style="color:#569cd6">SO</span> <span style="color:#ce9178">NOME DO PERIÓDICO</span><br>
                        <span style="color:#569cd6">DE</span> <span style="color:#ce9178">palavra-chave; outra keyword</span><br>
                        <span style="color:#569cd6">AB</span> <span style="color:#ce9178">Resumo completo do artigo...</span><br>
                        <span style="color:#569cd6">PY</span> <span style="color:#b5cea8">2024</span> &nbsp;<span style="color:#4a5568">← ano de publicação</span><br>
                        <span style="color:#569cd6">DI</span> <span style="color:#ce9178">10.xxxx/xxxxx</span> &nbsp;<span style="color:#4a5568">← DOI</span><br>
                        <span style="color:#569cd6">UT</span> <span style="color:#ce9178">WOS:000XXXXXXXXXX</span> &nbsp;<span style="color:#4a5568">← ID único WoS</span><br>
                        <span style="color:#569cd6">ER</span> &nbsp;<span style="color:#4a5568">← fim do registro</span><br>
                        <br>
                        <span style="color:#4a5568">PT J  ← próximo registro...</span>
                    </div>
                </div>

                <div class="step-note" style="margin-top:16px">
                    <i class="bi bi-info-circle" style="color:#d29922;flex-shrink:0;margin-top:2px"></i>
                    <span>
                        O arquivo começa sempre com <code>FN Clarivate Analytics Web of Science</code> e <code>VR 1.0</code>.
                        Cada registro termina com a tag <code>ER</code> em linha isolada.
                        O BiblioMap detecta automaticamente este formato e mapeia todas as tags de campo.
                    </span>
                </div>
            </div>


            {# ════ LENS.ORG ════ #}
            <div class="src-panel" id="panel-lens">
                <div class="src-header">
                    <div class="src-logo-box">{{ source_logo('lens', 36) }}</div>
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--bm-text)">Lens.org</div>
                        <div style="font-size:12px;color:var(--bm-text-muted)">lens.org/scholar &nbsp;·&nbsp; Formato aceito: <span class="fmt-badge fmt-csv">CSV</span></div>
                    </div>
                </div>
                <ol class="step-list">
                    <li><div class="step-num">1</div><div class="step-text">Acesse <a href="https://www.lens.org/lens/scholar/search" target="_blank" style="color:var(--bm-accent)">lens.org/lens/scholar</a> e realize sua busca.</div></li>
                    <li><div class="step-num">2</div><div class="step-text">Após obter os resultados, clique no ícone de <strong>Export</strong> (ícone de seta para baixo, no canto superior direito da lista de resultados).</div></li>
                    <li><div class="step-num">3</div><div class="step-text">Na janela de exportação, selecione o formato <strong>CSV</strong>.</div></li>
                    <li><div class="step-num">4</div><div class="step-text">Em <strong>Fields</strong>, mantenha <strong>"All fields"</strong> selecionado para garantir todos os metadados de abstract e afiliação.</div></li>
                    <li><div class="step-num">5</div><div class="step-text">Clique em <strong>"Export"</strong>. O Lens iniciará o processamento em segundo plano (pode levar alguns minutos para buscas grandes).</div></li>
                    <li><div class="step-num">6</div><div class="step-text">Assim que o arquivo for gerado, você receberá um aviso por e-mail. Para baixar, clique no link do e-mail ou vá na barra lateral esquerda do Lens em <strong>Notifications</strong> e clique em <strong>"Export complete"</strong> para obter o seu arquivo <code>lens-export.csv</code>.</div></li>
                </ol>
                <div class="step-note">
                    <i class="bi bi-info-circle" style="color:#d29922;flex-shrink:0;margin-top:2px"></i>
                    <span><strong style="color:#94a3b8">Limite:</strong> a exportação gratuita do Lens.org é limitada a ~1.000 registros. Para conjuntos maiores, utilize a <a href="https://docs.api.lens.org" target="_blank" style="color:var(--bm-accent)">API do Lens</a> (requer solicitação de token) ou divida a busca em períodos.</span>
                </div>
            </div>

            {# ════ PUBMED ════ #}
            <div class="src-panel" id="panel-pubmed">
                <div class="src-header">
                    <div class="src-logo-box">{{ source_logo('pubmed', 36) }}</div>
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--bm-text)">PubMed (NCBI/NLM)</div>
                        <div style="font-size:12px;color:var(--bm-text-muted)">pubmed.ncbi.nlm.nih.gov &nbsp;·&nbsp; Formato aceito: <span class="fmt-badge fmt-csv">CSV</span> <span class="fmt-badge fmt-ris" style="margin-left:4px">NBIB/RIS</span></div>
                    </div>
                </div>
                <div class="step-note step-note-warn" style="margin-bottom:16px">
                    <i class="bi bi-exclamation-triangle" style="color:#f87171;flex-shrink:0;margin-top:2px"></i>
                    <span><strong style="color:#94a3b8">Atenção ao Exportar:</strong> Não clique no ícone de download (seta para baixo) que fica ao lado do gráfico de linha do tempo lateral <strong>"RESULTS BY YEAR"</strong>. Aquele botão baixa apenas o quantitativo anual de publicações (arquivo <code>PubMed_Timeline_Results_by_Year.csv</code>), que não possui os metadados dos artigos e não serve para importação. Use sempre o botão <strong>"Save"</strong> no topo da tela.</span>
                </div>
                <ol class="step-list">
                    <li><div class="step-num">1</div><div class="step-text">Acesse <a href="https://pubmed.ncbi.nlm.nih.gov" target="_blank" style="color:var(--bm-accent)">pubmed.ncbi.nlm.nih.gov</a> e faça sua busca.</div></li>
                    <li><div class="step-num">2</div><div class="step-text">Clique em <strong>"Save"</strong> (botão acima dos resultados).</div></li>
                    <li><div class="step-num">3</div><div class="step-text">
                        Selecione o formato:
                        <ul style="margin:6px 0 0 4px;padding-left:16px;font-size:13px;color:var(--bm-text-muted);line-height:1.7">
                            <li><strong>CSV</strong> — exporta os campos principais (título, autores, PMID, DOI, ano, revista)</li>
                            <li><strong>PubMed</strong> (recomendado) — exporta o formato estruturado completo com abstract e MeSH terms</li>
                        </ul>
                    </div></li>
                    <li><div class="step-num">4</div><div class="step-text">Em "Selection", escolha <strong>"All results"</strong> para exportar tudo, ou "Selection" para itens marcados.</div></li>
                    <li><div class="step-num">5</div><div class="step-text">Clique em <strong>"Create file"</strong>. O arquivo <code>.csv</code> ou <code>.nbib</code> será baixado.</div></li>
                </ol>
                <div class="step-note step-note-tip">
                    <i class="bi bi-lightbulb" style="color:#3fb950;flex-shrink:0;margin-top:2px"></i>
                    <span><strong style="color:#94a3b8">Dica:</strong> para exportar com abstract e termos MeSH, prefira o formato <strong>PubMed</strong> (<code>.nbib</code>). O arquivo CSV do PubMed tem menos campos, mas é igualmente aceito pelo BiblioMap. Para mais de 10.000 registros, utilize a API E-utilities da NCBI.</span>
                </div>

                <div style="margin-top: 24px;">
                    <div style="font-size: 13.5px; font-weight: 700; color: var(--bm-text); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                        <i class="bi bi-file-earmark-bar-graph text-accent"></i>
                        Comparativo de Formatos de Exportação do PubMed
                    </div>
                    <p style="font-size: 13px; color: var(--bm-text-muted); margin-bottom: 16px; line-height: 1.55;">
                        O PubMed permite exportar dados em diferentes formatos. Veja abaixo o que cada formato contém e escolha a melhor opção para a sua análise:
                    </p>
                    
                    <div style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                        {# Formato 1: MEDLINE/PubMed #}
                        <div style="padding: 16px; background: rgba(63,185,80,.03); border: 1px solid rgba(63,185,80,.18); border-radius: 12px;">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="fmt-badge" style="background: rgba(63,185,80,.12); color: #3fb950; border: 1px solid rgba(63,185,80,.3);">PubMed / MEDLINE</span>
                                    <code style="font-size: 11px; padding: 1px 5px; border-radius: 4px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); color: #c9d1d9;">.nbib</code>
                                    <code style="font-size: 11px; padding: 1px 5px; border-radius: 4px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); color: #c9d1d9;">.txt</code>
                                </div>
                                <span style="font-size: 11px; font-weight: 700; color: #3fb950; text-transform: uppercase; background: rgba(63,185,80,.15); padding: 2px 8px; border-radius: 5px; letter-spacing: .3px;">
                                    <i class="bi bi-star-fill me-1"></i>Recomendado
                                </span>
                            </div>
                            <div style="font-size: 13px; font-weight: 600; color: var(--bm-text); margin-bottom: 6px;">
                                Formato completo com tags estruturadas (ex: <code style="color:#4f8ef7">PMID-</code>, <code style="color:#4f8ef7">TI-</code>, <code style="color:#4f8ef7">AB-</code>)
                            </div>
                            <p style="font-size: 12.5px; color: var(--bm-text-muted); margin-bottom: 10px; line-height: 1.5;">
                                É o <strong>padrão ouro</strong> para importação. Contém tags explícitas e estruturadas para máquina. O BiblioMap lê com máxima precisão todos os campos bibliográficos e textuais.
                            </p>
                            <div style="display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11.5px;">
                                <span style="color: var(--bm-text-muted); font-weight: 600;">Metadados incluídos:</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Título</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Autores</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Resumo (Abstract)</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Revista e Ano</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>DOI e PMID</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Afiliações e Keywords (MeSH)</span>
                            </div>
                        </div>

                        {# Formato 2: CSV #}
                        <div style="padding: 16px; background: rgba(79,142,247,.03); border: 1px solid rgba(79,142,247,.18); border-radius: 12px;">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="fmt-badge" style="background: rgba(79,142,247,.12); color: #4f8ef7; border: 1px solid rgba(79,142,247,.3);">CSV (Planilha)</span>
                                    <code style="font-size: 11px; padding: 1px 5px; border-radius: 4px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); color: #c9d1d9;">.csv</code>
                                </div>
                                <span style="font-size: 11px; font-weight: 700; color: #4f8ef7; text-transform: uppercase; background: rgba(79,142,247,.15); padding: 2px 8px; border-radius: 5px; letter-spacing: .3px;">
                                    Suportado (Leve)
                                </span>
                            </div>
                            <div style="font-size: 13px; font-weight: 600; color: var(--bm-text); margin-bottom: 6px;">
                                Tabela contendo os metadados principais dos artigos
                            </div>
                            <p style="font-size: 12.5px; color: var(--bm-text-muted); margin-bottom: 10px; line-height: 1.5;">
                                Excelente para importações rápidas e análise de rede de coautoria ou periódicos. <strong>Atenção:</strong> a planilha CSV exportada pelo PubMed não inclui os textos de resumos (abstracts) nem palavras-chave de indexação (MeSH).
                            </p>
                            <div style="display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11.5px;">
                                <span style="color: var(--bm-text-muted); font-weight: 600;">Metadados incluídos:</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Título</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Autores</span>
                                <span style="color: #ea6050;"><i class="bi bi-x-circle-fill me-1"></i>Resumo (Abstract)</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Revista e Ano</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>DOI e PMID</span>
                                <span style="color: #ea6050;"><i class="bi bi-x-circle-fill me-1"></i>Afiliações e Keywords (MeSH)</span>
                            </div>
                        </div>

                        {# Formato 3: PMID List #}
                        <div style="padding: 16px; background: rgba(210,153,34,.03); border: 1px solid rgba(210,153,34,.18); border-radius: 12px;">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="fmt-badge" style="background: rgba(210,153,34,.12); color: #d29922; border: 1px solid rgba(210,153,34,.3);">PMID List (Lista de IDs)</span>
                                    <code style="font-size: 11px; padding: 1px 5px; border-radius: 4px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); color: #c9d1d9;">.txt</code>
                                </div>
                                <span style="font-size: 11px; font-weight: 700; color: #d29922; text-transform: uppercase; background: rgba(210,153,34,.15); padding: 2px 8px; border-radius: 5px; letter-spacing: .3px;">
                                    Inadequado para Importar
                                </span>
                            </div>
                            <div style="font-size: 13px; font-weight: 600; color: var(--bm-text); margin-bottom: 6px;">
                                Apenas números identificadores (ex: 34534279), sem metadados
                            </div>
                            <p style="font-size: 12.5px; color: var(--bm-text-muted); margin-bottom: 10px; line-height: 1.5;">
                                Contém apenas os IDs únicos do PubMed, um por linha. Não possui nenhum detalhe bibliográfico (sem título, ano, autores, etc.). Não deve ser importado diretamente no BiblioMap, pois o sistema precisa dos metadados para construir seus gráficos e análises.
                            </p>
                            <div style="display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11.5px;">
                                <span style="color: var(--bm-text-muted); font-weight: 600;">Metadados incluídos:</span>
                                <span style="color: #ea6050;"><i class="bi bi-x-circle-fill me-1"></i>Título</span>
                                <span style="color: #ea6050;"><i class="bi bi-x-circle-fill me-1"></i>Autores</span>
                                <span style="color: #ea6050;"><i class="bi bi-x-circle-fill me-1"></i>Resumo (Abstract)</span>
                                <span style="color: #ea6050;"><i class="bi bi-x-circle-fill me-1"></i>Revista e Ano</span>
                                <span style="color: #3fb950;"><i class="bi bi-check-circle-fill me-1"></i>Apenas PMID</span>
                            </div>
                        </div>

                        {# Formato 4: Summary & Abstract #}
                        <div style="padding: 16px; background: rgba(239,68,68,.03); border: 1px solid rgba(239,68,68,.18); border-radius: 12px;">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="fmt-badge" style="background: rgba(239,68,68,.12); color: #f87171; border: 1px solid rgba(239,68,68,.3);">Summary / Abstract (Texto Corrido)</span>
                                    <code style="font-size: 11px; padding: 1px 5px; border-radius: 4px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); color: #c9d1d9;">.txt</code>
                                </div>
                                <span style="font-size: 11px; font-weight: 700; color: #f87171; text-transform: uppercase; background: rgba(239,68,68,.15); padding: 2px 8px; border-radius: 5px; letter-spacing: .3px;">
                                    Não Suportado
                                </span>
                            </div>
                            <div style="font-size: 13px; font-weight: 600; color: var(--bm-text); margin-bottom: 6px;">
                                Citações formatadas para leitura humana direta, sem tags estruturadas
                            </div>
                            <p style="font-size: 12.5px; color: var(--bm-text-muted); margin-bottom: 10px; line-height: 1.5;">
                                Estes arquivos organizam o texto como blocos legíveis por pessoas (com numerações simples ou blocos de afiliação e resumo sem tags delimitadoras). Como não há tags para a máquina separar onde termina o autor e onde começa o título ou a revista, esses formatos não são suportados para importação.
                            </p>
                            <div style="display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11.5px;">
                                <span style="color: var(--bm-text-muted); font-weight: 600;">Metadados incluídos:</span>
                                <span style="color: #e3b341;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Apenas no texto corrido legível (impossível extrair de forma estruturada)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ════ OPENALEX ════ #}
            <div class="src-panel" id="panel-openalex">
                <div class="src-header">
                    <div class="src-logo-box">{{ source_logo('openalex', 36) }}</div>
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--bm-text)">OpenAlex</div>
                        <div style="font-size:12px;color:var(--bm-text-muted)">openalex.org &nbsp;·&nbsp; Formato aceito: <span class="fmt-badge fmt-csv">CSV</span></div>
                    </div>
                </div>
                <ol class="step-list">
                    <li><div class="step-num">1</div><div class="step-text"><strong>Pela interface web:</strong> acesse <a href="https://openalex.org/works" target="_blank" style="color:var(--bm-accent)">openalex.org/works</a> e faça sua busca.</div></li>
                    <li><div class="step-num">2</div><div class="step-text">Clique em <strong>"Export"</strong> (ícone de download no topo direito dos resultados) e selecione <strong>CSV</strong>.</div></li>
                    <li><div class="step-num">3</div><div class="step-text">O arquivo <code>.csv</code> será gerado e baixado automaticamente (limite: ~10.000 registros pela interface).</div></li>
                </ol>
                <div style="margin:16px 0 4px;font-size:12.5px;font-weight:700;color:var(--bm-text-muted);text-transform:uppercase;letter-spacing:.5px">Via API (para conjuntos maiores)</div>
                <ol class="step-list" style="margin-top:4px" start="4">
                    <li><div class="step-num">4</div><div class="step-text">
                        Use a API pública do OpenAlex com saída CSV:
                        <br><code>https://api.openalex.org/works?filter=title.search:machine+learning&amp;select=id,title,doi,publication_year,authorships,primary_location&amp;format=csv</code>
                    </div></li>
                    <li><div class="step-num">5</div><div class="step-text">Para paginar, adicione o parâmetro <code>&amp;cursor=*</code> (cursor-based pagination) e itere até obter todos os resultados.</div></li>
                </ol>
                <div class="step-note">
                    <i class="bi bi-info-circle" style="color:#d29922;flex-shrink:0;margin-top:2px"></i>
                    <span><strong style="color:#94a3b8">Open Access:</strong> o OpenAlex é gratuito e sem autenticação para a API pública. Para conjuntos muito grandes (&gt;1M), use o <a href="https://docs.openalex.org/download-all-data/openalex-snapshot" target="_blank" style="color:var(--bm-accent)">OpenAlex Snapshot</a> (download completo via AWS S3).</span>
                </div>
            </div>

            {# ════ CROSSREF ════ #}
            <div class="src-panel" id="panel-crossref">
                <div class="src-header">
                    <div class="src-logo-box">{{ source_logo('crossref', 36) }}</div>
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--bm-text)">Crossref</div>
                        <div style="font-size:12px;color:var(--bm-text-muted)">crossref.org &nbsp;·&nbsp; Formato aceito: <span class="fmt-badge fmt-csv">CSV</span> <span class="fmt-badge fmt-ris" style="margin-left:4px">RIS</span></div>
                    </div>
                </div>
                <div class="step-note step-note-warn" style="margin-bottom:16px">
                    <i class="bi bi-exclamation-triangle" style="color:#f87171;flex-shrink:0;margin-top:2px"></i>
                    <span><strong style="color:#94a3b8">Importante:</strong> o Crossref não possui uma interface de busca/export direta para usuários finais. Os dados são acessados principalmente via API REST. Veja as opções abaixo.</span>
                </div>
                <ol class="step-list">
                    <li><div class="step-num">1</div><div class="step-text">
                        <strong>Via API REST (recomendado):</strong><br>
                        <code>https://api.crossref.org/works?query=machine+learning&amp;rows=1000&amp;format=json</code><br>
                        <span style="font-size:12px;color:var(--bm-text-muted)">Converta o JSON para CSV com uma ferramenta como Python (pandas) antes de importar.</span>
                    </div></li>
                    <li><div class="step-num">2</div><div class="step-text">
                        <strong>Via Crossref Metadata Search:</strong> acesse <a href="https://search.crossref.org" target="_blank" style="color:var(--bm-accent)">search.crossref.org</a>, busque por título/autor/DOI e exporte os resultados como RIS ou BibTeX (botão "Export").</div></li>
                    <li><div class="step-num">3</div><div class="step-text">
                        <strong>Via Scopus ou WoS:</strong> a forma mais prática é exportar de Scopus ou WoS (que incluem DOIs do Crossref) e importar normalmente — o BiblioMap vincula os registros via DOI.
                    </div></li>
                    <li><div class="step-num">4</div><div class="step-text">
                        <strong>Via DOI Batch Lookup:</strong> envie uma lista de DOIs para <a href="https://doi.crossref.org/servlet/csv" target="_blank" style="color:var(--bm-accent)">doi.crossref.org/servlet/csv</a> para obter metadados em CSV.
                    </div></li>
                </ol>
            </div>

            {# ════ OUTRA BASE ════ #}
            <div class="src-panel" id="panel-other">
                <div class="src-header">
                    <div class="src-logo" style="background:#1e2d45;color:var(--bm-accent)">📄</div>
                    <div>
                        <div style="font-size:15px;font-weight:700;color:var(--bm-text)">Qualquer outra base</div>
                        <div style="font-size:12px;color:var(--bm-text-muted)">Formatos universais aceitos: <span class="fmt-badge fmt-ris">RIS</span> <span class="fmt-badge fmt-bib" style="margin-left:4px">BibTeX</span> <span class="fmt-badge fmt-xlsx" style="margin-left:4px">XLSX</span> <span class="fmt-badge fmt-xml" style="margin-left:4px">XML</span></div>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
                    {# RIS #}
                    <div style="padding:14px;background:rgba(79,142,247,.05);border:1px solid rgba(79,142,247,.15);border-radius:10px">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                            <span class="fmt-badge fmt-ris">.RIS</span>
                            <span style="font-size:12px;font-weight:600;color:var(--bm-text)">RIS / RefMan</span>
                        </div>
                        <p style="font-size:12.5px;color:var(--bm-text-muted);margin:0;line-height:1.55">Formato universal suportado por Zotero, Mendeley, EndNote, Embase, Cochrane, ERIC, PsycINFO e a maioria das bases acadêmicas. Procure "Export" → "RIS" ou "Reference Manager" na base que usa.</p>
                    </div>
                    {# BibTeX #}
                    <div style="padding:14px;background:rgba(168,85,247,.05);border:1px solid rgba(168,85,247,.15);border-radius:10px">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                            <span class="fmt-badge fmt-bib">.BIB</span>
                            <span style="font-size:12px;font-weight:600;color:var(--bm-text)">BibTeX / LaTeX</span>
                        </div>
                        <p style="font-size:12.5px;color:var(--bm-text-muted);margin:0;line-height:1.55">Comum em bases como Google Scholar, ACM Digital Library, IEEE Xplore, arXiv e Springer. Procure "Export" → "BibTeX" ou "Download citation" → ".bib".</p>
                    </div>
                    {# XLSX #}
                    <div style="padding:14px;background:rgba(16,185,129,.05);border:1px solid rgba(16,185,129,.15);border-radius:10px">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                            <span class="fmt-badge fmt-xlsx">.XLSX</span>
                            <span style="font-size:12px;font-weight:600;color:var(--bm-text)">Excel / Planilha</span>
                        </div>
                        <p style="font-size:12.5px;color:var(--bm-text-muted);margin:0;line-height:1.55">Planilhas Excel exportadas de bases customizadas. O BiblioMap detecta automaticamente colunas como Title, Authors, Year, DOI, Abstract, Source, etc.</p>
                    </div>
                    {# XML #}
                    <div style="padding:14px;background:rgba(244,114,182,.05);border:1px solid rgba(244,114,182,.15);border-radius:10px">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                            <span class="fmt-badge fmt-xml">.XML</span>
                            <span style="font-size:12px;font-weight:600;color:var(--bm-text)">PubMed XML / MEDLINE</span>
                        </div>
                        <p style="font-size:12.5px;color:var(--bm-text-muted);margin:0;line-height:1.55">Exportação XML estruturada do PubMed/MEDLINE, arXiv ou bases que seguem o padrão JATS. Indicado quando se quer o abstract e MeSH terms completos.</p>
                    </div>
                </div>

                <div class="step-note step-note-tip">
                    <i class="bi bi-lightbulb" style="color:#3fb950;flex-shrink:0;margin-top:2px"></i>
                    <span><strong style="color:#94a3b8">Não encontrou sua base?</strong> Se a base que você usa exporta em qualquer formato acima (RIS, BibTeX, CSV, XLSX, XML), o BiblioMap consegue importar. Caso tenha dúvidas, entre em contato com o administrador da plataforma informando o nome da base e o formato disponível.</span>
                </div>
            </div>

        </div>{# /bm-card help #}

    </div>{# /col-lg-8 #}

    <div class="col-12 col-lg-4">
        {# Quick reference sidebar #}
        <div class="bm-card mb-4">
            <h3 style="font-size:13px;font-weight:700;color:var(--bm-text);margin:0 0 16px;text-transform:uppercase;letter-spacing:.5px">
                <i class="bi bi-check2-circle text-accent me-2"></i>Formatos suportados
            </h3>
            {% for src_key, src in data_sources %}
                {% if src_key != 'generic' %}
                <div style="display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--bm-border)">
                    <span style="width:38px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">
                        {{ source_logo(src_key, 16) }}
                    </span>
                    <div style="flex:1;font-size:13px;font-weight:500;color:var(--bm-text)">{{ src.label }}</div>
