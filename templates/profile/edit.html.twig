{% extends 'base.html.twig' %}

{% block title %}Editar Perfil — BiblioMap{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Workspace</a>
    <span style="margin:0 8px;color:var(--bm-border)">/</span>
    <span class="current">Editar Perfil</span>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title"><i class="bi bi-person-gear me-2 text-accent"></i>Editar Perfil</h1>
    <p class="bm-page-subtitle">Gerencie suas informações cadastrais e credenciais de acesso</p>
</div>

<div class="row g-4">
    {# Left column: Avatar card & Info #}
    <div class="col-12 col-lg-4">
        <div class="bm-card text-center" style="position:relative;overflow:hidden">
            {# Visual abstract gradient accent #}
            <div style="position:absolute;top:0;left:0;right:0;height:70px;background:var(--bm-gradient);opacity:0.15"></div>
            
            <div style="position:relative;padding-top:20px;margin-bottom:16px">
                <div class="mx-auto" style="width:90px;height:90px;background:var(--bm-gradient);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:700;color:white;box-shadow:0 8px 24px rgba(79,142,247,0.25)">
                    {{ user.name|first|upper }}
                </div>
            </div>
            
            <h3 style="font-size:18px;font-weight:700;color:var(--bm-text);margin:0 0 4px">{{ user.name }}</h3>
            <p style="font-size:13px;color:var(--bm-text-muted);margin:0 0 16px">{{ user.email }}</p>
            
            <div style="display:flex;flex-direction:column;gap:8px;padding:16px 0;border-top:1px solid var(--bm-border);border-bottom:1px solid var(--bm-border);margin:16px 0">
                <div class="d-flex justify-content-between font-size-13" style="font-size:13px">
                    <span style="color:var(--bm-text-muted)">Tipo de Conta:</span>
                    <span style="font-weight:600;color:var(--bm-accent)">
                        {% if is_granted('ROLE_ADMIN') %}
                            Administrador
                        {% else %}
                            Pesquisador
                        {% endif %}
                    </span>
                </div>
                <div class="d-flex justify-content-between font-size-13" style="font-size:13px">
                    <span style="color:var(--bm-text-muted)">Membro desde:</span>
                    <span style="font-weight:600;color:var(--bm-text)">{{ user.createdAt|date('d/m/Y') }}</span>
                </div>
                {% if user.institution %}
                <div class="d-flex justify-content-between font-size-13" style="font-size:13px">
                    <span style="color:var(--bm-text-muted)">Instituição:</span>
                    <span style="font-weight:600;color:var(--bm-text);text-align:right">{{ user.institution }}</span>
                </div>
                {% endif %}
                {% if user.country %}
                <div class="d-flex justify-content-between font-size-13" style="font-size:13px">
                    <span style="color:var(--bm-text-muted)">País:</span>
                    <span style="font-weight:600;color:var(--bm-text)">{{ user.country }}</span>
                </div>
                {% endif %}
            </div>

            <div style="font-size:12.5px;color:var(--bm-text-muted);line-height:1.6">
                <i class="bi bi-shield-lock me-1 text-accent"></i> Suas informações de login e credenciais são protegidas com algoritmos de hashing modernos (Argon2id/Bcrypt).
            </div>
        </div>
    </div>

    {# Right column: Form #}
    <div class="col-12 col-lg-8">
        <div class="bm-card">
            <h3 style="font-size:16px;font-weight:700;color:var(--bm-text);margin:0 0 20px;display:flex;align-items:center;gap:8px">
                <i class="bi bi-person-fill text-accent"></i> Informações Cadastrais
            </h3>
            
            <form method="post" id="profile-form">
                <div class="row g-3">
                    {# Name #}
                    <div class="col-12 col-md-6">
                        <label for="inputName" class="form-label">Nome Completo <span style="color:var(--bm-danger)">*</span></label>
                        <input type="text" id="inputName" name="name" class="form-control" value="{{ user.name }}" required>
                    </div>

                    {# Email #}
                    <div class="col-12 col-md-6">
                        <label for="inputEmail" class="form-label">E-mail de Acesso <span style="color:var(--bm-danger)">*</span></label>
                        <input type="email" id="inputEmail" name="email" class="form-control" value="{{ user.email }}" required>
                    </div>

                    {# Institution #}
                    <div class="col-12 col-md-6">
                        <label for="inputInstitution" class="form-label">Instituição de Vínculo</label>
                        <input type="text" id="inputInstitution" name="institution" class="form-control" placeholder="Universidade, Organização..." value="{{ user.institution }}">
                    </div>

                    {# Country #}
                    <div class="col-12 col-md-6">
                        <label for="inputCountry" class="form-label">País</label>
                        <input type="text" id="inputCountry" name="country" class="form-control" placeholder="Brasil, Portugal..." value="{{ user.country }}">
                    </div>
                </div>

                <div style="margin:28px 0 20px;padding-top:20px;border-top:1px solid var(--bm-border)">
                    <h3 style="font-size:16px;font-weight:700;color:var(--bm-text);margin:0 0 8px;display:flex;align-items:center;gap:8px">
                        <i class="bi bi-key-fill text-accent"></i> Segurança e Senha
                    </h3>
                    <p style="font-size:12.5px;color:var(--bm-text-muted);margin:0 0 16px">
                        Preencha os campos abaixo apenas se desejar <strong>trocar a sua senha</strong> de acesso.
                    </p>
                </div>

                <div class="row g-3">
                    {# New Password #}
                    <div class="col-12 col-md-6">
                        <label for="inputPassword" class="form-label">Nova Senha</label>
                        <input type="password" id="inputPassword" name="plainPassword" class="form-control" placeholder="Mínimo de 6 caracteres">
                        <div style="font-size:11px;color:var(--bm-text-muted);margin-top:4px">
                            <i class="bi bi-info-circle me-1"></i> Deixe em branco se não desejar alterar a senha.
                        </div>
                    </div>

                    {# Confirm New Password #}
                    <div class="col-12 col-md-6">
                        <label for="inputConfirmPassword" class="form-label">Confirmar Nova Senha</label>
                        <input type="password" id="inputConfirmPassword" name="confirmPassword" class="form-control" placeholder="Repita a nova senha">
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3" style="border-top:1px solid var(--bm-border)">
                    <button type="submit" class="btn-bm-primary">
                        <i class="bi bi-check-circle me-1"></i>Salvar alterações
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
