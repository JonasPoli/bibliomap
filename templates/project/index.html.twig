{% extends 'base.html.twig' %}

{% block title %}Meus Projetos{% endblock %}

{% block breadcrumb %}
    <span class="current"><i class="bi bi-folder2-open me-1"></i>Meus Projetos</span>
{% endblock %}

{% block topbar_actions %}
    <a href="{{ path('app_projects_new') }}" class="btn-bm-primary">
        <i class="bi bi-plus-lg me-1"></i>Novo Projeto
    </a>
{% endblock %}

{% block body %}
<div class="bm-page-header">
    <h1 class="bm-page-title">Meus Projetos</h1>
    <p class="bm-page-subtitle">Gerencie suas análises bibliométricas</p>
</div>

{% if projects is empty %}
    {# Empty state #}
    <div style="text-align:center;padding:80px 20px">
        <div style="font-size:64px;margin-bottom:20px">📂</div>
        <h2 style="font-size:20px;font-weight:600;color:var(--bm-text);margin:0 0 8px">Nenhum projeto ainda</h2>
        <p style="color:var(--bm-text-muted);font-size:14px;margin:0 0 28px;max-width:380px;margin-left:auto;margin-right:auto">
            Crie seu primeiro projeto para começar a importar bases bibliográficas e gerar análises.
        </p>
        <a href="{{ path('app_projects_new') }}" class="btn-bm-primary" style="display:inline-flex;align-items:center;gap:8px">
            <i class="bi bi-plus-lg"></i>Criar primeiro projeto
        </a>
    </div>
{% else %}
    <div class="row g-3">
        {% for project in projects %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="bm-card" style="cursor:pointer;position:relative;overflow:hidden"
                     onclick="window.location='{{ path('app_projects_show', {id: project.id}) }}'">

                    {# Accent line top #}
                    <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#4f8ef7,#a855f7)"></div>

                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <span class="badge text-bg-{{ project.statusColor }} badge-status">
                            {{ project.statusLabel }}
                        </span>
                        <span style="font-size:12px;color:var(--bm-text-muted)">
                            {{ project.updatedAt|date('d/m/Y') }}
                        </span>
                    </div>

                    <h3 style="font-size:15px;font-weight:600;color:var(--bm-text);margin:0 0 6px;line-height:1.4">
                        {{ project.title }}
                    </h3>

                    {% if project.description %}
                        <p style="font-size:13px;color:var(--bm-text-muted);margin:0 0 16px;line-height:1.5">
                            {{ project.description|length > 100 ? project.description|slice(0,100) ~ '…' : project.description }}
                        </p>
                    {% else %}
                        <p style="font-size:13px;color:var(--bm-text-muted);margin:0 0 16px;font-style:italic">Sem descrição</p>
                    {% endif %}

                    <div class="d-flex align-items-center gap-3" style="font-size:12px;color:var(--bm-text-muted)">
                        {% if project.databaseSources %}
                            <span><i class="bi bi-database me-1"></i>{{ project.databaseSources|length }} base{{ project.databaseSources|length > 1 ? 's' : '' }}</span>
                        {% endif %}
                        {% set docCount = project_documents_count(project.id) %}
                        {% if docCount > 0 %}
                            <span><i class="bi bi-file-earmark-text me-1"></i>{{ docCount|number_format(0, ',', '.') }} doc{{ docCount > 1 ? 's' : '' }}</span>
                        {% endif %}
                        {% if project.startYear and project.endYear %}
                            <span><i class="bi bi-calendar-range me-1"></i>{{ project.startYear }}–{{ project.endYear }}</span>
                        {% endif %}
                        {% if project.datasets|length > 0 %}
                            <span><i class="bi bi-upload me-1"></i>{{ project.datasets|length }} arquivo{{ project.datasets|length > 1 ? 's' : '' }}</span>
                        {% endif %}
                        {% if project.isPublic %}
                            <span class="ms-auto"><i class="bi bi-globe2"></i></span>
                        {% endif %}
                    </div>

                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
