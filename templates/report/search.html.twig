{% extends 'base.html.twig' %}

{% block title %}Busca de Trabalhos — {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Projetos</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_projects_show', {id: project.id}) }}" style="color:var(--bm-text-muted);text-decoration:none">{{ project.title|slice(0,30) }}</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <span class="current">Busca de Trabalhos</span>
{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-search me-2" style="color:var(--bm-accent)"></i>
        Busca Avançada de Trabalhos
    </h1>
    <p class="bm-page-subtitle">Encontre artigos específicos filtrando por múltiplos campos simultaneamente.</p>
</div>

<!-- Search Form Card -->
<div class="bm-card mb-4">
    <h5 class="card-title mb-3" style="font-weight:700">Filtros de Pesquisa</h5>
    <form method="get" action="{{ path('app_report_documents_search', {id: project.id}) }}">
        <div class="row g-3">
            <!-- Author filter -->
            <div class="col-md-2">
                <label class="form-label" style="font-size:12.5px;font-weight:600;color:var(--bm-text-muted)">Nome do Autor</label>
                <input type="text" name="author" value="{{ filters.author }}" class="form-control form-control-sm" placeholder="Ex: Wolfert">
            </div>
            
            <!-- Keyword filter -->
            <div class="col-md-2">
                <label class="form-label" style="font-size:12.5px;font-weight:600;color:var(--bm-text-muted)">Palavra-Chave</label>
                <input type="text" name="keyword" value="{{ filters.keyword }}" class="form-control form-control-sm" placeholder="Ex: Smart Farming">
            </div>
            
            <!-- Title filter -->
            <div class="col-md-3">
                <label class="form-label" style="font-size:12.5px;font-weight:600;color:var(--bm-text-muted)">Título do Artigo</label>
                <input type="text" name="title" value="{{ filters.title }}" class="form-control form-control-sm" placeholder="Parte do título...">
            </div>

            <!-- Abstract filter -->
            <div class="col-md-3">
                <label class="form-label" style="font-size:12.5px;font-weight:600;color:var(--bm-text-muted)">Texto do Resumo</label>
                <input type="text" name="abstract" value="{{ filters.abstract }}" class="form-control form-control-sm" placeholder="Termo no resumo...">
            </div>

            <!-- Year filter -->
            <div class="col-md-2">
                <label class="form-label" style="font-size:12.5px;font-weight:600;color:var(--bm-text-muted)">Ano</label>
                <input type="number" name="year" value="{{ filters.year }}" class="form-control form-control-sm" placeholder="Ex: 2021" min="1900" max="2100">
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            {% if hasSearch %}
                <a href="{{ path('app_report_documents_search', {id: project.id}) }}" class="btn btn-sm btn-bm-secondary px-3" style="text-decoration:none;padding:6px 16px;font-weight:600">
                    Limpar Filtros
                </a>
            {% endif %}
            <button type="submit" class="btn btn-sm btn-bm-primary px-4" style="background:var(--bm-accent);border:none;font-weight:600;padding:6px 20px">
                <i class="bi bi-search me-1"></i> Pesquisar
            </button>
        </div>
    </form>
</div>

<!-- Results Card -->
{% if hasSearch %}
<div class="bm-card">
    <h5 class="card-title mb-3" style="font-weight:700">
        Trabalhos Encontrados 
        <span class="badge rounded-pill ms-1" style="font-size:11.5px;background:rgba(240,136,62,0.15);color:var(--bm-accent)">{{ list|length }}</span>
    </h5>
    
    {% if list is empty %}
        <div class="alert alert-warning text-center border-0 py-5 mb-0" style="background:rgba(235,178,72,0.1);color:#ebb248;font-size:13px;border-radius:8px">
            <i class="bi bi-exclamation-triangle d-block fs-3 mb-2"></i>
            Nenhum trabalho catalogado atendeu a todos os critérios de busca fornecidos.
        </div>
    {% else %}
        <p class="text-muted mb-3" style="font-size:12.5px">
            Dica: Clique nas colunas da tabela para reordenar a listagem. Você pode copiar a primeira coluna para usar como nome do arquivo.
        </p>
        <div class="table-responsive">
            <table class="table table-hover align-middle border-bm mb-0" id="search-table" style="font-size:13px">
                <thead class="sticky-top bg-bm-card border-bottom border-bm">
                    <tr>
                        <th style="color:var(--bm-text-muted);font-weight:600;user-select:none">#</th>
                        <th style="color:var(--bm-text-muted);font-weight:600;cursor:pointer;user-select:none;min-width:350px" onclick="sortSearchTable(1, 'string')">
                            Autores - Ano - Nome do Trabalho (copiar para nome de arquivo) <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                        </th>
                        <th style="color:var(--bm-text-muted);font-weight:600;text-align:center;cursor:pointer;user-select:none" onclick="sortSearchTable(2, 'number')">
                            Ano <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                        </th>
                        <th style="color:var(--bm-text-muted);font-weight:600;text-align:center;cursor:pointer;user-select:none" onclick="sortSearchTable(3, 'number')">
                            Citações <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                        </th>
                        <th style="color:var(--bm-text-muted);font-weight:600;cursor:pointer;user-select:none" onclick="sortSearchTable(4, 'string')">
                            Tipo <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                        </th>
                        <th style="color:var(--bm-text-muted);font-weight:600;cursor:pointer;user-select:none" onclick="sortSearchTable(5, 'string')">
                            Veículo / Fonte <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                        </th>
                        <th style="color:var(--bm-text-muted);font-weight:600;text-align:center;cursor:pointer;user-select:none" onclick="sortSearchTable(6, 'string')">
                            Qualis <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                        </th>
                        <th style="color:var(--bm-text-muted);font-weight:600;text-align:center;user-select:none">Link</th>
                    </tr>
                </thead>
                <tbody class="border-0">
                    {% for doc in list %}
                    <tr class="doc-row">
                        <td style="color:var(--bm-text-muted);font-size:11px">{{ loop.index }}</td>
                        <td style="font-weight:600;color:var(--bm-text)">
                            {{ doc.authors_str }} - {{ doc.year }} - {{ doc.title|replace({':': '', '/': ''}) }}
                            <button type="button" class="btn btn-sm btn-link p-0 text-muted ms-1" 
                                    style="vertical-align: middle; text-decoration: none;"
                                    onclick="copyReducedTitle(this, '{{ doc.authors_str|escape('js') }}', '{{ doc.year|escape('js') }}', '{{ doc.title|escape('js') }}')" 
                                    title="Copiar nome reduzido (máx 250 caracteres)">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </td>
                        <td style="text-align:center">{{ doc.year }}</td>
                        <td style="text-align:center;font-weight:700" class="text-accent">{{ doc.cited_by }}</td>
                        <td style="color:var(--bm-text-muted)">{{ doc.document_type|default('—') }}</td>
                        <td style="color:var(--bm-text-muted)">{{ doc.source_title|default('—') }}</td>
                        <td style="text-align:center">
                            {% if doc.qualis %}
                                {% set qColor = '#8b949e' %}
                                {% set qBg = 'rgba(255,255,255,0.05)' %}
                                {% if doc.qualis in ['A1', 'A2'] %}
                                    {% set qColor = '#2ea043' %}
                                    {% set qBg = 'rgba(56,139,60,0.15)' %}
                                    {% elseif doc.qualis in ['A3', 'A4'] %}
                                    {% set qColor = '#58a6ff' %}
                                    {% set qBg = 'rgba(56,139,253,0.15)' %}
                                    {% elseif doc.qualis in ['B1', 'B2'] %}
                                    {% set qColor = '#d29922' %}
                                    {% set qBg = 'rgba(187,128,9,0.15)' %}
                                    {% elseif doc.qualis in ['B3', 'B4'] %}
                                    {% set qColor = '#db6d28' %}
                                    {% set qBg = 'rgba(219,109,40,0.15)' %}
                                    {% elseif doc.qualis == 'C' %}
                                    {% set qColor = '#f85149' %}
                                    {% set qBg = 'rgba(248,81,73,0.15)' %}
                                {% endif %}
                                <span class="badge rounded-pill" style="background:{{ qBg }};color:{{ qColor }};font-size:10px;font-weight:700">{{ doc.qualis }}</span>
                            {% else %}
                                <span class="text-muted" style="font-size:11px">—</span>
                            {% endif %}
                        </td>
                        <td style="text-align:center; white-space:nowrap">
                            {% set has_link = false %}
                            {% if doc.doi %}
                                <a href="https://doi.org/{{ doc.doi }}" target="_blank" style="color:var(--bm-accent);text-decoration:none;font-weight:600">
                                    <i class="bi bi-box-arrow-up-right"></i> DOI
                                </a>
                                <a href="https://sci-hub.box/{{ doc.doi }}" target="_blank" style="color:var(--bm-accent);text-decoration:none;font-weight:600;margin-left:8px" title="Sci-Hub">
                                    <i class="bi bi-key"></i> Sci-Hub
                                </a>
                                {% set has_link = true %}
                            {% elseif doc.url %}
                                <a href="{{ doc.url }}" target="_blank" style="color:var(--bm-accent);text-decoration:none;font-weight:600">
                                    <i class="bi bi-box-arrow-up-right"></i> URL
                                </a>
                                {% set has_link = true %}
                            {% endif %}

                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2{{ has_link ? ' ms-2' : '' }}" 
                                    onclick="showBibtexByIndex({{ loop.index0 }})"
                                    style="font-size:11.5px;border-radius:4px">
                                <i class="bi bi-journal-code"></i> BibTeX
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endif %}

<!-- Modal BibTeX -->
<div class="modal fade" id="bibtexModal" tabindex="-1" aria-labelledby="bibtexModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-bm-card border-bm text-bm" style="background:var(--bm-card-bg); border:1px solid var(--bm-border); border-radius:12px;">
            <div class="modal-header border-bottom border-bm py-3 border-0 pb-0">
                <h5 class="modal-title" id="bibtexModalLabel" style="font-weight:700; color:var(--bm-text)">
                    <i class="bi bi-code-slash me-2 text-accent"></i>
                    Referência BibTeX para Zotero
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="filter:invert(var(--bm-close-invert, 1))"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted" style="font-size:13px">
                    Copie o código BibTeX abaixo e cole no Zotero (usando a opção <em>"Importar do Clipboard / Área de Transferência"</em>).
                </p>
                <div style="position:relative">
                    <pre id="bibtexCode" class="p-3" style="background:var(--bm-bg);border:1px solid var(--bm-border);border-radius:8px;font-family:monospace;font-size:12.5px;color:var(--bm-text);white-space:pre-wrap;max-height:350px;overflow-y:auto;text-align:left"></pre>
                    <button type="button" class="btn btn-sm btn-bm-primary" onclick="copyBibtexToClipboard()" style="position:absolute;top:10px;right:10px;background:var(--bm-accent);border:none;font-weight:600;padding:4px 12px;font-size:12px">
                        <i class="bi bi-clipboard me-1"></i> Copiar
                    </button>
                </div>
                <div id="copySuccessAlert" class="text-success mt-2" style="font-size:12px;display:none;font-weight:600">
                    <i class="bi bi-check-circle-fill me-1"></i> Copiado com sucesso para a área de transferência!
                </div>
            </div>
            <div class="modal-footer border-top border-bm py-3 border-0 pt-0">
                <button type="button" class="btn btn-sm btn-bm-secondary px-4" data-bs-dismiss="modal" style="font-size:13px;font-weight:600">Fechar</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
let currentSortColumn = -1;
let sortAscending = true;

function sortSearchTable(columnIndex, type) {
    const table = document.getElementById('search-table');
    if (!table) return;
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('.doc-row'));
    if (rows.length === 0) return;
    
    if (currentSortColumn === columnIndex) {
        sortAscending = !sortAscending;
    } else {
        currentSortColumn = columnIndex;
        sortAscending = true;
    }

    // Update header icons
    const headers = table.querySelectorAll('thead th');
    headers.forEach((th, idx) => {
        const icon = th.querySelector('.sort-icon');
        if (icon) {
            if (idx === columnIndex) {
                icon.className = sortAscending ? 'bi bi-caret-up-fill sort-icon ms-1' : 'bi bi-caret-down-fill sort-icon ms-1';
                icon.style.color = 'var(--bm-accent)';
                icon.style.opacity = '1';
            } else {
                icon.className = 'bi bi-arrow-down-up sort-icon ms-1';
                icon.style.color = 'var(--bm-text-muted)';
                icon.style.opacity = '0.3';
            }
        }
    });

    // Sort rows
    rows.sort((rowA, rowB) => {
        const cellA = rowA.cells[columnIndex].textContent.trim();
        const cellB = rowB.cells[columnIndex].textContent.trim();

        if (type === 'number') {
            const numA = parseFloat(cellA.replace(/[^\d.-]/g, '')) || 0;
            const numB = parseFloat(cellB.replace(/[^\d.-]/g, '')) || 0;
            return sortAscending ? numA - numB : numB - numA;
        } else {
            return sortAscending 
                ? cellA.localeCompare(cellB, 'pt-BR', { sensitivity: 'base' })
                : cellB.localeCompare(cellA, 'pt-BR', { sensitivity: 'base' });
        }
    });

    tbody.innerHTML = '';
    rows.forEach((row, index) => {
        row.cells[0].textContent = index + 1;
        tbody.appendChild(row);
    });
}

let currentBibtexText = '';

function showBibtex(doc, authorsStr) {
    let firstAuthor = 'Unknown';
    if (authorsStr && authorsStr !== 'Autor desconhecido') {
        const parts = authorsStr.split(';');
        if (parts.length > 0) {
            const first = parts[0].trim();
            const commaIndex = first.indexOf(',');
            if (commaIndex !== -1) {
                firstAuthor = first.substring(0, commaIndex).trim().replace(/[^a-zA-Z]/g, '');
            } else {
                firstAuthor = first.replace(/[^a-zA-Z]/g, '');
            }
        }
    }
    const year = doc.year || '0000';
    const citeKey = `${firstAuthor.toLowerCase()}${year}`;
    
    let bib = `@article{${citeKey},\n`;
    bib += `  author = {${authorsStr.replace(/;/g, ' and')}},\n`;
    bib += `  title = {${doc.title || 'Sem título'}},\n`;
    if (doc.source_title) {
        bib += `  journal = {${doc.source_title}},\n`;
    }
    bib += `  year = {${year}},\n`;
    if (doc.volume) {
        bib += `  volume = {${doc.volume}},\n`;
    }
    if (doc.issue) {
        bib += `  number = {${doc.issue}},\n`;
    }
    if (doc.page_start || doc.page_end) {
        const start = doc.page_start || '';
        const end = doc.page_end || '';
        bib += `  pages = {${start}${start && end ? '--' : ''}${end}},\n`;
    }
    if (doc.doi) {
        bib += `  doi = {${doc.doi}},\n`;
    }
    if (doc.url) {
        bib += `  url = {${doc.url}},\n`;
    }
    if (doc.publisher) {
        bib += `  publisher = {${doc.publisher}},\n`;
    }
    if (doc.issn) {
        bib += `  issn = {${doc.issn}},\n`;
    }
    if (doc.isbn) {
        bib += `  isbn = {${doc.isbn}},\n`;
    }
    if (doc.abstract_text) {
        bib += `  abstract = {${doc.abstract_text}},\n`;
    }
    bib += `}`;
    
    currentBibtexText = bib;
    document.getElementById('bibtexCode').textContent = bib;
    document.getElementById('copySuccessAlert').style.display = 'none';
    
    const modal = new bootstrap.Modal(document.getElementById('bibtexModal'));
    modal.show();
}

function copyBibtexToClipboard() {
    navigator.clipboard.writeText(currentBibtexText).then(() => {
        const alert = document.getElementById('copySuccessAlert');
        alert.style.display = 'block';
        setTimeout(() => {
            alert.style.display = 'none';
        }, 3000);
    });
}

const searchDocumentsList = {{ list|json_encode|raw }};

function showBibtexByIndex(index) {
    const doc = searchDocumentsList[index];
    if (!doc) return;
    showBibtex(doc, doc.authors_str);
}

function copyReducedTitle(btn, authors, year, title) {
    const cleanTitle = (title || '').replace(/[:\/]/g, '');
    const cleanYear = String(year || '—');
    const cleanAuthors = String(authors || 'Autor desconhecido');
    const maxAuthorsLen = 250 - 6 - cleanYear.length - cleanTitle.length;
    let reducedAuthors = cleanAuthors;
    if (cleanAuthors.length > maxAuthorsLen) {
        reducedAuthors = cleanAuthors.slice(0, Math.max(0, maxAuthorsLen));
    }
    const textToCopy = `${reducedAuthors} - ${cleanYear} - ${cleanTitle}`;
    
    navigator.clipboard.writeText(textToCopy).then(() => {
        const icon = btn.querySelector('i');
        if (icon) {
            icon.className = 'bi bi-check2 text-success';
            setTimeout(() => {
                icon.className = 'bi bi-clipboard';
            }, 1500);
        }
    }).catch(err => {
        console.error('Failed to copy: ', err);
    });
}
</script>
{% endblock %}
