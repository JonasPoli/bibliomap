{% extends 'base.html.twig' %}

{% block title %}Análise de Palavras-Chave — {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Projetos</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_projects_show', {id: project.id}) }}" style="color:var(--bm-text-muted);text-decoration:none">{{ project.title|slice(0,30) }}</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <span class="current">Palavras-chave</span>
{% endblock %}

{% block topbar_actions %}
<button class="btn-bm-primary" onclick="exportCSV()" style="padding:6px 14px;font-size:13px">
    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
</button>
{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-tags me-2" style="color:var(--bm-accent)"></i>
        Análise de Palavras-Chave
    </h1>
    <p class="bm-page-subtitle">Principais termos, ocorrências, nuvem de palavras e segmentação por origem (Autor vs Indexada)</p>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-3">

    <!-- Total de Termos Únicos -->
    <div class="col-md-4">
        <div class="bm-stat-card" style="height:100%">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                <div>
                    <div class="bm-stat-value">{{ kpis.total_keywords|number_format(0, ',', '.') }}</div>
                    <div class="bm-stat-label">Total de Termos Únicos</div>
                </div>
                <div style="width:38px;height:38px;border-radius:9px;background:rgba(79,142,247,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:4px">
                    <i class="bi bi-tags-fill" style="font-size:16px;color:var(--bm-accent)"></i>
                </div>
            </div>
            <div style="padding-top:10px;border-top:1px solid var(--bm-border);font-size:11.5px;color:var(--bm-text-muted);line-height:1.5">
                Soma de <em>todos</em> os termos distintos — tanto os definidos pelos autores quanto os atribuídos pelo indexador da base de dados.
            </div>
        </div>
    </div>

    <!-- Palavras-Chave de Autores -->
    <div class="col-md-4">
        <div class="bm-stat-card" style="height:100%">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                <div>
                    <div class="bm-stat-value" style="color:var(--bm-accent)">{{ kpis.author_keywords|number_format(0, ',', '.') }}</div>
                    <div class="bm-stat-label">Palavras-Chave de Autores</div>
                </div>
                <div style="width:38px;height:38px;border-radius:9px;background:rgba(79,142,247,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:4px">
                    <i class="bi bi-person-badge-fill" style="font-size:16px;color:var(--bm-accent)"></i>
                </div>
            </div>
            <div style="padding-top:10px;border-top:1px solid var(--bm-border);font-size:11.5px;color:var(--bm-text-muted);line-height:1.5">
                Termos escolhidos <strong style="color:var(--bm-text)">pelo próprio autor</strong> ao submeter o artigo.
                Refletem a percepção do pesquisador sobre seu trabalho (<code style="font-size:10px">Author Keywords</code> no Scopus).
            </div>
        </div>
    </div>

    <!-- Palavras-Chave Indexadas -->
    <div class="col-md-4">
        <div class="bm-stat-card" style="height:100%">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                <div>
                    <div class="bm-stat-value" style="color:#a855f7">{{ kpis.indexed_keywords|number_format(0, ',', '.') }}</div>
                    <div class="bm-stat-label">Palavras-Chave Indexadas</div>
                </div>
                <div style="width:38px;height:38px;border-radius:9px;background:rgba(168,85,247,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:4px">
                    <i class="bi bi-database-fill-gear" style="font-size:16px;color:#a855f7"></i>
                </div>
            </div>
            <div style="padding-top:10px;border-top:1px solid var(--bm-border);font-size:11.5px;color:var(--bm-text-muted);line-height:1.5">
                Termos atribuídos <strong style="color:var(--bm-text)">pela base de dados</strong> (Scopus, WoS etc.) a partir de vocabulários controlados como o <em>INSPEC Thesaurus</em>.
            </div>
        </div>
    </div>
</div>

<!-- Collapsible Explanation Box -->
<div style="margin-bottom:20px">
    <button onclick="toggleKwInfo()" id="btn-kw-info"
        style="background:none;border:none;padding:0;font-size:12px;color:var(--bm-accent);cursor:pointer;display:flex;align-items:center;gap:5px;font-weight:600">
        <i class="bi bi-info-circle"></i> Entender a diferença entre os tipos de palavras-chave
        <i class="bi bi-chevron-down" id="kw-info-chevron" style="font-size:10px;transition:transform 0.2s"></i>
    </button>
    <div id="kw-info-box" style="display:none;margin-top:10px">
        <div class="bm-card" style="border-color:rgba(79,142,247,0.25);background:rgba(79,142,247,0.03)">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <div style="width:40px;height:40px;border-radius:9px;background:rgba(79,142,247,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-person-badge-fill" style="font-size:18px;color:var(--bm-accent)"></i>
                        </div>
                        <div>
                            <div style="font-weight:700;font-size:13.5px;color:var(--bm-text);margin-bottom:5px">
                                Palavras-chave de Autores
                                <span class="badge ms-1" style="font-size:9.5px;background:rgba(79,142,247,0.15);color:var(--bm-accent);vertical-align:middle">Author Keywords</span>
                            </div>
                            <p style="font-size:12.5px;color:var(--bm-text-muted);line-height:1.6;margin:0 0 8px">
                                São os termos que <strong style="color:var(--bm-text)">o próprio pesquisador escolheu</strong> para descrever seu trabalho ao submetê-lo para publicação. No Scopus correspondem ao campo <em>"Author Keywords"</em>.
                            </p>
                            <div style="padding:8px 10px;background:var(--bm-bg);border-radius:6px;border:1px solid var(--bm-border)">
                                <div style="font-size:10px;font-weight:700;color:var(--bm-accent);margin-bottom:3px">💡 Quando usar</div>
                                <div style="font-size:12px;color:var(--bm-text-muted)">
                                    Ideal para análises de co-ocorrência, mapas temáticos e identificar tendências de pesquisa <em>na perspectiva dos próprios autores</em>. Revelam <strong>fronteiras emergentes</strong> do campo.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <div style="width:40px;height:40px;border-radius:9px;background:rgba(168,85,247,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-database-fill-gear" style="font-size:18px;color:#a855f7"></i>
                        </div>
                        <div>
                            <div style="font-weight:700;font-size:13.5px;color:var(--bm-text);margin-bottom:5px">
                                Palavras-chave Indexadas
                                <span class="badge ms-1" style="font-size:9.5px;background:rgba(168,85,247,0.15);color:#a855f7;vertical-align:middle">Index Keywords</span>
                            </div>
                            <p style="font-size:12.5px;color:var(--bm-text-muted);line-height:1.6;margin:0 0 8px">
                                São termos atribuídos <strong style="color:var(--bm-text)">pela própria base de dados</strong> (Scopus, Web of Science, PubMed) a partir de vocabulários controlados como <em>INSPEC Thesaurus</em> ou <em>MeSH</em>. O autor não os define.
                            </p>
                            <div style="padding:8px 10px;background:var(--bm-bg);border-radius:6px;border:1px solid var(--bm-border)">
                                <div style="font-size:10px;font-weight:700;color:#a855f7;margin-bottom:3px">💡 Quando usar</div>
                                <div style="font-size:12px;color:var(--bm-text-muted)">
                                    Ideal para comparações entre bases e para mapear <em>vocabulário padronizado</em> do campo. Revelam a <strong>estrutura conceitual consolidada</strong>.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div style="margin-top:14px;padding:10px 14px;border-radius:8px;background:rgba(63,185,80,0.07);border:1px solid rgba(63,185,80,0.2);font-size:12px;color:var(--bm-text-muted)">
                <i class="bi bi-lightbulb-fill me-1" style="color:var(--bm-success)"></i>
                <strong style="color:var(--bm-success)">Dica bibliométrica:</strong>
                Comparar palavras-chave de autores com as indexadas pode revelar onde o campo está evoluindo —
                termos frequentes nos autores mas ausentes no indexador indicam conceitos <em>novos ainda não padronizados</em>.
            </div>
        </div>
    </div>
</div>


<!-- View toggle -->
<div class="d-flex align-items-center gap-2 mb-3">
    <span style="font-size:13px;color:var(--bm-text-muted);font-weight:500">Visualização:</span>
    <button class="btn btn-sm" id="btn-barchart" onclick="showView('barchart')"
        style="font-size:12px;border-radius:6px;border:1px solid var(--bm-accent);color:var(--bm-accent);background:rgba(79,142,247,0.1)">
        <i class="bi bi-bar-chart me-1"></i> Gráfico de Barras
    </button>
    <button class="btn btn-sm" id="btn-wordcloud" onclick="showView('wordcloud')"
        style="font-size:12px;border-radius:6px;border:1px solid var(--bm-border);color:var(--bm-text-muted);background:transparent">
        <i class="bi bi-cloud me-1"></i> Nuvem de Palavras
    </button>
    <button class="btn btn-sm" id="btn-treemap" onclick="showView('treemap')"
        style="font-size:12px;border-radius:6px;border:1px solid var(--bm-border);color:var(--bm-text-muted);background:transparent">
        <i class="bi bi-grid-3x3-gap me-1"></i> Mapa de Árvore (Treemap)
    </button>
</div>

<div class="row g-4 mb-4">
    <!-- Coluna 1: Graficos por Origem -->
    <div class="col-xl-6">
        <div class="bm-card h-100">
            <!-- Bar chart segmented -->
            <div id="segmented-barchart-container">
                <h5 class="card-title mb-3" style="font-weight:700">Top 15 Termos por Origem</h5>
                <div style="position:relative;height:320px">
                    <canvas id="chart-kws"></canvas>
                </div>
            </div>

            <!-- Word Cloud segmented -->
            <div id="segmented-wordcloud-container" style="display:none">
                <h5 class="card-title mb-2" style="font-weight:700">Nuvem de Palavras por Origem</h5>
                <p style="font-size:11.5px;color:var(--bm-text-muted);margin-bottom:10px">Azul = Palavras de Autores · Roxo = Palavras Indexadas</p>
                <div id="wordcloud-container" style="width:100%;height:320px;overflow:hidden;border-radius:8px;background:transparent;position:relative">
                    <canvas id="canvas-wordcloud" style="width:100%;height:100%"></canvas>
                </div>
            </div>

            <!-- Treemap segmented -->
            <div id="segmented-treemap-container" style="display:none">
                <h5 class="card-title mb-2" style="font-weight:700">Mapa de Arvore por Origem</h5>
                <p style="font-size:11.5px;color:var(--bm-text-muted);margin-bottom:10px">O tamanho da caixa indica a frequencia. Azul = Autor · Roxo = Indexada</p>
                <div style="position:relative;height:320px">
                    <div id="chart-treemap" style="width:100%;height:100%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Coluna 2: Graficos Consolidados -->
    <div class="col-xl-6">
        <div class="bm-card h-100">
            <!-- Bar chart consolidated -->
            <div id="consolidated-barchart-container">
                <h5 class="card-title mb-3" style="font-weight:700">Top 15 Termos Consolidados (Soma)</h5>
                <div style="position:relative;height:320px">
                    <canvas id="chart-kws-consolidated"></canvas>
                </div>
            </div>

            <!-- Word Cloud consolidated -->
            <div id="consolidated-wordcloud-container" style="display:none">
                <h5 class="card-title mb-2" style="font-weight:700">Nuvem de Palavras Consolidada</h5>
                <p style="font-size:11.5px;color:var(--bm-text-muted);margin-bottom:10px">Geral (Soma de Autor + Indexada)</p>
                <div id="wordcloud-container-consolidated" style="width:100%;height:320px;overflow:hidden;border-radius:8px;background:transparent;position:relative">
                    <canvas id="canvas-wordcloud-consolidated" style="width:100%;height:100%"></canvas>
                </div>
            </div>

            <!-- Treemap consolidated -->
            <div id="consolidated-treemap-container" style="display:none">
                <h5 class="card-title mb-2" style="font-weight:700">Mapa de Arvore Consolidado</h5>
                <p style="font-size:11.5px;color:var(--bm-text-muted);margin-bottom:10px">Geral (Soma de Autor + Indexada)</p>
                <div style="position:relative;height:320px">
                    <div id="chart-treemap-consolidated" style="width:100%;height:100%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Table Column -->
    <div class="col-12">
        <div class="bm-card d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <h5 class="card-title mb-0" style="font-weight:700">
                    {% if app.request.query.get('q') %}
                        Resultado da busca: <span class="text-accent">"{{ app.request.query.get('q') }}"</span>
                    {% else %}
                        Tabela de Termos
                    {% endif %}
                </h5>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <select id="type-filter" class="form-select form-select-sm" style="width:110px;font-size:12px" onchange="filterTable()">
                        <option value="">Todos Origem</option>
                        <option value="author">Autores</option>
                        <option value="indexed">Indexadas</option>
                    </select>
                    <form method="get" action="{{ path('app_report_keywords', {id: project.id}) }}" class="d-flex gap-2 align-items-center mb-0">
                        <div class="input-group input-group-sm">
                            <input type="text" name="q" value="{{ app.request.query.get('q') }}" class="form-control" placeholder="Buscar termo..." style="max-width:150px" autocomplete="off">
                            <button type="submit" class="btn btn-bm-primary" style="border-radius:0 8px 8px 0 !important; background:var(--bm-accent); font-weight:600; padding:6px 14px">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                        {% if app.request.query.get('q') %}
                            <a href="{{ path('app_report_keywords', {id: project.id}) }}" class="btn btn-sm btn-bm-secondary" style="text-decoration:none; white-space:nowrap; padding:6px 12px">
                                Limpar
                            </a>
                        {% endif %}
                    </form>
                </div>
            </div>
            <div class="table-responsive flex-grow-1" style="max-height:400px;overflow-y:auto">
                <table class="table table-hover align-middle border-bm mb-0" id="kws-table" style="font-size:13px">
                    <thead class="sticky-top bg-bm-card border-bottom border-bm">
                        <tr>
                            <th style="color:var(--bm-text-muted);font-weight:600;cursor:pointer;user-select:none" onclick="sortKeywordsTable(0, 'string')">
                                Palavra-Chave / Termo <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                            </th>
                            <th style="color:var(--bm-text-muted);font-weight:600;cursor:pointer;user-select:none" onclick="sortKeywordsTable(1, 'string')">
                                Origem <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                            </th>
                            <th style="color:var(--bm-text-muted);font-weight:600;text-align:right;cursor:pointer;user-select:none" onclick="sortKeywordsTable(2, 'number')">
                                Ocorrencias <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                            </th>
                            <th style="color:var(--bm-text-muted);font-weight:600;text-align:center;cursor:pointer;user-select:none" onclick="sortKeywordsTable(3, 'string')">
                                Periodo <i class="bi bi-arrow-down-up sort-icon ms-1" style="font-size:10px;opacity:0.3;color:var(--bm-text-muted)"></i>
                            </th>
                            <th style="color:var(--bm-text-muted);font-weight:600;text-align:center;user-select:none">Acoes</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        {% if list is empty %}
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-tag-fill d-block fs-3 mb-2" style="color:var(--bm-text-muted)"></i>
                                    Nenhuma palavra-chave encontrada com o termo pesquisado.
                                </td>
                            </tr>
                        {% else %}
                            {% for kw in list %}
                            <tr class="kw-row" data-term="{{ kw.term|lower }}" data-type="{{ kw.type }}">
                                <td style="font-weight:600;color:var(--bm-text)">{{ kw.term }}</td>
                                <td>
                                    <span class="badge" style="font-size:10px;text-transform:uppercase;letter-spacing:0.5px;padding:4px 8px;background:{{ kw.type == 'author' ? 'rgba(79,142,247,0.15)' : 'rgba(168,85,247,0.15)' }};color:{{ kw.type == 'author' ? 'var(--bm-accent)' : '#a855f7' }}">
                                        {{ kw.type == 'author' ? 'Autor' : 'Indexada' }}
                                    </span>
                                </td>
                                <td style="text-align:right;font-weight:700" class="text-accent">{{ kw.freq }}</td>
                                <td style="text-align:center;font-size:11px" class="text-muted-bm">{{ kw.first_year }}–{{ kw.last_year }}</td>
                                <td style="text-align:center">
                                    <button type="button" class="btn btn-sm btn-bm-secondary py-1 px-2 border-bm" 
                                            onclick="viewKeywordWorks({{ project.id }}, {{ kw.id }}, '{{ kw.term|escape('js') }}')"
                                            style="font-size:12px;border-radius:6px">
                                        <i class="bi bi-file-earmark-text me-1"></i>Ver trabalhos
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Trabalhos da Palavra-Chave -->
<div class="modal fade" id="keywordWorksModal" tabindex="-1" aria-labelledby="keywordWorksModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-bm-card border-bm text-bm">
            <div class="modal-header border-bottom border-bm py-3">
                <h5 class="modal-title" id="keywordWorksModalLabel" style="font-weight:700">
                    <i class="bi bi-tag-fill me-2 text-accent"></i>
                    Trabalhos com a Palavra-Chave: <span id="modalKeywordName" class="text-accent"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="filter:invert(var(--bm-close-invert, 1))"></button>
            </div>
            <div class="modal-body p-4" style="min-height:220px">
                
                <!-- Loading Spinner -->
                <div id="modalLoadingSpinner" class="text-center py-5">
                    <div class="spinner-border text-accent" role="status" style="width: 2.5rem; height: 2.5rem;">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <div class="mt-2 text-muted" style="font-size:13px">Carregando trabalhos do banco de dados...</div>
                </div>

                <!-- Empty State Message -->
                <div id="modalNoWorksMessage" class="alert alert-warning text-center border-0 py-4 mb-0" style="display:none;background:rgba(235,178,72,0.1);color:#ebb248;font-size:13px;border-radius:8px">
                    <i class="bi bi-exclamation-triangle d-block fs-4 mb-2"></i>
                    Nenhum trabalho correspondente foi localizado para esta palavra-chave.
                </div>

                <!-- Content Table -->
                <div id="modalContentTable" style="display:none">
                    <p class="text-muted mb-3" style="font-size:12.5px">
                        Abaixo estão listados todos os trabalhos catalogados no projeto que contêm o termo selecionado.
                    </p>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border-bm mb-0" style="font-size:12.5px">
                            <thead class="sticky-top bg-bm-card border-bottom border-bm">
                                <tr>
                                    <th style="color:var(--bm-text-muted);font-weight:600;min-width:350px">Autores - Ano - Nome do Trabalho (copiar para nome de arquivo)</th>
                                    <th style="color:var(--bm-text-muted);font-weight:600;text-align:center">Ano</th>
                                    <th style="color:var(--bm-text-muted);font-weight:600;text-align:center">Citações</th>
                                    <th style="color:var(--bm-text-muted);font-weight:600">Tipo</th>
                                    <th style="color:var(--bm-text-muted);font-weight:600">Veículo / Fonte</th>
                                    <th style="color:var(--bm-text-muted);font-weight:600;text-align:center">Link</th>
                                </tr>
                            </thead>
                            <tbody id="modalKeywordWorksBody" class="border-0">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <div class="modal-footer border-top border-bm py-3">
                <button type="button" class="btn btn-bm-secondary" data-bs-dismiss="modal" style="font-size:13px;font-weight:600">Fechar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal BibTeX -->
<div class="modal fade" id="bibtexModal" tabindex="-1" aria-labelledby="bibtexModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-bm-card border-bm text-bm" style="background:var(--bm-card-bg); border:1px solid var(--bm-border); border-radius:12px;">
            <div class="modal-header border-bottom border-bm py-3 border-0 pb-0">
                <h5 class="modal-title" id="bibtexModalLabel" style="font-weight:700; color:var(--bm-text)">
                    <i class="bi bi-code-slash me-2 text-accent"></i>
                    Referência BibTeX para Zotero
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="filter:invert(var(--bm-close-invert, 1))"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted" style="font-size:13px">
                    Copie o código BibTeX abaixo e cole no Zotero (usando a opção <em>"Importar do Clipboard / Área de Transferência"</em>).
                </p>
                <div style="position:relative">
                    <pre id="bibtexCode" class="p-3" style="background:var(--bm-bg);border:1px solid var(--bm-border);border-radius:8px;font-family:monospace;font-size:12.5px;color:var(--bm-text);white-space:pre-wrap;max-height:350px;overflow-y:auto;text-align:left"></pre>
                    <button type="button" class="btn btn-sm btn-bm-primary" onclick="copyBibtexToClipboard()" style="position:absolute;top:10px;right:10px;background:var(--bm-accent);border:none;font-weight:600;padding:4px 12px;font-size:12px">
                        <i class="bi bi-clipboard me-1"></i> Copiar
                    </button>
                </div>
                <div id="copySuccessAlert" class="text-success mt-2" style="font-size:12px;display:none;font-weight:600">
                    <i class="bi bi-check-circle-fill me-1"></i> Copiado com sucesso para a área de transferência!
                </div>
            </div>
            <div class="modal-footer border-top border-bm py-3 border-0 pt-0">
                <button type="button" class="btn btn-sm btn-bm-secondary px-4" data-bs-dismiss="modal" style="font-size:13px;font-weight:600">Fechar</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/wordcloud@1.2.2/src/wordcloud2.js"></script>
<script>
const listData = {{ list|json_encode|raw }};
let chartInstance  = null;
let chartInstanceConsolidated = null;
let wcInitialized  = false;
let tmInitialized  = false;
let myTreemapChart = null;
let myTreemapChartConsolidated = null;
let currentView    = 'barchart';

function isThemeLight() {
    return document.documentElement.getAttribute('data-bs-theme') === 'light';
}
function getColors() {
    const light = isThemeLight();
    return {
        grid: light ? 'rgba(208,215,222,0.8)' : 'rgba(48,54,61,0.8)',
        text: light ? '#57606a' : '#8b949e',
        bg:   light ? '#f6f8fa' : '#1c2128',
        authorColor: '#4f8ef7',
        indexedColor: '#a855f7',
        consolidatedColor: '#10b981',
    };
}

function getConsolidatedData(limit = 80) {
    const map = {};
    listData.forEach(k => {
        const term = k.term;
        if (!map[term]) {
            map[term] = {
                id: k.id,
                term: term,
                freq: 0,
                type: 'consolidated',
                first_year: k.first_year,
                last_year: k.last_year
            };
        }
        map[term].freq += k.freq;
        if (k.first_year && (!map[term].first_year || k.first_year < map[term].first_year)) {
            map[term].first_year = k.first_year;
        }
        if (k.last_year && (!map[term].last_year || k.last_year > map[term].last_year)) {
            map[term].last_year = k.last_year;
        }
    });
    return Object.values(map).sort((a, b) => b.freq - a.freq).slice(0, limit);
}

window.addEventListener('bm-theme-changed', () => {
    rebuildChart();
    if (currentView === 'wordcloud') {
        wcInitialized = false;
        buildWordCloud();
    } else if (currentView === 'treemap') {
        tmInitialized = false;
        buildTreemap();
    }
});

function showView(view) {
    currentView = view;
    
    // Toggle segmented
    document.getElementById('segmented-barchart-container').style.display = view === 'barchart' ? '' : 'none';
    document.getElementById('segmented-wordcloud-container').style.display = view === 'wordcloud' ? '' : 'none';
    document.getElementById('segmented-treemap-container').style.display = view === 'treemap' ? '' : 'none';

    // Toggle consolidated
    document.getElementById('consolidated-barchart-container').style.display = view === 'barchart' ? '' : 'none';
    document.getElementById('consolidated-wordcloud-container').style.display = view === 'wordcloud' ? '' : 'none';
    document.getElementById('consolidated-treemap-container').style.display = view === 'treemap' ? '' : 'none';

    const btnBar   = document.getElementById('btn-barchart');
    const btnCloud = document.getElementById('btn-wordcloud');
    const btnTree  = document.getElementById('btn-treemap');

    [btnBar, btnCloud, btnTree].forEach(btn => {
        if (btn) {
            btn.style.borderColor = 'var(--bm-border)';
            btn.style.color       = 'var(--bm-text-muted)';
            btn.style.background  = 'transparent';
        }
    });

    const activeBtn = view === 'barchart' ? btnBar : (view === 'wordcloud' ? btnCloud : btnTree);
    if (activeBtn) {
        activeBtn.style.borderColor = 'var(--bm-accent)';
        activeBtn.style.color       = 'var(--bm-accent)';
        activeBtn.style.background  = 'rgba(79,142,247,0.1)';
    }

    if (view === 'wordcloud' && !wcInitialized) {
        buildWordCloud();
    } else if (view === 'treemap') {
        if (!tmInitialized) {
            buildTreemap();
        } else {
            if (myTreemapChart) myTreemapChart.resize();
            if (myTreemapChartConsolidated) myTreemapChartConsolidated.resize();
        }
    }
}

function buildWordCloud() {
    const cl     = getColors();
    
    // Segmented Word Cloud
    const canvas = document.getElementById('canvas-wordcloud');
    const container = document.getElementById('wordcloud-container');
    canvas.width  = container.clientWidth  || 500;
    canvas.height = container.clientHeight || 320;

    const segmentedList = listData.slice(0, 80);
    const words = segmentedList.map(k => [
        k.term,
        Math.max(10, Math.min(60, k.freq * 4 + 10))
    ]);

    WordCloud(canvas, {
        list: words,
        gridSize: Math.round(16 * canvas.width / 1024),
        weightFactor: 1,
        fontFamily: 'Inter, system-ui, sans-serif',
        color: (word) => {
            const item = segmentedList.find(k => k.term === word);
            if (!item) return cl.authorColor;
            return item.type === 'author' ? cl.authorColor : cl.indexedColor;
        },
        rotateRatio: 0.2,
        rotationSteps: 2,
        backgroundColor: 'transparent',
        minSize: 9,
        drawOutOfBound: false,
        shrinkToFit: true,
    });

    // Consolidated Word Cloud
    const canvasCons = document.getElementById('canvas-wordcloud-consolidated');
    const containerCons = document.getElementById('wordcloud-container-consolidated');
    canvasCons.width  = containerCons.clientWidth  || 500;
    canvasCons.height = containerCons.clientHeight || 320;

    const consolidatedList = getConsolidatedData(80);
    const wordsCons = consolidatedList.map(k => [
        k.term,
        Math.max(10, Math.min(60, k.freq * 4 + 10))
    ]);

    WordCloud(canvasCons, {
        list: wordsCons,
        gridSize: Math.round(16 * canvasCons.width / 1024),
        weightFactor: 1,
        fontFamily: 'Inter, system-ui, sans-serif',
        color: () => cl.consolidatedColor,
        rotateRatio: 0.2,
        rotationSteps: 2,
        backgroundColor: 'transparent',
        minSize: 9,
        drawOutOfBound: false,
        shrinkToFit: true,
    });

    wcInitialized = true;
}

function buildTreemap() {
    const cl = getColors();
    
    // Segmented Treemap
    const chartDom = document.getElementById('chart-treemap');
    if (!myTreemapChart) {
        myTreemapChart = echarts.init(chartDom);
    }

    const segmentedList = listData.slice(0, 40);
    const data = segmentedList.map(k => {
        const itemColor = k.type === 'author' ? cl.authorColor : cl.indexedColor;
        return {
            name: k.term,
            value: k.freq,
            itemStyle: {
                color: itemColor,
                borderColor: 'var(--bm-card-bg)',
                borderWidth: 2
            }
        };
    });

    const option = {
        tooltip: {
            trigger: 'item',
            formatter: function (info) {
                const term = info.name;
                const value = info.value;
                const item = segmentedList.find(k => k.term === term);
                const typeText = item && item.type === 'author' ? 'Palavra de Autor' : 'Palavra Indexada';
                return `<div style="font-family:'Inter',sans-serif;font-size:12px;">` +
                       `<b>${term}</b><br/>` +
                       `Tipo: <b>${typeText}</b><br/>` +
                       `Ocorrencias: <b>${value}</b>` +
                       `</div>`;
            }
        },
        series: [{
            type: 'treemap',
            data: data,
            roam: false,
            nodeClick: false,
            breadcrumb: {
                show: false
            },
            label: {
                show: true,
                formatter: '{b}\n({c})',
                fontSize: 11,
                fontFamily: '"Inter", sans-serif',
                fontWeight: '600',
                color: '#ffffff'
            },
            itemStyle: {
                borderColor: 'var(--bm-card-bg)',
                borderWidth: 2
            },
            levels: [
                {
                    itemStyle: {
                        borderWidth: 2,
                        gapWidth: 2
                    }
                }
            ]
        }]
    };
    myTreemapChart.setOption(option);

    // Consolidated Treemap
    const chartDomCons = document.getElementById('chart-treemap-consolidated');
    if (!myTreemapChartConsolidated) {
        myTreemapChartConsolidated = echarts.init(chartDomCons);
    }

    const consolidatedList = getConsolidatedData(40);
    const dataCons = consolidatedList.map(k => {
        return {
            name: k.term,
            value: k.freq,
            itemStyle: {
                color: cl.consolidatedColor,
                borderColor: 'var(--bm-card-bg)',
                borderWidth: 2
            }
        };
    });

    const optionCons = {
        tooltip: {
            trigger: 'item',
            formatter: function (info) {
                const term = info.name;
                const value = info.value;
                return `<div style="font-family:'Inter',sans-serif;font-size:12px;">` +
                       `<b>${term}</b><br/>` +
                       `Tipo: <b>Consolidada (Soma)</b><br/>` +
                       `Ocorrencias: <b>${value}</b>` +
                       `</div>`;
            }
        },
        series: [{
            type: 'treemap',
            data: dataCons,
            roam: false,
            nodeClick: false,
            breadcrumb: {
                show: false
            },
            label: {
                show: true,
                formatter: '{b}\n({c})',
                fontSize: 11,
                fontFamily: '"Inter", sans-serif',
                fontWeight: '600',
                color: '#ffffff'
            },
            itemStyle: {
                borderColor: 'var(--bm-card-bg)',
                borderWidth: 2
            },
            levels: [
                {
                    itemStyle: {
                        borderWidth: 2,
                        gapWidth: 2
                    }
                }
            ]
        }]
    };
    myTreemapChartConsolidated.setOption(optionCons);

    tmInitialized = true;

    window.addEventListener('resize', () => {
        if (myTreemapChart) myTreemapChart.resize();
        if (myTreemapChartConsolidated) myTreemapChartConsolidated.resize();
    });
}

function rebuildChart() {
    const cl = getColors();
    Chart.defaults.color       = cl.text;
    Chart.defaults.borderColor = cl.grid;
    if (chartInstance) chartInstance.destroy();
    if (chartInstanceConsolidated) chartInstanceConsolidated.destroy();

    const segmentedList = listData.slice(0, 15);
    const consolidatedList = getConsolidatedData(15);

    // Segmented Chart
    const ctx = document.getElementById('chart-kws').getContext('2d');
    chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: segmentedList.map(k => k.term),
            datasets: [{
                label: 'Ocorrencias',
                data: segmentedList.map(k => k.freq),
                backgroundColor: segmentedList.map(k => k.type === 'author' ? cl.authorColor + 'cc' : cl.indexedColor + 'cc'),
                borderColor: segmentedList.map(k => k.type === 'author' ? cl.authorColor : cl.indexedColor),
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        generateLabels: () => [
                            { text: 'Palavra de Autor',   fillStyle: cl.authorColor + 'cc',  strokeStyle: cl.authorColor },
                            { text: 'Palavra Indexada',   fillStyle: cl.indexedColor + 'cc', strokeStyle: cl.indexedColor }
                        ]
                    }
                }
            },
            scales: {
                x: { grid: { display: false }, ticks: { maxRotation: 45, minRotation: 45 } },
                y: {
                    grid: { color: cl.grid },
                    beginAtZero: true,
                    title: { display: true, text: 'Frequencia', font: { weight: 'bold' } }
                }
            }
        }
    });

    // Consolidated Chart
    const ctxCons = document.getElementById('chart-kws-consolidated').getContext('2d');
    chartInstanceConsolidated = new Chart(ctxCons, {
        type: 'bar',
        data: {
            labels: consolidatedList.map(k => k.term),
            datasets: [{
                label: 'Ocorrencias',
                data: consolidatedList.map(k => k.freq),
                backgroundColor: cl.consolidatedColor + 'cc',
                borderColor: cl.consolidatedColor,
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        generateLabels: () => [
                            { text: 'Palavra Consolidada (Soma)', fillStyle: cl.consolidatedColor + 'cc', strokeStyle: cl.consolidatedColor }
                        ]
                    }
                }
            },
            scales: {
                x: { grid: { display: false }, ticks: { maxRotation: 45, minRotation: 45 } },
                y: {
                    grid: { color: cl.grid },
                    beginAtZero: true,
                    title: { display: true, text: 'Frequencia', font: { weight: 'bold' } }
                }
            }
        }
    });
}

function filterTable() {
    const type = document.getElementById('type-filter').value;
    document.querySelectorAll('.kw-row').forEach(row => {
        const rowType = row.dataset.type;
        const matchT  = !type || rowType === type;
        row.style.display = matchT ? '' : 'none';
    });
}

let currentSortColumn = -1;
let sortAscending = true;

function sortKeywordsTable(columnIndex, type) {
    const table = document.getElementById('kws-table');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('.kw-row'));
    if (rows.length === 0) return;
    
    if (currentSortColumn === columnIndex) {
        sortAscending = !sortAscending;
    } else {
        currentSortColumn = columnIndex;
        sortAscending = true;
    }

    // Update header icons
    const headers = table.querySelectorAll('thead th');
    headers.forEach((th, idx) => {
        const icon = th.querySelector('.sort-icon');
        if (icon) {
            if (idx === columnIndex) {
                icon.className = sortAscending ? 'bi bi-caret-up-fill sort-icon ms-1' : 'bi bi-caret-down-fill sort-icon ms-1';
                icon.style.color = 'var(--bm-accent)';
                icon.style.opacity = '1';
            } else {
                icon.className = 'bi bi-arrow-down-up sort-icon ms-1';
                icon.style.color = 'var(--bm-text-muted)';
                icon.style.opacity = '0.3';
            }
        }
    });

    // Sort rows
    rows.sort((rowA, rowB) => {
        const cellA = rowA.cells[columnIndex].textContent.trim();
        const cellB = rowB.cells[columnIndex].textContent.trim();

        if (type === 'number') {
            const numA = parseFloat(cellA.replace(/[^\d.-]/g, '')) || 0;
            const numB = parseFloat(cellB.replace(/[^\d.-]/g, '')) || 0;
            return sortAscending ? numA - numB : numB - numA;
        } else {
            return sortAscending 
                ? cellA.localeCompare(cellB, 'pt-BR', { sensitivity: 'base' })
                : cellB.localeCompare(cellA, 'pt-BR', { sensitivity: 'base' });
        }
    });

    tbody.innerHTML = '';
    rows.forEach(row => tbody.appendChild(row));
}

function viewKeywordWorks(projectId, keywordId, keywordTerm) {
    const modal = new bootstrap.Modal(document.getElementById('keywordWorksModal'));
    
    // Set keyword term in header
    document.getElementById('modalKeywordName').textContent = keywordTerm;
    
    // Reset modal state
    document.getElementById('modalLoadingSpinner').style.display = 'block';
    document.getElementById('modalContentTable').style.display = 'none';
    document.getElementById('modalNoWorksMessage').style.display = 'none';
    document.getElementById('modalKeywordWorksBody').innerHTML = '';
    
    modal.show();
    
    // Fetch via AJAX
    const url = `/projects/${projectId}/reports/keywords/${keywordId}/documents`;
    fetch(url)
        .then(response => {
            if (!response.ok) {
                throw new Error('Erro ao carregar os trabalhos.');
            }
            return response.json();
        })
        .then(data => {
            document.getElementById('modalLoadingSpinner').style.display = 'none';
            
            if (!data.documents || data.documents.length === 0) {
                document.getElementById('modalNoWorksMessage').style.display = 'block';
                return;
            }
            
            const tbody = document.getElementById('modalKeywordWorksBody');
            data.documents.forEach(doc => {
                const tr = document.createElement('tr');
                
                // Title td formatted with [All Authors] - [Year] - [Title]
                const tdTitle = document.createElement('td');
                tdTitle.style.fontWeight = '600';
                tdTitle.style.color = 'var(--bm-text)';
                const docTitle = (doc.title || 'Sem título').replace(/[:\/]/g, '');
                const docYear = doc.year || '—';
                const docAuthors = doc.author_names || 'Autor desconhecido';
                const formattedTitle = `${docAuthors} - ${docYear} - ${docTitle}`;
                tdTitle.title = formattedTitle;
                tdTitle.textContent = formattedTitle + ' ';
                
                const copyBtn = document.createElement('button');
                copyBtn.type = 'button';
                copyBtn.className = 'btn btn-sm btn-link p-0 text-muted ms-1';
                copyBtn.style.verticalAlign = 'middle';
                copyBtn.style.textDecoration = 'none';
                copyBtn.title = 'Copiar nome reduzido (máx 250 caracteres)';
                copyBtn.innerHTML = '<i class="bi bi-clipboard"></i>';
                copyBtn.onclick = function() {
                    const cleanTitle = docTitle;
                    const cleanYear = String(docYear);
                    const cleanAuthors = String(docAuthors);
                    const maxAuthorsLen = 250 - 6 - cleanYear.length - cleanTitle.length;
                    let reducedAuthors = cleanAuthors;
                    if (cleanAuthors.length > maxAuthorsLen) {
                        reducedAuthors = cleanAuthors.slice(0, Math.max(0, maxAuthorsLen));
                    }
                    const textToCopy = `${reducedAuthors} - ${cleanYear} - ${cleanTitle}`;
                    navigator.clipboard.writeText(textToCopy).then(() => {
                        const icon = copyBtn.querySelector('i');
                        if (icon) {
                            icon.className = 'bi bi-check2 text-success';
                            setTimeout(() => {
                                icon.className = 'bi bi-clipboard';
                            }, 1500);
                        }
                    });
                };
                tdTitle.appendChild(copyBtn);
                
                tr.appendChild(tdTitle);
                
                // Year td
                const tdYear = document.createElement('td');
                tdYear.style.textAlign = 'center';
                tdYear.textContent = doc.year || '—';
                tr.appendChild(tdYear);
                
                // Citations td
                const tdCit = document.createElement('td');
                tdCit.style.textAlign = 'center';
                tdCit.style.fontWeight = '700';
                tdCit.className = 'text-accent';
                tdCit.textContent = doc.cited_by !== null ? doc.cited_by : 0;
                tr.appendChild(tdCit);
                
                // Document type td
                const tdType = document.createElement('td');
                tdType.style.color = 'var(--bm-text-muted)';
                tdType.textContent = doc.document_type || '—';
                tr.appendChild(tdType);
                
                // Source title td
                const tdSource = document.createElement('td');
                tdSource.style.maxWidth = '150px';
                tdSource.style.overflow = 'hidden';
                tdSource.style.textOverflow = 'ellipsis';
                tdSource.style.whiteSpace = 'nowrap';
                tdSource.style.color = 'var(--bm-text-muted)';
                tdSource.title = doc.source_title || '—';
                tdSource.textContent = doc.source_title || '—';
                tr.appendChild(tdSource);
                
                // Link td
                const tdLink = document.createElement('td');
                tdLink.style.textAlign = 'center';
                tdLink.style.whiteSpace = 'nowrap';
                
                let hasLink = false;
                if (doc.doi) {
                    const a = document.createElement('a');
                    a.href = `https://doi.org/${doc.doi}`;
                    a.target = '_blank';
                    a.style.color = 'var(--bm-accent)';
                    a.style.textDecoration = 'none';
                    a.innerHTML = '<i class="bi bi-box-arrow-up-right"></i> DOI';
                    tdLink.appendChild(a);

                    const aSci = document.createElement('a');
                    aSci.href = `https://sci-hub.box/${doc.doi}`;
                    aSci.target = '_blank';
                    aSci.style.color = 'var(--bm-accent)';
                    aSci.style.textDecoration = 'none';
                    aSci.style.marginLeft = '8px';
                    aSci.title = 'Sci-Hub';
                    aSci.innerHTML = '<i class="bi bi-key"></i> Sci-Hub';
                    tdLink.appendChild(aSci);

                    hasLink = true;
                } else if (doc.url) {
                    const a = document.createElement('a');
                    a.href = doc.url;
                    a.target = '_blank';
                    a.style.color = 'var(--bm-accent)';
                    a.style.textDecoration = 'none';
                    a.innerHTML = '<i class="bi bi-box-arrow-up-right"></i> URL';
                    tdLink.appendChild(a);
                    hasLink = true;
                }

                const btnBib = document.createElement('button');
                btnBib.type = 'button';
                btnBib.className = 'btn btn-sm btn-outline-secondary py-0 px-2' + (hasLink ? ' ms-2' : '');
                btnBib.style.fontSize = '11.5px';
                btnBib.style.borderRadius = '4px';
                btnBib.innerHTML = '<i class="bi bi-journal-code"></i> BibTeX';
                btnBib.onclick = (e) => {
                    e.preventDefault();
                    showBibtex(doc, docAuthors);
                };
                tdLink.appendChild(btnBib);

                tr.appendChild(tdLink);
                
                tbody.appendChild(tr);
            });
            
            document.getElementById('modalContentTable').style.display = 'block';
        })
        .catch(err => {
            document.getElementById('modalLoadingSpinner').style.display = 'none';
            document.getElementById('modalNoWorksMessage').textContent = 'Erro: ' + err.message;
            document.getElementById('modalNoWorksMessage').style.display = 'block';
        });
}

function exportCSV() {
    const fullList = {{ list|json_encode|raw }};
    let csv = "\uFEFFKeyword;Type;Frequency;First Year;Last Year\r\n";
    fullList.forEach(k => {
        csv += `"${k.term}";${k.type};${k.freq};${k.first_year};${k.last_year}\r\n`;
    });
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href  = url;
    link.download = 'analise_palavras_chave.csv';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

let currentBibtexText = '';

function showBibtex(doc, authorsStr) {
    let firstAuthor = 'Unknown';
    if (authorsStr && authorsStr !== 'Autor desconhecido') {
        const parts = authorsStr.split(';');
        if (parts.length > 0) {
            const first = parts[0].trim();
            const commaIndex = first.indexOf(',');
            if (commaIndex !== -1) {
                firstAuthor = first.substring(0, commaIndex).trim().replace(/[^a-zA-Z]/g, '');
            } else {
                firstAuthor = first.replace(/[^a-zA-Z]/g, '');
            }
        }
    }
    const year = doc.year || '0000';
    const citeKey = `${firstAuthor.toLowerCase()}${year}`;
    
    let bib = `@article{${citeKey},\n`;
    bib += `  author = {${authorsStr.replace(/;/g, ' and')}},\n`;
    bib += `  title = {${doc.title || 'Sem título'}},\n`;
    if (doc.source_title) {
        bib += `  journal = {${doc.source_title}},\n`;
    }
    bib += `  year = {${year}},\n`;
    if (doc.volume) {
        bib += `  volume = {${doc.volume}},\n`;
    }
    if (doc.issue) {
        bib += `  number = {${doc.issue}},\n`;
    }
    if (doc.page_start || doc.page_end) {
        const start = doc.page_start || '';
        const end = doc.page_end || '';
        bib += `  pages = {${start}${start && end ? '--' : ''}${end}},\n`;
    }
    if (doc.doi) {
        bib += `  doi = {${doc.doi}},\n`;
    }
    if (doc.url) {
        bib += `  url = {${doc.url}},\n`;
    }
    if (doc.publisher) {
        bib += `  publisher = {${doc.publisher}},\n`;
    }
    if (doc.issn) {
        bib += `  issn = {${doc.issn}},\n`;
    }
    if (doc.isbn) {
        bib += `  isbn = {${doc.isbn}},\n`;
    }
    if (doc.abstract_text) {
        bib += `  abstract = {${doc.abstract_text}},\n`;
    }
    bib += `}`;
    
    currentBibtexText = bib;
    document.getElementById('bibtexCode').textContent = bib;
    document.getElementById('copySuccessAlert').style.display = 'none';
    
    const modal = new bootstrap.Modal(document.getElementById('bibtexModal'));
    modal.show();
}

function copyBibtexToClipboard() {
    navigator.clipboard.writeText(currentBibtexText).then(() => {
        const alert = document.getElementById('copySuccessAlert');
        alert.style.display = 'block';
        setTimeout(() => {
            alert.style.display = 'none';
        }, 3000);
    });
}

rebuildChart();

function toggleKwInfo() {
    const box     = document.getElementById('kw-info-box');
    const chevron = document.getElementById('kw-info-chevron');
    const open    = box.style.display === 'none';
    box.style.display     = open ? 'block' : 'none';
    chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
}
</script>
{% endblock %}
