{% extends 'base.html.twig' %}

{% block title %}Análise de Documentos — {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Projetos</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_projects_show', {id: project.id}) }}" style="color:var(--bm-text-muted);text-decoration:none">{{ project.title|slice(0,30) }}</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <span class="current">Documentos</span>
{% endblock %}

{% block topbar_actions %}
<button class="btn-bm-primary" onclick="exportCSV()" style="padding:6px 14px;font-size:13px">
    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
</button>
{{ help('report.documents.export_csv') }}
{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-file-earmark-text me-2" style="color:var(--bm-accent)"></i>
        Análise de Documentos {{ help('report.documents.page') }}
    </h1>
    <p class="bm-page-subtitle">Principais documentos científicos ordenados por impacto e contagem de citações</p>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="bm-stat-card">
            <div class="bm-stat-value">{{ kpis.total_docs|number_format(0, ',', '.') }}</div>
            <div class="bm-stat-label">Total de Documentos {{ help('report.documents.kpi_total') }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bm-stat-card">
            <div class="bm-stat-value">{{ kpis.total_citations|number_format(0, ',', '.') }}</div>
            <div class="bm-stat-label">Total de Citações Recebidas {{ help('report.documents.kpi_citations') }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bm-stat-card">
            <div class="bm-stat-value">{{ kpis.avg_citations|number_format(1, ',', '.') }}</div>
            <div class="bm-stat-label">Média de Citações por Documento {{ help('report.documents.kpi_avg') }}</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Chart Column -->
    <div class="col-xl-6">
        <div class="bm-card h-100">
            <h5 class="card-title mb-3" style="font-weight:700">10 Documentos mais Citados {{ help('report.documents.chart_top') }}</h5>
            <div style="position:relative;height:340px">
                <canvas id="chart-docs"></canvas>
            </div>
        </div>
    </div>

    <!-- Table Column -->
    <div class="col-xl-6">
        <div class="bm-card h-100 d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <h5 class="card-title mb-0" style="font-weight:700">100 Mais Citados {{ help('report.documents.table') }}</h5>
                <div class="d-flex align-items-center gap-2">
                    <input type="text" id="table-search" class="form-control form-control-sm" placeholder="🔍 Filtrar título ou autor…" style="width:200px" oninput="filterTable()" aria-label="Filtrar título ou autor">
                    {{ help('report.documents.search') }}
                    <a href="{{ path('app_report_documents_search', {id: project.id}) }}" class="btn btn-sm btn-bm-secondary" style="white-space:nowrap;font-size:12px;text-decoration:none" title="Buscar em todos os documentos do projeto">
                        <i class="bi bi-search me-1"></i>Busca completa
                    </a>
                </div>
            </div>
            
            <div class="table-responsive flex-grow-1" style="max-height:340px;overflow-y:auto">
                <table class="table table-hover align-middle border-bm mb-0" id="docs-table" style="font-size:13px">
                    <thead class="sticky-top bg-bm-card border-bottom border-bm">
                        <tr>
                            <th style="color:var(--bm-text-muted);font-weight:600">Título / Autores {{ help('report.documents.col_title') }}</th>
                            <th style="color:var(--bm-text-muted);font-weight:600;text-align:right">Citações {{ help('report.documents.col_citations') }}</th>
                            <th style="color:var(--bm-text-muted);font-weight:600;text-align:center">Qualis {{ help('report.documents.col_qualis') }}</th>
                            <th style="color:var(--bm-text-muted);font-weight:600;text-align:center">Ano</th>
                            <th style="color:var(--bm-text-muted);font-weight:600">Fonte</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        {% for doc in list %}
                        <tr class="doc-row" data-title="{{ doc.title|lower }}" data-authors="{{ doc.authors_str|lower }}">
                            <td>
                                <div style="font-weight:600;line-height:1.3" title="{{ doc.title }}">
                                    {% if doc.url %}
                                        <a href="{{ doc.url }}" target="_blank" style="color:var(--bm-text);text-decoration:none" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                                            {{ doc.title|slice(0, 70) }}{{ doc.title|length > 70 ? '…' : '' }}
                                            <i class="bi bi-box-arrow-up-right ms-1 text-muted" style="font-size:10px"></i>
                                        </a>
                                    {% elseif doc.doi %}
                                        <a href="https://doi.org/{{ doc.doi }}" target="_blank" style="color:var(--bm-text);text-decoration:none" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                                            {{ doc.title|slice(0, 70) }}{{ doc.title|length > 70 ? '…' : '' }}
                                            <i class="bi bi-box-arrow-up-right ms-1 text-muted" style="font-size:10px"></i>
                                        </a>
                                    {% else %}
                                        <span style="color:var(--bm-text)">{{ doc.title|slice(0, 70) }}{{ doc.title|length > 70 ? '…' : '' }}</span>
                                    {% endif %}
                                </div>
                                <div style="font-size:11px;color:var(--bm-text-muted);margin-top:2px" class="d-flex align-items-center gap-1 flex-wrap">
                                    <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis" title="{{ doc.authors_str }}">
                                        {{ doc.authors_str|slice(0, 60) }}{{ doc.authors_str|length > 60 ? '…' : '' }}
                                    </span>
                                    {% if doc.country_siglas %}
                                        <span class="d-inline-flex gap-1 align-items-center ms-2" title="{{ doc.country_names }}">
                                            {% for sigla in doc.country_siglas|split(',') %}
                                                {% if sigla|trim is not empty %}
                                                    <img src="https://flagcdn.com/16x12/{{ sigla|trim|lower }}.png" width="16" height="12" style="border:1px solid rgba(255,255,255,0.15);border-radius:2px" alt="{{ sigla }}">
                                                {% endif %}
                                            {% endfor %}
                                        </span>
                                    {% endif %}
                                </div>
                            </td>
                            <td style="text-align:right;font-weight:700" class="text-accent">{{ doc.cited_by }}</td>
                            <td style="text-align:center">
                                {% if doc.qualis %}
                                    {% set qColor = '#8b949e' %}
                                    {% set qBg = 'rgba(255,255,255,0.05)' %}
                                    {% if doc.qualis in ['A1', 'A2'] %}
                                        {% set qColor = '#2ea043' %}
                                        {% set qBg = 'rgba(56,139,60,0.15)' %}
                                    {% elseif doc.qualis in ['A3', 'A4'] %}
                                        {% set qColor = '#58a6ff' %}
                                        {% set qBg = 'rgba(56,139,253,0.15)' %}
                                    {% elseif doc.qualis in ['B1', 'B2'] %}
                                        {% set qColor = '#d29922' %}
                                        {% set qBg = 'rgba(187,128,9,0.15)' %}
                                    {% elseif doc.qualis in ['B3', 'B4'] %}
                                        {% set qColor = '#db6d28' %}
                                        {% set qBg = 'rgba(219,109,40,0.15)' %}
                                    {% elseif doc.qualis == 'C' %}
                                        {% set qColor = '#f85149' %}
                                        {% set qBg = 'rgba(248,81,73,0.15)' %}
                                    {% endif %}
                                    <span class="badge rounded-pill" style="background:{{ qBg }};color:{{ qColor }};font-size:10px;font-weight:700">{{ doc.qualis }}</span>
                                {% else %}
                                    <span class="text-muted" style="font-size:11px">—</span>
                                {% endif %}
                            </td>
                            <td style="text-align:center">{{ doc.year }}</td>
                            <td style="font-size:11px;color:var(--bm-text-muted)" title="{{ doc.source_title }}">
                                {{ doc.source_title|slice(0, 25) }}{{ doc.source_title|length > 25 ? '…' : '' }}
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="5" class="text-center text-muted-bm py-4">Nenhum documento neste projeto.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
const listData = {{ list|slice(0, 10)|json_encode|raw }};
let chartInstance = null;

function isThemeLight() {
    return document.documentElement.getAttribute('data-bs-theme') === 'light';
}

function getColors() {
    const light = isThemeLight();
    return {
        grid: light ? 'rgba(208,215,222,0.8)' : 'rgba(48,54,61,0.8)',
        text: light ? '#57606a' : '#8b949e',
        accent: '#f0883e' // orange/golden for documents
    };
}

window.addEventListener('bm-theme-changed', () => {
    rebuildChart();
});

function rebuildChart() {
    const cl = getColors();
    Chart.defaults.color = cl.text;
    Chart.defaults.borderColor = cl.grid;

    if (chartInstance) chartInstance.destroy();

    const ctx = document.getElementById('chart-docs').getContext('2d');
    chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: listData.map(d => d.title.length > 25 ? d.title.slice(0, 25) + '…' : d.title),
            datasets: [
                {
                    label: 'Citações Globais',
                    data: listData.map(d => d.cited_by),
                    backgroundColor: cl.accent + 'cc',
                    borderColor: cl.accent,
                    borderWidth: 1,
                    borderRadius: 4
                }
            ]
        },
        options: {
            indexAxis: 'y', // horizontal bars
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { title: items => listData[items[0].dataIndex]?.title || '' } }
            },
            scales: {
                y: { grid: { display: false } },
                x: {
                    grid: { color: cl.grid },
                    title: { display: true, text: 'Citações Recebidas', font: { weight: 'bold' } }
                }
            }
        }
    });
}

function filterTable() {
    const q = document.getElementById('table-search').value.toLowerCase().trim();
    document.querySelectorAll('.doc-row').forEach(row => {
        const title = row.dataset.title;
        const authors = row.dataset.authors;
        row.style.display = (!q || title.includes(q) || authors.includes(q)) ? '' : 'none';
    });
}

function exportCSV() {
    const fullList = {{ list|json_encode|raw }};
    // Campos podem vir nulos do banco (ex.: documento sem autores ou sem fonte)
    const q = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
    let csv = "\uFEFFTítulo;Autores;Ano;Fonte;Citações;Qualis;DOI\r\n";
    fullList.forEach(d => {
        csv += `${q(d.title)};${q(d.authors_str)};${d.year ?? ''};${q(d.source_title)};${d.cited_by};${d.qualis ?? ''};${q(d.doi)}\r\n`;
    });

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "analise_documentos.csv";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

rebuildChart();
</script>
{% endblock %}
