<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Favicon & Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg">
    <meta name="theme-color" content="#060b14">

    {# ── SEO ── #}
    <title>{{ site_settings.seoTitle }}</title>
    <meta name="description" content="{{ site_settings.seoDescription }}">
    <meta name="keywords"    content="{{ site_settings.seoKeywords }}">
    <link rel="canonical"    href="{{ site_settings.baseUrl }}/">

    {# ── Open Graph ── #}
    <meta property="og:type"        content="website">
    <meta property="og:url"         content="{{ site_settings.baseUrl }}/">
    <meta property="og:title"       content="{{ site_settings.seoTitle }}">
    <meta property="og:description" content="{{ site_settings.seoDescription }}">
    {% if site_settings.ogImageUrl %}
    <meta property="og:image"       content="{{ site_settings.baseUrl }}{{ site_settings.ogImageUrl }}">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    {% endif %}

    {# ── Twitter Card ── #}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="{{ site_settings.seoTitle }}">
    <meta name="twitter:description" content="{{ site_settings.seoDescription }}">
    {% if site_settings.ogImageUrl %}
    <meta name="twitter:image"       content="{{ site_settings.baseUrl }}{{ site_settings.ogImageUrl }}">
    {% endif %}

    {# ── Schema.org JSON-LD ── #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "BiblioMap",
        "description": "{{ site_settings.seoDescription|replace({'"': '\\"'}) }}",
        "url": "{{ site_settings.baseUrl }}/",
        "applicationCategory": "ResearchApplication",
        "operatingSystem": "Web"
    }
    </script>

    {# ── Google Analytics ── #}
    {% if site_settings.googleAnalyticsId %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site_settings.googleAnalyticsId }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ site_settings.googleAnalyticsId }}');
    </script>
    {% endif %}

    {# ── Fonts (preload critical) ── #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg:       #060b14;
            --surface:  #0d1520;
            --card:     #111827;
            --border:   #1e2d45;
            --text:     #e2e8f0;
            --muted:    #64748b;
            --accent:   #3b82f6;
            --accent2:  #8b5cf6;
            --success:  #10b981;
            --gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #06b6d4 100%);
        }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

        /* ── Noise texture overlay ── */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 0;
        }

        /* ── Navbar — hero-state + sticky shrink ── */
        nav {
            --nav-h:       96px;   /* hero height */
            --nav-logo-sz: 52px;   /* hero logo size */
            --nav-name-sz: 22px;   /* hero wordmark size */
            --nav-btn-pad: 9px 22px;
            --nav-bg:      transparent;
            --nav-blur:    0px;
            --nav-border:  transparent;

            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            height: var(--nav-h);
            padding: 0 max(24px, calc((100% - 1200px)/2));
            display: flex; align-items: center; justify-content: space-between;
            background: var(--nav-bg);
            backdrop-filter: blur(var(--nav-blur));
            border-bottom: 1px solid var(--nav-border);
            transition:
                height            .4s cubic-bezier(.4,0,.2,1),
                background        .4s cubic-bezier(.4,0,.2,1),
                backdrop-filter   .4s cubic-bezier(.4,0,.2,1),
                border-color      .4s cubic-bezier(.4,0,.2,1),
                box-shadow        .4s cubic-bezier(.4,0,.2,1);
        }
        nav.scrolled {
            --nav-h:       62px;
            --nav-logo-sz: 34px;
            --nav-name-sz: 17px;
            --nav-btn-pad: 7px 18px;
            --nav-bg:      rgba(6,11,20,.92);
            --nav-blur:    20px;
            --nav-border:  rgba(30,45,69,.7);
            box-shadow: 0 4px 32px rgba(0,0,0,.4);
        }

        /* Logo link */
        .nav-logo {
            display: flex; align-items: center; gap: 12px;
            text-decoration: none;
            animation: navEntryLeft .6s .05s cubic-bezier(.4,0,.2,1) both;
        }
        .nav-logo img {
            width:  var(--nav-logo-sz);
            height: var(--nav-logo-sz);
            border-radius: 12px;
            transition: width .4s cubic-bezier(.4,0,.2,1),
                        height .4s cubic-bezier(.4,0,.2,1),
                        border-radius .4s cubic-bezier(.4,0,.2,1);
            will-change: width, height;
        }
        nav.scrolled .nav-logo img { border-radius: 9px; }
        .nav-logo-text {
            font-size: var(--nav-name-sz);
            font-weight: 800;
            color: var(--text);
            letter-spacing: -.4px;
            transition: font-size .4s cubic-bezier(.4,0,.2,1);
            will-change: font-size;
        }
        .nav-logo-sub {
            display: block;
            font-size: 11px;
            font-weight: 500;
            color: var(--muted);
            letter-spacing: .4px;
            text-transform: uppercase;
            margin-top: 1px;
            overflow: hidden;
            max-height: 16px;
            opacity: 1;
            transition: max-height .35s ease, opacity .3s ease, margin-top .35s ease;
        }
        nav.scrolled .nav-logo-sub {
            max-height: 0;
            opacity: 0;
            margin-top: 0;
        }

        /* Nav actions */
        .nav-actions {
            display: flex; align-items: center; gap: 12px;
            animation: navEntryRight .6s .15s cubic-bezier(.4,0,.2,1) both;
        }
        .btn-nav-outline {
            padding: var(--nav-btn-pad);
            border-radius: 9px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--muted);
            font-size: 13.5px; font-weight: 500;
            text-decoration: none;
            transition: all .2s, padding .4s cubic-bezier(.4,0,.2,1);
        }
        .btn-nav-outline:hover { border-color: var(--accent); color: var(--accent); background: rgba(59,130,246,.06); }
        .btn-nav-primary {
            padding: var(--nav-btn-pad);
            border-radius: 9px;
            background: var(--gradient); border: none;
            color: white; font-size: 13.5px; font-weight: 700;
            text-decoration: none;
            transition: opacity .2s, transform .1s, padding .4s cubic-bezier(.4,0,.2,1),
                        box-shadow .3s;
            box-shadow: 0 0 0 0 rgba(59,130,246,0);
        }
        .btn-nav-primary:hover {
            opacity: .9; transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(59,130,246,.35);
        }
        nav.scrolled .btn-nav-primary {
            box-shadow: 0 2px 14px rgba(59,130,246,.25);
        }

        /* Entry keyframes */
        @keyframes navEntryLeft  { from { opacity:0; transform:translateX(-24px) } to { opacity:1; transform:none } }
        @keyframes navEntryRight { from { opacity:0; transform:translateX( 24px) } to { opacity:1; transform:none } }

        /* ── Hero ── */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex; align-items: center;
            padding: 100px max(24px, calc((100% - 1200px)/2)) 80px;
            overflow: hidden;
        }
        .hero-bg {
            position: absolute; inset: 0; z-index: 0;
            background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(59,130,246,.15) 0%, transparent 70%),
                        radial-gradient(ellipse 60% 40% at 90% 50%, rgba(139,92,246,.1) 0%, transparent 60%),
                        radial-gradient(ellipse 40% 40% at 10% 80%, rgba(6,182,212,.08) 0%, transparent 60%);
        }
        .hero-grid {
            position: absolute; inset: 0; z-index: 0;
            background-image: linear-gradient(rgba(30,45,69,.3) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(30,45,69,.3) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, black, transparent);
        }
        .hero-content { position: relative; z-index: 1; max-width: 680px; }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 16px; border-radius: 20px;
            background: rgba(59,130,246,.1);
            border: 1px solid rgba(59,130,246,.25);
            color: #60a5fa; font-size: 12.5px; font-weight: 600;
            margin-bottom: 28px;
            animation: fadeDown .5s ease both;
        }
        .hero-badge i { font-size: 14px; }
        h1.hero-title {
            font-size: clamp(38px, 6vw, 64px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -1.5px;
            margin-bottom: 24px;
            animation: fadeDown .5s .1s ease both;
        }
        .gradient-text {
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-desc {
            font-size: 17px;
            color: var(--muted);
            line-height: 1.75;
            margin-bottom: 36px;
            max-width: 560px;
            animation: fadeDown .5s .2s ease both;
        }
        .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; animation: fadeDown .5s .3s ease both; }
        .btn-primary {
            padding: 13px 30px; border-radius: 10px;
            background: var(--gradient); border: none;
            color: white; font-size: 15px; font-weight: 700;
            text-decoration: none; transition: opacity .2s, transform .1s, box-shadow .2s;
            box-shadow: 0 4px 24px rgba(59,130,246,.3);
        }
        .btn-primary:hover { opacity: .9; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(59,130,246,.4); }
        .btn-secondary {
            padding: 13px 30px; border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,.03);
            color: var(--text); font-size: 15px; font-weight: 600;
            text-decoration: none; transition: all .2s;
            backdrop-filter: blur(8px);
        }
        .btn-secondary:hover { border-color: var(--accent); color: var(--accent); background: rgba(59,130,246,.05); }

        /* ── Stats strip ── */
        .hero-stats {
            display: flex; gap: 32px; flex-wrap: wrap;
            margin-top: 48px;
            padding-top: 32px;
            border-top: 1px solid var(--border);
            animation: fadeDown .5s .4s ease both;
        }
        .stat-item { }
        .stat-value { font-size: 26px; font-weight: 800; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .stat-label { font-size: 12px; color: var(--muted); margin-top: 2px; font-weight: 500; }

        /* ── Floating network preview ── */
        .hero-visual {
            position: absolute;
            right: max(24px, calc((100% - 1200px)/2));
            top: 50%;
            transform: translateY(-50%);
            z-index: 1;
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float { 0%,100%{transform:translateY(-50%) translateY(0)} 50%{transform:translateY(-50%) translateY(-18px)} }
        .network-preview {
            width: 440px; height: 360px;
            background: rgba(13,21,32,.8);
            border: 1px solid var(--border);
            border-radius: 16px;
            backdrop-filter: blur(20px);
            overflow: hidden;
            position: relative;
        }
        .network-preview canvas { width: 100%; height: 100%; }
        .preview-overlay {
            position: absolute; bottom: 0; left: 0; right: 0;
            padding: 16px;
            background: linear-gradient(transparent, rgba(6,11,20,.9));
            font-size: 12px; color: var(--muted); text-align: center;
        }

        /* ── Section wrapper ── */
        .section {
            padding: 80px max(24px, calc((100% - 1200px)/2));
            position: relative;
        }
        .section-title {
            font-size: clamp(26px, 4vw, 38px);
            font-weight: 800;
            letter-spacing: -.8px;
            margin-bottom: 12px;
        }
        .section-subtitle {
            font-size: 16px;
            color: var(--muted);
            line-height: 1.7;
            max-width: 560px;
        }

        /* ── Features grid ── */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 48px;
        }
        .feature-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 28px;
            transition: all .25s;
            position: relative;
            overflow: hidden;
        }
        .feature-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 2px;
            background: var(--gradient);
            opacity: 0;
            transition: opacity .25s;
        }
        .feature-card:hover { border-color: rgba(59,130,246,.4); transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,.3); }
        .feature-card:hover::before { opacity: 1; }
        .feature-icon {
            width: 48px; height: 48px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; margin-bottom: 18px;
        }
        .feature-title { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
        .feature-desc  { font-size: 13.5px; color: var(--muted); line-height: 1.65; }

        /* ── How it works ── */
        .how-steps { display: flex; flex-direction: column; gap: 0; margin-top: 48px; max-width: 640px; }
        .how-step {
            display: flex; gap: 24px; position: relative;
            padding-bottom: 32px;
        }
        .how-step:last-child { padding-bottom: 0; }
        .how-step::before {
            content: '';
            position: absolute;
            left: 19px; top: 44px;
            width: 2px;
            height: calc(100% - 44px);
            background: linear-gradient(var(--border), transparent);
        }
        .how-step:last-child::before { display: none; }
        .step-circle {
            width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
            background: var(--gradient);
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; font-weight: 800; color: white;
        }
        .how-step-body h3 { font-size: 16px; font-weight: 700; margin-bottom: 6px; padding-top: 7px; }
        .how-step-body p  { font-size: 13.5px; color: var(--muted); line-height: 1.65; }

        /* ── CTA Section ── */
        .cta-section {
            padding: 80px max(24px, calc((100% - 1200px)/2));
            text-align: center;
        }
        .cta-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 60px 40px;
            position: relative;
            overflow: hidden;
        }
        .cta-card::before {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(59,130,246,.08) 0%, transparent 70%);
        }
        .cta-card > * { position: relative; z-index: 1; }
        .cta-title { font-size: clamp(24px, 4vw, 38px); font-weight: 800; letter-spacing: -.8px; margin-bottom: 16px; }
        .cta-desc  { font-size: 16px; color: var(--muted); max-width: 520px; margin: 0 auto 32px; line-height: 1.7; }
        .moderation-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 20px; border-radius: 12px;
            background: rgba(245,158,11,.08);
            border: 1px solid rgba(245,158,11,.25);
            color: #fbbf24; font-size: 13px; font-weight: 600;
            margin-top: 20px;
        }

        /* ── Footer ── */
        footer {
            padding: 32px max(24px, calc((100% - 1200px)/2));
            border-top: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 16px;
            color: var(--muted); font-size: 13px;
        }
        .footer-logo { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); }

        /* ── Animations ── */
        @keyframes fadeDown { from { opacity:0; transform:translateY(-16px) } to { opacity:1; transform:none } }
        @keyframes fadeUp   { from { opacity:0; transform:translateY(16px) }  to { opacity:1; transform:none } }

        /* ── Responsive ── */
        @media (max-width: 900px) {
            .hero-visual { display: none; }
            .hero { padding-right: max(24px, calc((100% - 1200px)/2)); }
        }
        @media (max-width: 600px) {
            .hero-title { font-size: 34px; }
            .hero-cta { flex-direction: column; }
            .btn-primary, .btn-secondary { text-align: center; }
            .hero-stats { gap: 20px; }
        }
    </style>
</head>
<body>

{# ── Navbar ── #}
<nav id="mainNav">
    <a href="/" class="nav-logo">
        <img src="/logo.svg" alt="BiblioMap">
        <div>
            <span class="nav-logo-text">BiblioMap</span>
            <span class="nav-logo-sub">Plataforma Bibliom&eacute;trica</span>
        </div>
    </a>
    <div class="nav-actions">
        <a href="{{ path('app_login') }}" class="btn-nav-outline">Entrar</a>
        <a href="{{ path('app_register') }}" class="btn-nav-primary">
            <i class="bi bi-person-plus" style="margin-right:6px"></i>Criar conta
        </a>
    </div>
</nav>

{# ── Hero ── #}
<section class="hero" id="inicio">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>

    <div class="hero-content">
        <div class="hero-badge">
            <i class="bi bi-stars"></i>
            Plataforma Bibliométrica Avançada
        </div>

        <h1 class="hero-title">
            Mapeie a<br>
            <span class="gradient-text">ciência</span> com<br>
            precisão total.
        </h1>

        <p class="hero-desc">
            O <strong>BiblioMap</strong> transforma bases de dados bibliográficas em visualizações
            poderosas — redes de coautoria, mapas temáticos, evolução de palavras-chave e muito mais.
        </p>

        <div class="hero-cta">
            <a href="{{ path('app_register') }}" class="btn-primary">
                <i class="bi bi-person-plus me-2"></i>Criar conta gratuita
            </a>
            <a href="#como-funciona" class="btn-secondary">
                <i class="bi bi-play-circle me-2"></i>Como funciona
            </a>
        </div>

        <div class="hero-stats">
            <div class="stat-item">
                <div class="stat-value">+20</div>
                <div class="stat-label">Tipos de análise</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">WoS</div>
                <div class="stat-label">Scopus &amp; Web of Science</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">100%</div>
                <div class="stat-label">Web — sem instalar nada</div>
            </div>
        </div>
    </div>

    {# Floating network preview #}
    <div class="hero-visual" aria-hidden="true">
        <div class="network-preview">
            <canvas id="networkCanvas" width="440" height="360"></canvas>
            <div class="preview-overlay">Rede de coautoria — exemplo interativo</div>
        </div>
    </div>
</section>

{# ── Features ── #}
<section class="section" id="funcionalidades">
    <div style="max-width:640px">
        <p style="color:var(--accent);font-size:13px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;margin-bottom:12px">Funcionalidades</p>
        <h2 class="section-title">Tudo que você precisa<br><span class="gradient-text">em uma plataforma</span></h2>
        <p class="section-subtitle">Importe seus dados, normalize autores e instituições, e gere análises completas em minutos.</p>
    </div>

    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(59,130,246,.12)">🗃️</div>
            <div class="feature-title">Importação Inteligente</div>
            <div class="feature-desc">Importe arquivos do Scopus e Web of Science. Detecção automática de duplicatas e normalização de campos.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(139,92,246,.12)">🕸️</div>
            <div class="feature-title">Redes de Coautoria</div>
            <div class="feature-desc">Visualize redes interativas de coautoria, co-ocorrência de palavras-chave e cocitação de documentos.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(16,185,129,.12)">🗺️</div>
            <div class="feature-title">Mapas Temáticos</div>
            <div class="feature-desc">Identifique clusters temáticos, temas emergentes e a evolução do campo científico ao longo do tempo.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(245,158,11,.12)">📊</div>
            <div class="feature-title">Análises Estatísticas</div>
            <div class="feature-desc">Produção anual, ranking de autores, fontes, instituições, países e evolução de palavras-chave.</div>
        </div>
        <div class="feature-card">
