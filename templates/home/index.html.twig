<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Favicon & Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg">
    <meta name="theme-color" content="#060b14">
    {# Marca que o JS está ativo antes da pintura: só então a vitrine esconde o que vai animar #}
    <script>document.documentElement.classList.add('js');</script>

    {# ── SEO ── #}
    <title>{{ site_settings.seoTitle }}</title>
    <meta name="description" content="{{ site_settings.seoDescription }}">
    <meta name="keywords"    content="{{ site_settings.seoKeywords }}">
    <link rel="canonical"    href="{{ site_settings.baseUrl }}/">

    {# ── Open Graph ── #}
    <meta property="og:type"        content="website">
    <meta property="og:url"         content="{{ site_settings.baseUrl }}/">
    <meta property="og:title"       content="{{ site_settings.seoTitle }}">
    <meta property="og:description" content="{{ site_settings.seoDescription }}">
    {% if site_settings.ogImageUrl %}
    <meta property="og:image"       content="{{ site_settings.baseUrl }}{{ site_settings.ogImageUrl }}">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    {% endif %}

    {# ── Twitter Card ── #}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="{{ site_settings.seoTitle }}">
    <meta name="twitter:description" content="{{ site_settings.seoDescription }}">
    {% if site_settings.ogImageUrl %}
    <meta name="twitter:image"       content="{{ site_settings.baseUrl }}{{ site_settings.ogImageUrl }}">
    {% endif %}

    {# ── Schema.org JSON-LD ── #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "BiblioMap",
        "description": "{{ site_settings.seoDescription|replace({'"': '\\"'}) }}",
        "url": "{{ site_settings.baseUrl }}/",
        "applicationCategory": "ResearchApplication",
        "operatingSystem": "Web"
    }
    </script>

    {# ── Google Analytics ── #}
    {% if site_settings.googleAnalyticsId %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ site_settings.googleAnalyticsId }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ site_settings.googleAnalyticsId }}');
    </script>
    {% endif %}

    {# ── Fonts (preload critical) ── #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg:       #060b14;
            --surface:  #0d1520;
            --card:     #111827;
            --border:   #1e2d45;
            --text:     #e2e8f0;
            --muted:    #94a3b8; /* contraste AA sobre --bg, --surface e --card */
            --accent:   #3b82f6;
            --accent2:  #8b5cf6;
            --success:  #10b981;
            --gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #06b6d4 100%);
        }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

        /* ── Noise texture overlay ── */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 0;
        }

        /* ── Navbar — hero-state + sticky shrink ── */
        nav {
            --nav-h:       96px;   /* hero height */
            --nav-logo-sz: 52px;   /* hero logo size */
            --nav-name-sz: 22px;   /* hero wordmark size */
            --nav-btn-pad: 9px 22px;
            --nav-bg:      transparent;
            --nav-blur:    0px;
            --nav-border:  transparent;

            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            height: var(--nav-h);
            padding: 0 max(24px, calc((100% - 1200px)/2));
            display: flex; align-items: center; justify-content: space-between;
            background: var(--nav-bg);
            backdrop-filter: blur(var(--nav-blur));
            border-bottom: 1px solid var(--nav-border);
            transition:
                height            .4s cubic-bezier(.4,0,.2,1),
                background        .4s cubic-bezier(.4,0,.2,1),
                backdrop-filter   .4s cubic-bezier(.4,0,.2,1),
                border-color      .4s cubic-bezier(.4,0,.2,1),
                box-shadow        .4s cubic-bezier(.4,0,.2,1);
        }
        nav.scrolled {
            --nav-h:       62px;
            --nav-logo-sz: 34px;
            --nav-name-sz: 17px;
            --nav-btn-pad: 7px 18px;
            --nav-bg:      rgba(6,11,20,.92);
            --nav-blur:    20px;
            --nav-border:  rgba(30,45,69,.7);
            box-shadow: 0 4px 32px rgba(0,0,0,.4);
        }

        /* Logo link */
        .nav-logo {
            display: flex; align-items: center; gap: 12px;
            text-decoration: none;
            animation: navEntryLeft .6s .05s cubic-bezier(.4,0,.2,1) both;
        }
        .nav-logo img {
            width:  var(--nav-logo-sz);
            height: var(--nav-logo-sz);
            border-radius: 12px;
            transition: width .4s cubic-bezier(.4,0,.2,1),
                        height .4s cubic-bezier(.4,0,.2,1),
                        border-radius .4s cubic-bezier(.4,0,.2,1);
            will-change: width, height;
        }
        nav.scrolled .nav-logo img { border-radius: 9px; }
        .nav-logo-text {
            font-size: var(--nav-name-sz);
            font-weight: 800;
            color: var(--text);
            letter-spacing: -.4px;
            transition: font-size .4s cubic-bezier(.4,0,.2,1);
            will-change: font-size;
        }
        .nav-logo-sub {
            display: block;
            font-size: 11px;
            font-weight: 500;
            color: var(--muted);
            letter-spacing: .4px;
            text-transform: uppercase;
            margin-top: 1px;
            overflow: hidden;
            max-height: 16px;
            opacity: 1;
            transition: max-height .35s ease, opacity .3s ease, margin-top .35s ease;
        }
        nav.scrolled .nav-logo-sub {
            max-height: 0;
            opacity: 0;
            margin-top: 0;
        }

        /* Nav actions */
        .nav-actions {
            display: flex; align-items: center; gap: 12px;
            animation: navEntryRight .6s .15s cubic-bezier(.4,0,.2,1) both;
        }
        .btn-nav-outline {
            padding: var(--nav-btn-pad);
            border-radius: 9px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--muted);
            font-size: 13.5px; font-weight: 500;
            text-decoration: none;
            transition: all .2s, padding .4s cubic-bezier(.4,0,.2,1);
        }
        .btn-nav-outline:hover { border-color: var(--accent); color: var(--accent); background: rgba(59,130,246,.06); }
        .btn-nav-primary {
            padding: var(--nav-btn-pad);
            border-radius: 9px;
            background: var(--gradient); border: none;
            color: white; font-size: 13.5px; font-weight: 700;
            text-decoration: none;
            transition: opacity .2s, transform .1s, padding .4s cubic-bezier(.4,0,.2,1),
                        box-shadow .3s;
            box-shadow: 0 0 0 0 rgba(59,130,246,0);
        }
        .btn-nav-primary:hover {
            opacity: .9; transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(59,130,246,.35);
        }
        nav.scrolled .btn-nav-primary {
            box-shadow: 0 2px 14px rgba(59,130,246,.25);
        }

        /* Entry keyframes */
        @keyframes navEntryLeft  { from { opacity:0; transform:translateX(-24px) } to { opacity:1; transform:none } }
        @keyframes navEntryRight { from { opacity:0; transform:translateX( 24px) } to { opacity:1; transform:none } }

        /* ── Hero ── */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex; align-items: center;
            padding: 100px max(24px, calc((100% - 1200px)/2)) 80px;
            overflow: hidden;
        }
        .hero-bg {
            position: absolute; inset: 0; z-index: 0;
            background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(59,130,246,.15) 0%, transparent 70%),
                        radial-gradient(ellipse 60% 40% at 90% 50%, rgba(139,92,246,.1) 0%, transparent 60%),
                        radial-gradient(ellipse 40% 40% at 10% 80%, rgba(6,182,212,.08) 0%, transparent 60%);
        }
        .hero-grid {
            position: absolute; inset: 0; z-index: 0;
            background-image: linear-gradient(rgba(30,45,69,.3) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(30,45,69,.3) 1px, transparent 1px);
            background-size: 48px 48px;
            mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, black, transparent);
        }
        .hero-content { position: relative; z-index: 1; max-width: 680px; }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 16px; border-radius: 20px;
            background: rgba(59,130,246,.1);
            border: 1px solid rgba(59,130,246,.25);
            color: #60a5fa; font-size: 12.5px; font-weight: 600;
            margin-bottom: 28px;
            animation: fadeDown .5s ease both;
        }
        .hero-badge i { font-size: 14px; }
        h1.hero-title {
            font-size: clamp(38px, 6vw, 64px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -1.5px;
            margin-bottom: 24px;
            animation: fadeDown .5s .1s ease both;
        }
        .gradient-text {
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-desc {
            font-size: 17px;
            color: var(--muted);
            line-height: 1.75;
            margin-bottom: 36px;
            max-width: 560px;
            animation: fadeDown .5s .2s ease both;
        }
        .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; animation: fadeDown .5s .3s ease both; }
        .btn-primary {
            padding: 13px 30px; border-radius: 10px;
            background: var(--gradient); border: none;
            color: white; font-size: 15px; font-weight: 700;
            text-decoration: none; transition: opacity .2s, transform .1s, box-shadow .2s;
            box-shadow: 0 4px 24px rgba(59,130,246,.3);
        }
        .btn-primary:hover { opacity: .9; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(59,130,246,.4); }
        .btn-secondary {
            padding: 13px 30px; border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,.03);
            color: var(--text); font-size: 15px; font-weight: 600;
            text-decoration: none; transition: all .2s;
            backdrop-filter: blur(8px);
        }
        .btn-secondary:hover { border-color: var(--accent); color: var(--accent); background: rgba(59,130,246,.05); }

        /* ── Stats strip ── */
        .hero-stats {
            display: flex; gap: 32px; flex-wrap: wrap;
            margin-top: 48px;
            padding-top: 32px;
            border-top: 1px solid var(--border);
            animation: fadeDown .5s .4s ease both;
        }
        .stat-item { }
        .stat-value { font-size: 26px; font-weight: 800; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .stat-label { font-size: 12px; color: var(--muted); margin-top: 2px; font-weight: 500; }

        /* ── Floating network preview ── */
        .hero-visual {
            position: absolute;
            right: max(24px, calc((100% - 1200px)/2));
            top: 50%;
            transform: translateY(-50%);
            z-index: 1;
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float { 0%,100%{transform:translateY(-50%) translateY(0)} 50%{transform:translateY(-50%) translateY(-18px)} }
        .network-preview {
            width: 440px; height: 360px;
            background: rgba(13,21,32,.8);
            border: 1px solid var(--border);
            border-radius: 16px;
            backdrop-filter: blur(20px);
            overflow: hidden;
            position: relative;
        }
        .network-preview canvas { width: 100%; height: 100%; }
        .preview-overlay {
            position: absolute; bottom: 0; left: 0; right: 0;
            padding: 16px;
            background: linear-gradient(transparent, rgba(6,11,20,.9));
            font-size: 12px; color: var(--muted); text-align: center;
        }

        /* ── Section wrapper ── */
        .section {
            padding: 80px max(24px, calc((100% - 1200px)/2));
            position: relative;
        }
        .section-title {
            font-size: clamp(26px, 4vw, 38px);
            font-weight: 800;
            letter-spacing: -.8px;
            margin-bottom: 12px;
        }
        .section-subtitle {
            font-size: 16px;
            color: var(--muted);
            line-height: 1.7;
            max-width: 560px;
        }

        /* ── Features grid ── */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 48px;
        }
        .feature-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 28px;
            transition: all .25s;
            position: relative;
            overflow: hidden;
        }
        .feature-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 2px;
            background: var(--gradient);
            opacity: 0;
            transition: opacity .25s;
        }
        .feature-card:hover { border-color: rgba(59,130,246,.4); transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,.3); }
        .feature-card:hover::before { opacity: 1; }
        .feature-icon {
            width: 48px; height: 48px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; margin-bottom: 18px;
        }
        .feature-title { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
        .feature-desc  { font-size: 13.5px; color: var(--muted); line-height: 1.65; }

        /* ── How it works ── */
        .how-steps { display: flex; flex-direction: column; gap: 0; margin-top: 48px; max-width: 640px; }
        .how-step {
            display: flex; gap: 24px; position: relative;
            padding-bottom: 32px;
        }
        .how-step:last-child { padding-bottom: 0; }
        .how-step::before {
            content: '';
            position: absolute;
            left: 19px; top: 44px;
            width: 2px;
            height: calc(100% - 44px);
            background: linear-gradient(var(--border), transparent);
        }
        .how-step:last-child::before { display: none; }
        .step-circle {
            width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
            background: var(--gradient);
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; font-weight: 800; color: white;
        }
        .how-step-body h3 { font-size: 16px; font-weight: 700; margin-bottom: 6px; padding-top: 7px; }
        .how-step-body p  { font-size: 13.5px; color: var(--muted); line-height: 1.65; }

        /* ── CTA Section ── */
        .cta-section {
            padding: 80px max(24px, calc((100% - 1200px)/2));
            text-align: center;
        }
        .cta-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 60px 40px;
            position: relative;
            overflow: hidden;
        }
        .cta-card::before {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(59,130,246,.08) 0%, transparent 70%);
        }
        .cta-card > * { position: relative; z-index: 1; }
        .cta-title { font-size: clamp(24px, 4vw, 38px); font-weight: 800; letter-spacing: -.8px; margin-bottom: 16px; }
        .cta-desc  { font-size: 16px; color: var(--muted); max-width: 520px; margin: 0 auto 32px; line-height: 1.7; }
        .moderation-badge {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 20px; border-radius: 12px;
            background: rgba(245,158,11,.08);
            border: 1px solid rgba(245,158,11,.25);
            color: #fbbf24; font-size: 13px; font-weight: 600;
            margin-top: 20px;
        }

        /* ── Footer ── */
        footer {
            padding: 32px max(24px, calc((100% - 1200px)/2));
            border-top: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 16px;
            color: var(--muted); font-size: 13px;
        }
        .footer-logo { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); }

        /* ── Como funciona: duas colunas que viram uma no celular ── */
        .how-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }

        /* ── Menu: link para a vitrine ── */
        .nav-link-plain {
            color: var(--muted); font-size: 13.5px; font-weight: 500;
            text-decoration: none; padding: 8px 6px; transition: color .2s;
        }
        .nav-link-plain:hover { color: var(--text); }

        /* ── Vitrine de recursos ── */
        .eyebrow { color: var(--accent); font-size: 13px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; margin-bottom: 12px; }
        .showcase { padding-top: 96px; scroll-margin-top: 40px; }
        .showcase::before {
            content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
            background: radial-gradient(ellipse 70% 30% at 15% 0%, rgba(139,92,246,.08) 0%, transparent 70%),
                        radial-gradient(ellipse 60% 25% at 90% 35%, rgba(6,182,212,.06) 0%, transparent 70%);
        }
        .showcase-head { max-width: 760px; }
        .showcase-head .section-subtitle { max-width: 680px; }
        .showcase-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
        .showcase-stats span {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 14px; border-radius: 20px; font-size: 12.5px; font-weight: 600;
            color: var(--text); background: rgba(255,255,255,.03); border: 1px solid var(--border);
        }
        .showcase-stats i { color: #a5b4fc; }

        .showcase-filter {
            position: sticky; top: 62px; z-index: 50;
            display: flex; gap: 3px; overflow-x: auto; scrollbar-width: none;
            margin-top: 36px; padding: 8px;
            background: rgba(9,15,26,.92); backdrop-filter: blur(16px);
            border: 1px solid var(--border); border-radius: 0 0 14px 14px;
            box-shadow: 0 12px 32px rgba(0,0,0,.35);
        }
        .showcase-filter::-webkit-scrollbar { display: none; }
        .chip {
            flex: 0 0 auto; display: inline-flex; align-items: center; gap: 7px;
            padding: 8px 11px; border-radius: 10px; border: 1px solid transparent;
            color: var(--muted); font-size: 12.5px; font-weight: 600; white-space: nowrap;
            text-decoration: none; cursor: pointer; transition: color .2s, background .2s, border-color .2s;
        }
        .chip:hover { color: var(--text); background: rgba(255,255,255,.04); }
        .chip:focus-visible, .window-shot:focus-visible, .variant:focus-visible, .lightbox-close:focus-visible {
            outline: 2px solid #60a5fa; outline-offset: 2px;
        }
        .chip .chip-count { font-size: 11px; padding: 1px 7px; border-radius: 20px; background: rgba(148,163,184,.14); color: var(--text); }
        .chip.is-active {
            color: #fff; border-color: rgba(99,102,241,.5);
            background: linear-gradient(135deg, rgba(59,130,246,.28), rgba(139,92,246,.28));
        }

        .showcase-category { margin-top: 80px; scroll-margin-top: 140px; }
        .showcase-category[hidden] { display: none; }
        .category-head {
            display: flex; align-items: center; gap: 18px;
            padding-bottom: 22px; margin-bottom: 52px; border-bottom: 1px solid var(--border);
        }
        .category-icon {
            width: 52px; height: 52px; flex-shrink: 0; border-radius: 14px;
            display: grid; place-items: center; font-size: 23px; color: #a5b4fc;
            background: linear-gradient(135deg, rgba(59,130,246,.18), rgba(139,92,246,.18));
            border: 1px solid rgba(99,102,241,.35);
        }
        .category-head h3 { font-size: clamp(20px, 3vw, 26px); font-weight: 800; letter-spacing: -.4px; }
        .category-head p { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin-top: 4px; }
        .category-count {
            margin-left: auto; white-space: nowrap; color: var(--muted);
            font-size: 12px; font-weight: 600; padding: 6px 12px; border: 1px solid var(--border); border-radius: 20px;
        }

        .resource {
            display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 52px; align-items: start; scroll-margin-top: 150px;
        }
        .resource + .resource { margin-top: 64px; padding-top: 64px; border-top: 1px dashed rgba(30,45,69,.7); }
        .resource.is-reversed { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
        .resource.is-reversed .resource-media { order: 2; }

        .window {
            background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden;
            box-shadow: 0 24px 60px rgba(0,0,0,.45);
            transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s, border-color .35s;
        }
        .window:hover { transform: translateY(-4px); border-color: rgba(99,102,241,.5); box-shadow: 0 32px 70px rgba(0,0,0,.5), 0 0 48px rgba(59,130,246,.12); }
        .window-bar {
            display: flex; align-items: center; gap: 6px; min-width: 0;
            padding: 10px 14px; background: #0b1220; border-bottom: 1px solid var(--border);
        }
        .window-bar span { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; background: #334155; }
        .window-bar span:nth-child(1) { background: rgba(239,68,68,.7); }
        .window-bar span:nth-child(2) { background: rgba(245,158,11,.7); }
        .window-bar span:nth-child(3) { background: rgba(16,185,129,.7); }
        .window-bar em {
            font-style: normal; font-size: 11.5px; color: var(--muted); margin-left: 10px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .window-shot { display: block; position: relative; cursor: zoom-in; background: #0b1220; }
        .window-shot img { display: block; width: 100%; height: auto; }
        .zoom-hint {
            position: absolute; right: 12px; bottom: 12px;
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #fff;
            background: rgba(6,11,20,.82); border: 1px solid rgba(148,163,184,.3);
            opacity: 0; transform: translateY(4px); transition: opacity .25s, transform .25s;
        }
        .window-shot:hover .zoom-hint, .window-shot:focus-visible .zoom-hint { opacity: 1; transform: none; }
        .window figcaption { padding: 10px 14px; font-size: 12.5px; line-height: 1.5; color: var(--muted); border-top: 1px solid var(--border); }

        .variants { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; margin-top: 14px; }
        .variant {
            display: block; height: 100%; text-decoration: none; overflow: hidden;
            border: 1px solid var(--border); border-radius: 10px; background: var(--card);
            transition: border-color .2s, box-shadow .2s;
        }
        .variant img { display: block; width: 100%; height: 72px; object-fit: cover; object-position: top left; opacity: .6; transition: opacity .2s; }
        .variant span {
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
            margin: 6px 9px 7px; font-size: 11.5px; line-height: 1.4; color: var(--muted);
        }
        .variant:hover img, .variant.is-active img { opacity: 1; }
        .variant.is-active { border-color: rgba(99,102,241,.65); box-shadow: 0 0 0 1px rgba(99,102,241,.45); }
        .variant.is-active span { color: var(--text); }

        .where {
            display: inline-flex; align-items: center; gap: 7px; max-width: 100%;
            padding: 5px 12px; margin-bottom: 14px; border-radius: 20px;
            font-size: 12px; font-weight: 600; color: #93c5fd;
            background: rgba(59,130,246,.1); border: 1px solid rgba(59,130,246,.28);
        }
        .resource-text h4 { font-size: clamp(21px, 2.6vw, 27px); font-weight: 800; letter-spacing: -.5px; line-height: 1.2; margin-bottom: 10px; }
        .resource-text .lead { font-size: 15.5px; line-height: 1.7; color: #cbd5e1; margin-bottom: 24px; }
        .facts { display: grid; gap: 18px; margin-bottom: 22px; }
        .facts dt {
            display: flex; align-items: center; gap: 8px; margin-bottom: 5px;
            font-size: 12px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--text);
        }
        .facts dt i { font-size: 14px; }
        .facts .f-mostra i { color: #60a5fa; }
        .facts .f-como i { color: #a78bfa; }
        .facts .f-porque i { color: #22d3ee; }
        .facts dd { font-size: 14px; line-height: 1.7; color: var(--muted); }
        .resource-text strong { color: var(--text); font-weight: 600; }
        .example {
            padding: 16px 18px; border-radius: 12px; border: 1px solid transparent;
            background: linear-gradient(var(--card), var(--card)) padding-box, var(--gradient) border-box;
        }
        .example-label {
            display: flex; align-items: center; gap: 8px; margin-bottom: 6px;
            font-size: 12px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: #fbbf24;
        }
        .example p { font-size: 14px; line-height: 1.7; color: #cbd5e1; }
        .exports { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 16px; font-size: 12px; color: var(--muted); }
        .exports .exports-label { margin-right: 4px; }
        .exports .tag {
            padding: 3px 10px; border-radius: 6px; font-size: 11.5px; font-weight: 600;
            color: var(--text); background: rgba(255,255,255,.03); border: 1px solid var(--border);
        }

        /* Entrada suave ao rolar (só com JS ativo e sem preferência por menos movimento) */
        .js .reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
        .js .reveal.is-visible { opacity: 1; transform: none; }

        /* Imagem ampliada */
        .lightbox { border: none; padding: 0; margin: auto; background: transparent; max-width: 96vw; max-height: 94vh; overflow: visible; }
        .lightbox::backdrop { background: rgba(3,7,14,.9); backdrop-filter: blur(6px); }
        .lightbox figure { display: flex; flex-direction: column; align-items: center; gap: 12px; }
        .lightbox img {
            display: block; max-width: min(1400px, 96vw); max-height: calc(94vh - 64px); width: auto; height: auto;
            border-radius: 12px; border: 1px solid var(--border); background: #0b1220; box-shadow: 0 30px 80px rgba(0,0,0,.6);
        }
        .lightbox figcaption { color: #cbd5e1; font-size: 14px; text-align: center; max-width: 900px; padding: 0 12px; }
        .lightbox-close {
            position: fixed; top: 18px; right: 18px; width: 44px; height: 44px; border-radius: 50%;
            display: grid; place-items: center; font-size: 17px; cursor: pointer;
            color: var(--text); background: rgba(13,21,32,.92); border: 1px solid var(--border);
        }
        .lightbox-close:hover { border-color: var(--accent); color: #fff; }

        /* ── Animations ── */
        @keyframes fadeDown { from { opacity:0; transform:translateY(-16px) } to { opacity:1; transform:none } }
        @keyframes fadeUp   { from { opacity:0; transform:translateY(16px) }  to { opacity:1; transform:none } }

        /* ── Responsive ── */
        @media (max-width: 900px) {
            .hero-visual { display: none; }
            .hero { padding-right: max(24px, calc((100% - 1200px)/2)); }
            .how-grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
            .resource { grid-template-columns: minmax(0, 1fr); gap: 26px; }
            .resource.is-reversed .resource-media { order: 0; }
            .resource + .resource { margin-top: 48px; padding-top: 48px; }
            .category-count { display: none; }
            .showcase-category { margin-top: 64px; }
            .category-head { margin-bottom: 36px; }
        }
        @media (max-width: 600px) {
            .hero-title { font-size: 34px; }
            .hero-cta { flex-direction: column; }
            .btn-primary, .btn-secondary { text-align: center; }
            .hero-stats { gap: 20px; }
            .nav-link-plain { display: none; }
            nav, nav.scrolled { --nav-btn-pad: 7px 12px; }
            nav { --nav-logo-sz: 40px; --nav-name-sz: 18px; }
            .nav-logo { gap: 9px; }
            .nav-logo-sub { display: none; }
            .nav-actions { gap: 8px; }
            .btn-nav-outline, .btn-nav-primary { white-space: nowrap; font-size: 13px; }
            .btn-nav-primary i { display: none; }
            .showcase { padding-top: 72px; }
            .showcase-filter { border-radius: 0 0 12px 12px; }
            .category-head { align-items: flex-start; gap: 14px; }
            .category-icon { width: 44px; height: 44px; font-size: 20px; border-radius: 12px; }
            .variants { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .window-bar em { display: none; }
            .zoom-hint { display: none; }
        }
        @media (prefers-reduced-motion: reduce) {
            .js .reveal { opacity: 1; transform: none; transition: none; }
            .window, .window:hover { transform: none; transition: none; }
        }
    </style>
</head>
<body>

{# ── Navbar ── #}
<nav id="mainNav">
    <a href="/" class="nav-logo">
        <img src="/logo.svg" alt="BiblioMap">
        <div>
            <span class="nav-logo-text">BiblioMap</span>
