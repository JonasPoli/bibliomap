<script>
// ── Animated network canvas ──────────────────────────────────────────────────
(function() {
    const canvas = document.getElementById('networkCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;

    const nodes = Array.from({length: 22}, (_, i) => ({
        x: 30 + Math.random() * (W - 60),
        y: 30 + Math.random() * (H - 60),
        vx: (Math.random() - .5) * .4,
        vy: (Math.random() - .5) * .4,
        r: 3 + Math.random() * 5,
        color: ['#3b82f6','#8b5cf6','#06b6d4','#10b981'][i % 4],
    }));

    const edges = [];
    for (let i = 0; i < nodes.length; i++)
        for (let j = i+1; j < nodes.length; j++)
            if (Math.random() < .22) edges.push([i, j]);

    function draw() {
        ctx.clearRect(0, 0, W, H);

        // Edges
        edges.forEach(([a, b]) => {
            const na = nodes[a], nb = nodes[b];
            const dist = Math.hypot(na.x - nb.x, na.y - nb.y);
            const alpha = Math.max(0, 1 - dist / 200);
            ctx.beginPath();
            ctx.moveTo(na.x, na.y);
            ctx.lineTo(nb.x, nb.y);
            ctx.strokeStyle = `rgba(59,130,246,${alpha * .35})`;
            ctx.lineWidth = 1;
            ctx.stroke();
        });

        // Nodes
        nodes.forEach(n => {
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fillStyle = n.color;
            ctx.globalAlpha = .85;
            ctx.fill();
            ctx.globalAlpha = .3;
            ctx.strokeStyle = n.color;
            ctx.lineWidth = 2;
            ctx.stroke();
            ctx.globalAlpha = 1;
        });

        // Animate
        nodes.forEach(n => {
            n.x += n.vx; n.y += n.vy;
            if (n.x < n.r || n.x > W - n.r) n.vx *= -1;
            if (n.y < n.r || n.y > H - n.r) n.vy *= -1;
        });

        requestAnimationFrame(draw);
    }
    draw();
})();

// ── Navbar: hero-state → sticky-compact on scroll ───────────────────────────
(function () {
    const nav       = document.getElementById('mainNav');
    const THRESHOLD = 60; // px before shrinking

    function update() {
        if (window.scrollY > THRESHOLD) {
            nav.classList.add('scrolled');
        } else {
            nav.classList.remove('scrolled');
        }
    }

    // Use passive listener for performance
    window.addEventListener('scroll', update, { passive: true });
    update(); // run on load (handles refresh mid-page)
})();
</script>
