        </div>
    </div>
</section>

{# ── Features ── #}
<section class="section" id="funcionalidades">
    <div style="max-width:640px">
        <p style="color:var(--accent);font-size:13px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;margin-bottom:12px">Funcionalidades</p>
        <h2 class="section-title">Tudo que você precisa<br><span class="gradient-text">em uma plataforma</span></h2>
        <p class="section-subtitle">Importe seus dados, normalize autores e instituições, e gere análises completas em minutos.</p>
    </div>

    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(59,130,246,.12)">🗃️</div>
            <div class="feature-title">Importação Inteligente</div>
            <div class="feature-desc">Importe exportações da Web of Science, Scopus, Lens.org, PubMed, BRAPCI, BDTD, LISTA (EBSCO) e OpenAlex, além de RIS de outras bases. Detecção automática de duplicatas e normalização de campos.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(139,92,246,.12)">🕸️</div>
            <div class="feature-title">Redes de Coautoria</div>
            <div class="feature-desc">Visualize redes interativas de coautoria, co-ocorrência de palavras-chave e cocitação de documentos.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(16,185,129,.12)">🗺️</div>
            <div class="feature-title">Mapas Temáticos</div>
            <div class="feature-desc">Identifique clusters temáticos, temas emergentes e a evolução do campo científico ao longo do tempo.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(245,158,11,.12)">📊</div>
            <div class="feature-title">Análises Estatísticas</div>
            <div class="feature-desc">Produção anual, ranking de autores, fontes, instituições, países e evolução de palavras-chave.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(239,68,68,.12)">📄</div>
            <div class="feature-title">Relatórios Completos</div>
            <div class="feature-desc">Gere relatórios gerais bibliométricos prontos para publicação, com gráficos e tabelas exportáveis.</div>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(6,182,212,.12)">✨</div>
            <div class="feature-title">Normalização Assistida</div>
            <div class="feature-desc">Limpe e padronize nomes de autores, instituições e países com ferramentas de normalização assistida.</div>
        </div>
    </div>
</section>

{# ── Recursos: vitrine com prints reais (config/showcase/recursos.yaml) ── #}
{% if vitrine.categorias is not empty %}
<section class="section showcase" id="recursos" aria-labelledby="recursos-titulo">
    <div class="showcase-head">
        <p class="eyebrow">Recursos</p>
        <h2 class="section-title" id="recursos-titulo">Tudo o que a sua base<br><span class="gradient-text">pode revelar</span></h2>
        <p class="section-subtitle">
            Gráficos, mapas, redes e relatórios gerados a partir de projetos reais. Cada recurso explica o que mostra,
            onde fica no sistema, como usar e por que vale a pena, com um exemplo de verdade.
        </p>
        <div class="showcase-stats">
            <span><i class="bi bi-grid-1x2"></i> {{ vitrine.total_recursos }} recursos</span>
            <span><i class="bi bi-image"></i> {{ vitrine.total_imagens }} telas reais</span>
            <span><i class="bi bi-circle-half"></i> Temas claro e escuro</span>
        </div>
    </div>

    <nav class="showcase-filter" aria-label="Categorias de recursos">
        <a href="#recursos" class="chip is-active" data-filter="todos" aria-pressed="true">
            Todos <span class="chip-count">{{ vitrine.total_recursos }}</span>
        </a>
        {% for categoria in vitrine.categorias %}
            <a href="#{{ categoria.ancora }}" class="chip" data-filter="{{ categoria.id }}" aria-pressed="false">
                <i class="bi {{ categoria.icone }}" aria-hidden="true"></i> {{ categoria.rotulo }}
                <span class="chip-count">{{ categoria.recursos|length }}</span>
            </a>
        {% endfor %}
    </nav>

    {% for categoria in vitrine.categorias %}
    <div class="showcase-category" id="{{ categoria.ancora }}" data-category="{{ categoria.id }}">
        <div class="category-head reveal">
            <span class="category-icon" aria-hidden="true"><i class="bi {{ categoria.icone }}"></i></span>
            <div>
                <h3>{{ categoria.titulo }}</h3>
                <p>{{ categoria.descricao_html|raw }}</p>
            </div>
            <span class="category-count">{{ categoria.recursos|length }} {{ categoria.recursos|length == 1 ? 'recurso' : 'recursos' }}</span>
        </div>

        {% for recurso in categoria.recursos %}
        {% set principal = recurso.imagens|first %}
        <article class="resource{{ loop.index is even ? ' is-reversed' }}" id="{{ recurso.ancora }}" aria-labelledby="{{ recurso.ancora }}-titulo">
            <div class="resource-media reveal">
                <figure class="window">
                    <div class="window-bar" aria-hidden="true">
                        <span></span><span></span><span></span>
                        <em>BiblioMap · {{ recurso.onde }}</em>
                    </div>
                    <a class="window-shot" href="{{ principal.src }}" data-zoom aria-label="Ampliar: {{ principal.legenda }}">
                        <img src="{{ principal.src }}" width="{{ principal.largura }}" height="{{ principal.altura }}"
                             alt="{{ principal.alt }}" loading="lazy" decoding="async"
                             sizes="(max-width: 900px) 92vw, 680px">
                        <span class="zoom-hint" aria-hidden="true"><i class="bi bi-arrows-fullscreen"></i> Ampliar</span>
                    </a>
                    <figcaption>{{ principal.legenda }}</figcaption>
                </figure>
                {% if recurso.imagens|length > 1 %}
                <ul class="variants" aria-label="Outras telas de {{ recurso.titulo }}">
                    {% for imagem in recurso.imagens %}
                    <li>
                        <a href="{{ imagem.src }}" class="variant{{ loop.first ? ' is-active' }}"
                           aria-current="{{ loop.first ? 'true' : 'false' }}" data-alt="{{ imagem.alt }}">
                            <img src="{{ imagem.src }}" width="{{ imagem.largura }}" height="{{ imagem.altura }}"
                                 alt="" loading="lazy" decoding="async">
                            <span>{{ imagem.legenda }}</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>

            <div class="resource-text reveal">
                <span class="where"><i class="bi bi-signpost-split" aria-hidden="true"></i> {{ recurso.onde }}</span>
                <h4 id="{{ recurso.ancora }}-titulo">{{ recurso.titulo }}</h4>
                <p class="lead">{{ recurso.descricao_html|raw }}</p>
                <dl class="facts">
                    <div class="f-mostra">
                        <dt><i class="bi bi-eye" aria-hidden="true"></i> O que mostra</dt>
                        <dd>{{ recurso.mostra_html|raw }}</dd>
                    </div>
                    <div class="f-como">
                        <dt><i class="bi bi-hand-index" aria-hidden="true"></i> Como usar</dt>
                        <dd>{{ recurso.como_html|raw }}</dd>
                    </div>
                    <div class="f-porque">
                        <dt><i class="bi bi-bullseye" aria-hidden="true"></i> Por que usar</dt>
                        <dd>{{ recurso.porque_html|raw }}</dd>
                    </div>
                </dl>
                <div class="example">
                    <div class="example-label"><i class="bi bi-lightbulb" aria-hidden="true"></i> Exemplo real</div>
                    <p>{{ recurso.exemplo_html|raw }}</p>
                </div>
                {% if recurso.exporta is not empty %}
                <div class="exports">
                    <span class="exports-label">Exporta:</span>
                    {% for formato in recurso.exporta %}<span class="tag">{{ formato }}</span>{% endfor %}
                </div>
                {% endif %}
            </div>
        </article>
        {% endfor %}
    </div>
    {% endfor %}
</section>

<dialog class="lightbox" id="lightbox" aria-label="Tela ampliada">
    <button type="button" class="lightbox-close" aria-label="Fechar"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    <figure>
        <img alt="">
        <figcaption></figcaption>
    </figure>
</dialog>
{% endif %}

{# ── How it works ── #}
<section class="section" id="como-funciona" style="background:var(--surface)">
    <div class="how-grid">
        <div>
            <p style="color:var(--accent);font-size:13px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;margin-bottom:12px">Como funciona</p>
            <h2 class="section-title">Do dado bruto<br><span class="gradient-text">à publicação</span></h2>
            <p class="section-subtitle" style="margin-bottom:0">Em poucos passos, transforme sua base bibliográfica em análises prontas para artigos e dissertações.</p>
        </div>
        <div class="how-steps">
            <div class="how-step">
                <div class="step-circle">1</div>
                <div class="how-step-body">
                    <h3>Crie uma conta e aguarde aprovação</h3>
                    <p>Cadastre-se gratuitamente. Nossa equipe revisa e aprova o acesso em até 48h para garantir um ambiente acadêmico qualificado.</p>
                </div>
            </div>
            <div class="how-step">
                <div class="step-circle">2</div>
                <div class="how-step-body">
                    <h3>Crie um projeto e importe os dados</h3>
                    <p>Organize sua pesquisa em projetos independentes. Importe as exportações de oito bases (Web of Science, Scopus, Lens.org, PubMed, BRAPCI, BDTD, LISTA e OpenAlex) ou arquivos RIS de outras.</p>
                </div>
            </div>
            <div class="how-step">
                <div class="step-circle">3</div>
                <div class="how-step-body">
                    <h3>Normalize e analise</h3>
                    <p>Use as ferramentas de normalização para limpar seus dados e gere análises, redes e mapas com um clique.</p>
                </div>
            </div>
            <div class="how-step">
                <div class="step-circle">4</div>
                <div class="how-step-body">
                    <h3>Exporte e publique</h3>
                    <p>Gere relatórios completos, exporte gráficos e compartilhe seus resultados bibliométricos.</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── CTA ── #}
<section class="cta-section" id="cadastro">
    <div class="cta-card">
        <h2 class="cta-title">Pronto para mapear<br><span class="gradient-text">a ciência?</span></h2>
        <p class="cta-desc">
            Crie sua conta gratuita agora. O acesso é moderado para manter a qualidade da comunidade acadêmica.
        </p>
        <a href="{{ path('app_register') }}" class="btn-primary" style="font-size:16px;padding:14px 36px">
            <i class="bi bi-person-plus me-2"></i>Criar conta gratuita
        </a>
        <div>
            <span class="moderation-badge">
                <i class="bi bi-shield-check"></i>
                Acesso via aprovação — sua conta será revisada pelo administrador antes da liberação
            </span>
        </div>
        <div style="margin-top:20px;font-size:13px;color:var(--muted)">
            Já tem conta? <a href="{{ path('app_login') }}" style="color:var(--accent);text-decoration:none;font-weight:600">Fazer login →</a>
        </div>
    </div>
</section>

{# ── Footer ── #}
<footer>
    <div class="footer-logo">
        <img src="/logo.svg" alt="BiblioMap" width="28" height="28" style="border-radius:7px">
        BiblioMap
    </div>
    <div>© {{ "now"|date("Y") }} BiblioMap. Plataforma Bibliométrica Acadêmica.</div>
    <div style="display:flex;gap:16px">
        <a href="{{ path('app_login') }}" style="color:var(--muted);text-decoration:none;font-size:13px">Login</a>
        <a href="{{ path('app_register') }}" style="color:var(--muted);text-decoration:none;font-size:13px">Cadastro</a>
    </div>
</footer>

<script>
// ── Animated network canvas ──────────────────────────────────────────────────
(function() {
    const canvas = document.getElementById('networkCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;

    const nodes = Array.from({length: 22}, (_, i) => ({
        x: 30 + Math.random() * (W - 60),
        y: 30 + Math.random() * (H - 60),
        vx: (Math.random() - .5) * .4,
        vy: (Math.random() - .5) * .4,
        r: 3 + Math.random() * 5,
        color: ['#3b82f6','#8b5cf6','#06b6d4','#10b981'][i % 4],
    }));

    const edges = [];
    for (let i = 0; i < nodes.length; i++)
        for (let j = i+1; j < nodes.length; j++)
            if (Math.random() < .22) edges.push([i, j]);

    function draw() {
        ctx.clearRect(0, 0, W, H);

        // Edges
        edges.forEach(([a, b]) => {
            const na = nodes[a], nb = nodes[b];
            const dist = Math.hypot(na.x - nb.x, na.y - nb.y);
            const alpha = Math.max(0, 1 - dist / 200);
            ctx.beginPath();
            ctx.moveTo(na.x, na.y);
            ctx.lineTo(nb.x, nb.y);
            ctx.strokeStyle = `rgba(59,130,246,${alpha * .35})`;
            ctx.lineWidth = 1;
            ctx.stroke();
        });

        // Nodes
        nodes.forEach(n => {
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fillStyle = n.color;
            ctx.globalAlpha = .85;
            ctx.fill();
            ctx.globalAlpha = .3;
            ctx.strokeStyle = n.color;
            ctx.lineWidth = 2;
            ctx.stroke();
            ctx.globalAlpha = 1;
        });

        // Animate
        nodes.forEach(n => {
            n.x += n.vx; n.y += n.vy;
            if (n.x < n.r || n.x > W - n.r) n.vx *= -1;
            if (n.y < n.r || n.y > H - n.r) n.vy *= -1;
        });

        requestAnimationFrame(draw);
    }
    draw();
})();

// ── Navbar: hero-state → sticky-compact on scroll ───────────────────────────
(function () {
    const nav       = document.getElementById('mainNav');
    const THRESHOLD = 60; // px before shrinking

    function update() {
        if (window.scrollY > THRESHOLD) {
            nav.classList.add('scrolled');
        } else {
            nav.classList.remove('scrolled');
        }
    }

    // Use passive listener for performance
    window.addEventListener('scroll', update, { passive: true });
    update(); // run on load (handles refresh mid-page)
})();

// ── Vitrine de recursos: filtro, âncoras, troca de tela e ampliação ─────────
(function () {
    const section = document.getElementById('recursos');
    if (!section) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const filterBar = section.querySelector('.showcase-filter');
    const chips = [...filterBar.querySelectorAll('.chip')];
    const categories = [...section.querySelectorAll('.showcase-category')];

    // Entrada suave ao rolar
    const reveals = section.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !reduceMotion) {
        const io = new IntersectionObserver(entries => entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
            }
        }), { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        reveals.forEach(el => io.observe(el));
    } else {
        reveals.forEach(el => el.classList.add('is-visible'));
    }

    // Filtro por categoria (sem JS, os chips são links para as âncoras e tudo fica visível)
    function setFilter(id) {
        chips.forEach(chip => {
            const on = chip.dataset.filter === id;
            chip.classList.toggle('is-active', on);
            chip.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        categories.forEach(cat => { cat.hidden = !(id === 'todos' || cat.dataset.category === id); });
    }
    // Leva ao início da primeira categoria visível (o scroll-margin-top deixa espaço para o menu e o filtro)
    function scrollToFilter() {
        const first = categories.find(c => !c.hidden);
        if (first) first.scrollIntoView({ block: 'start', behavior: reduceMotion ? 'auto' : 'smooth' });
    }
    chips.forEach(chip => {
        chip.setAttribute('role', 'button');
        chip.addEventListener('click', e => {
            e.preventDefault();
            setFilter(chip.dataset.filter);
            history.replaceState(null, '', chip.dataset.filter === 'todos' ? '#recursos' : '#categoria-' + chip.dataset.filter);
            scrollToFilter();
        });
        chip.addEventListener('keydown', e => {
            if (e.key === ' ') { e.preventDefault(); chip.click(); }
        });
    });

    // Link direto: #recurso-… sempre volta para "Todos"; #categoria-… liga o filtro da categoria
    function fromHash() {
        const id = decodeURIComponent(window.location.hash.slice(1));
        if (id.startsWith('recurso-')) {
            const target = document.getElementById(id);
            if (!target) return;
            setFilter('todos');
            target.scrollIntoView({ block: 'start' });
        } else if (id.startsWith('categoria-')) {
            const cat = id.slice('categoria-'.length);
            if (!categories.some(c => c.dataset.category === cat)) return;
            setFilter(cat);
            scrollToFilter();
        }
    }
    window.addEventListener('hashchange', fromHash);
    fromHash();

    // Miniaturas: trocam a tela principal do recurso
    section.querySelectorAll('.resource').forEach(resource => {
        const shot = resource.querySelector('.window-shot');
        const img = shot.querySelector('img');
        const caption = resource.querySelector('.window figcaption');
        const variants = [...resource.querySelectorAll('.variant')];
        variants.forEach(variant => variant.addEventListener('click', e => {
            e.preventDefault();
            const thumb = variant.querySelector('img');
            const legenda = variant.querySelector('span').textContent;
            img.src = variant.getAttribute('href');
            img.width = Number(thumb.getAttribute('width'));
            img.height = Number(thumb.getAttribute('height'));
            img.alt = variant.dataset.alt;
            caption.textContent = legenda;
            shot.href = variant.getAttribute('href');
            shot.setAttribute('aria-label', 'Ampliar: ' + legenda);
            variants.forEach(v => {
                v.classList.toggle('is-active', v === variant);
                v.setAttribute('aria-current', v === variant ? 'true' : 'false');
            });
        }));
    });

    // Ampliação num <dialog>: Esc é nativo; fecha também no botão e no clique fora da imagem
    const dialog = document.getElementById('lightbox');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const bigImg = dialog.querySelector('img');
    const bigCaption = dialog.querySelector('figcaption');
    let trigger = null;

    section.addEventListener('click', e => {
        const shot = e.target.closest('.window-shot');
        if (!shot) return;
        e.preventDefault();
        trigger = shot;
        const img = shot.querySelector('img');
        bigImg.src = img.getAttribute('src');
        bigImg.alt = img.alt;
        bigCaption.textContent = shot.closest('figure').querySelector('figcaption').textContent;
        dialog.showModal();
        dialog.querySelector('.lightbox-close').focus();
    });
    dialog.addEventListener('click', e => {
        if (e.target === dialog || e.target.closest('.lightbox-close')) dialog.close();
    });
    dialog.addEventListener('close', () => {
        bigImg.removeAttribute('src');
        if (trigger) trigger.focus();
    });
})();
</script>
</body>
</html>
