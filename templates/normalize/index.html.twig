{% extends 'base.html.twig' %}

{% block title %}Normalizar e Deduplicar — {{ project.title }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_projects_index') }}" style="color:var(--bm-text-muted);text-decoration:none">Projetos</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <a href="{{ path('app_projects_show', {id: project.id}) }}" style="color:var(--bm-text-muted);text-decoration:none">{{ project.title|slice(0,30) }}</a>
    <span style="margin:0 6px;color:var(--bm-border)">/</span>
    <span class="current">Normalização e Deduplicação</span>
{% endblock %}

{% block stylesheets %}
<style>
/* ── Tab Layout ──────────────────────────────────────────────── */
.norm-nav-tabs {
    display: flex; gap: 8px; margin-bottom: 24px;
    border-bottom: 1px solid var(--bm-border); padding-bottom: 10px;
}
.norm-tab-link {
    padding: 10px 18px; border-radius: 8px; border: 1px solid transparent;
    color: var(--bm-text-muted); font-size: 13.5px; font-weight: 600;
    text-decoration: none; transition: all 0.2s;
    display: flex; align-items: center; gap: 8px;
}
.norm-tab-link:hover { color: var(--bm-text); background: rgba(255,255,255,0.03); }
.norm-tab-link.active {
    background: rgba(79,142,247,0.1); border-color: rgba(79,142,247,0.25);
    color: var(--bm-accent);
}

/* ── Info Bar ────────────────────────────────────────────────── */
.info-card {
    background: rgba(79,142,247,0.05);
    border: 1px solid rgba(79,142,247,0.15);
    border-radius: 12px; padding: 16px 20px; margin-bottom: 24px;
    font-size: 13.5px; line-height: 1.5; color: #a5c6f9;
    display: flex; align-items: center; gap: 14px;
}

/* ── Suggested Duplicate Cards ────────────────────────────────── */
.dup-list {
    display: flex; flex-direction: column; gap: 16px;
}
.dup-card {
    background: var(--bm-card-bg);
    border: 1px solid var(--bm-border);
    border-radius: 14px; padding: 20px;
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: center; gap: 24px;
    transition: all 0.25s ease;
}
.dup-card:hover { border-color: #484f58; transform: translateY(-1px); }

/* Left/Right Entities */
.entity-side { display: flex; flex-direction: column; gap: 4px; }
.entity-role { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; width: fit-content; padding: 2px 8px; border-radius: 10px; }
.role-keep    { background: rgba(63,185,80,0.15); color: #3fb950; }
.role-discard { background: rgba(248,81,73,0.15); color: #f85149; }
.entity-name { font-size: 15px; font-weight: 600; color: var(--bm-text); margin-top: 4px; }
.entity-meta { font-size: 12px; color: var(--bm-text-muted); }

/* Similarity Badge */
.sim-badge-wrap { display: flex; flex-direction: column; align-items: center; gap: 6px; }
.sim-badge {
    background: rgba(210,153,34,0.15); color: var(--bm-warning);
    font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 20px;
    border: 1px solid rgba(210,153,34,0.25);
}
.sim-arrow { font-size: 18px; color: var(--bm-text-muted); }

/* Empty state */
.empty-state {
    background: var(--bm-card-bg); border: 1px solid var(--bm-border);
    border-radius: 14px; padding: 48px 24px; text-align: center;
    color: var(--bm-text-muted); font-size: 14px;
}
.empty-icon { font-size: 36px; margin-bottom: 12px; }

/* ── Toast style ──────────────────────────────────────────────── */
.toast-container {
    position: fixed; bottom: 24px; right: 24px; z-index: 1000;
}
.bm-toast {
    background: var(--bm-sidebar-bg); border: 1px solid var(--bm-border);
    color: var(--bm-text); border-radius: 10px; padding: 12px 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4); display: flex; align-items: center; gap: 10px;
    font-size: 13.5px; opacity: 0; transform: translateY(20px); transition: all 0.3s ease;
}
.bm-toast.show { opacity: 1; transform: translateY(0); }
</style>
{% endblock %}

{% block body %}
<!-- Flash Messages -->
{% for type, messages in app.flashes %}
    {% for msg in messages %}
        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show mb-3" role="alert">
            {{ msg }} <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<!-- Page Header -->
<div class="bm-page-header">
    <h1 class="bm-page-title">
        <i class="bi bi-magic me-2" style="color:var(--bm-accent)"></i>
        Normalizar e Deduplicar
    </h1>
    <p class="bm-page-subtitle">Otimize a consistência dos seus dados bibliométricos eliminando duplicatas e unificando variações</p>
</div>

<!-- Tab Navigation Switcher -->
<div class="norm-nav-tabs">
    <a href="{{ path('app_normalize_index', {id: project.id, tab: 'authors'}) }}" 
       class="norm-tab-link {% if tab == 'authors' %}active{% endif %}">
        <i class="bi bi-people"></i> Autores Similares
    </a>
    <a href="{{ path('app_normalize_index', {id: project.id, tab: 'keywords'}) }}" 
       class="norm-tab-link {% if tab == 'keywords' %}active{% endif %}">
        <i class="bi bi-tags"></i> Palavras-Chave
    </a>
    <a href="{{ path('app_normalize_index', {id: project.id, tab: 'duplicates'}) }}" 
       class="norm-tab-link {% if tab == 'duplicates' %}active{% endif %}">
        <i class="bi bi-file-earmark-text"></i> Documentos Duplicados
    </a>
</div>

<!-- Tab-Specific Description Bar -->
{% if tab == 'authors' %}
    <div class="info-card">
        <i class="bi bi-info-circle-fill" style="font-size:18px;color:var(--bm-accent)"></i>
        <div>
            Identificamos autores com nomes muito semelhantes (ex: <b>Silva, J.</b> e <b>Silva, J.A.</b>). 
            A mesclagem atualizará todos os artigos associados ao autor descartado para o autor mantido e removerá o registro duplicado.
        </div>
    </div>
{% elseif tab == 'keywords' %}
    <div class="info-card" style="margin-bottom:12px">
        <i class="bi bi-info-circle-fill" style="font-size:18px;color:var(--bm-accent)"></i>
        <div>
            Identificamos palavras-chave redundantes, plurais ou com pequenas variações de escrita. 
            A mesclagem unifica a ocorrência de termos em todos os artigos, melhorando os gráficos de frequência e nuvens.
        </div>
    </div>

    <!-- Keyword Subfilter (Author vs Indexed) -->
    <div style="margin-bottom:20px; display:flex; gap:8px; align-items:center">
        <span class="text-muted-bm" style="font-size:12.5px; font-weight:600">Origem do Termo:</span>
        <div class="net-tabs">
            <a href="{{ path('app_normalize_index', {id: project.id, tab: 'keywords', kwType: 'author'}) }}" 
               class="net-tab {% if kwType == 'author' %}active{% endif %}" style="text-decoration:none">Autores</a>
            <a href="{{ path('app_normalize_index', {id: project.id, tab: 'keywords', kwType: 'indexed' }) }}" 
               class="net-tab {% if kwType == 'indexed' %}active{% endif %}" style="text-decoration:none">Indexadas</a>
        </div>
    </div>
{% elseif tab == 'duplicates' %}
    <div class="info-card">
        <i class="bi bi-info-circle-fill" style="font-size:18px;color:var(--bm-accent)"></i>
        <div>
            Identificamos documentos com títulos altamente semelhantes publicados no mesmo ano. 
            Ao mesclar, as informações serão combinadas, priorizando os campos mais completos e o maior número de citações.
        </div>
    </div>
{% endif %}

<!-- Suggested Duplicates List -->
<div class="dup-list">
    {% if suggestions is empty %}
        <div class="empty-state">
            <div class="empty-icon">🎉</div>
            <h5 style="color:var(--bm-text)">Nenhum registro duplicado encontrado!</h5>
            <p class="mb-0" style="font-size:13px">Seus dados nesta categoria estão 100% limpos e consistentes.</p>
        </div>
    {% else %}
        <!-- Batch Actions Bar -->
        <div id="batch-control-bar" class="d-flex align-items-center justify-content-between mb-3 px-3 py-2 bg-bm-card border-bm rounded-3" style="border:1px solid var(--bm-border);border-radius:10px">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-bm-secondary d-flex align-items-center gap-1" onclick="selectCaseOnlyDiffs()">
                    <i class="bi bi-spellcheck"></i> Selecionar Diferenças de Caixa
                </button>
                <button type="button" class="btn btn-sm btn-bm-secondary d-flex align-items-center gap-1" onclick="selectPluralSingularDiffs()">
                    <i class="bi bi-intersect"></i> Selecionar Singular/Plural
                </button>
                <button type="button" class="btn btn-sm d-flex align-items-center gap-1" onclick="mergeAllPerfect()"
                    style="font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid rgba(63,185,80,0.4);background:rgba(63,185,80,0.1);color:var(--bm-success);font-weight:600">
                    <i class="bi bi-lightning-charge-fill"></i> Mesclar 100% Similares
                </button>
                <button type="button" class="btn btn-sm btn-bm-secondary" onclick="selectAllSuggestions(true)">
                    Marcar Todos
                </button>
                <button type="button" class="btn btn-sm btn-bm-secondary" onclick="selectAllSuggestions(false)">
                    Desmarcar Todos
                </button>
            </div>
            <div id="batch-action-area" style="display:none">
                <button type="button" class="btn btn-sm btn-bm-primary d-flex align-items-center gap-1" onclick="runBatchMerge()">
                    <i class="bi bi-merge"></i> Mesclar Selecionados (<span id="batch-selected-count">0</span>)
                </button>
            </div>
        </div>

        {% for sug in suggestions %}
            <div class="dup-card" id="card-{{ sug.keep.id }}-{{ sug.discard.id }}">
                
                <!-- Selection Checkbox -->
                <div class="d-flex align-items-center justify-content-center pe-2">
                    <input type="checkbox" class="form-check-input merge-select-check"
                           data-keep-id="{{ sug.keep.id }}"
                           data-discard-id="{{ sug.discard.id }}"
                           data-similarity="{{ sug.similarity }}"
                           data-keep-text="{% if tab == 'authors' %}{{ sug.keep.name }}{% elseif tab == 'keywords' %}{{ sug.keep.term }}{% else %}{{ sug.keep.title }}{% endif %}"
                           data-discard-text="{% if tab == 'authors' %}{{ sug.discard.name }}{% elseif tab == 'keywords' %}{{ sug.discard.term }}{% else %}{{ sug.discard.title }}{% endif %}"
                           onchange="updateBatchActionVisibility()">
                </div>
                
                <!-- Left (Candidate to Keep) -->
                <div class="entity-side">
                    <span class="entity-role role-keep">Manter</span>
                    {% if tab == 'authors' %}
                        <span class="entity-name">{{ sug.keep.name }}</span>
                        <span class="entity-meta"><i class="bi bi-file-earmark-text me-1"></i>{{ sug.keep.doc_count }} artigos</span>
                    {% elseif tab == 'keywords' %}
                        <span class="entity-name">{{ sug.keep.term }}</span>
                        <span class="entity-meta"><i class="bi bi-tag me-1"></i>{{ sug.keep.doc_count }} ocorrências</span>
                    {% elseif tab == 'duplicates' %}
                        <span class="entity-name" title="{{ sug.keep.title }}">{{ sug.keep.title|length > 65 ? sug.keep.title|slice(0, 65) ~ '…' : sug.keep.title }}</span>
                        <span class="entity-meta">
                            🗓️ {{ sug.keep.year }} · 
                            {% if sug.keep.doi %}DOI: <code>{{ sug.keep.doi|slice(0,25) }}</code> · {% endif %}
                            <i class="bi bi-journal-text"></i> {{ sug.keep.source_title|slice(0,35) }}
                        </span>
                    {% endif %}
                </div>

                <!-- Middle Similarity Indicator -->
                <div class="sim-badge-wrap">
                    <span class="sim-badge">{{ sug.similarity }}% similar</span>
                    <span class="sim-arrow">←</span>
                </div>

                <!-- Right (Candidate to Discard) -->
                <div class="entity-side">
                    <span class="entity-role role-discard">Mesclar & Apagar</span>
                    {% if tab == 'authors' %}
                        <span class="entity-name">{{ sug.discard.name }}</span>
                        <span class="entity-meta"><i class="bi bi-file-earmark-text me-1"></i>{{ sug.discard.doc_count }} artigos</span>
                    {% elseif tab == 'keywords' %}
                        <span class="entity-name">{{ sug.discard.term }}</span>
                        <span class="entity-meta"><i class="bi bi-tag me-1"></i>{{ sug.discard.doc_count }} ocorrências</span>
                    {% elseif tab == 'duplicates' %}
                        <span class="entity-name" title="{{ sug.discard.title }}">{{ sug.discard.title|length > 65 ? sug.discard.title|slice(0, 65) ~ '…' : sug.discard.title }}</span>
                        <span class="entity-meta">
                            🗓️ {{ sug.discard.year }} · 
                            {% if sug.discard.doi %}DOI: <code>{{ sug.discard.doi|slice(0,25) }}</code> · {% endif %}
                            <i class="bi bi-journal-text"></i> {{ sug.discard.source_title|slice(0,35) }}
                        </span>
                    {% endif %}
                </div>

                <!-- Actions -->
                <div>
                    <form method="post" action="{{ path('app_normalize_merge', {id: project.id}) }}" 
                          onsubmit="submitMerge(event, '{{ tab }}', '{{ sug.keep.id }}', '{{ sug.discard.id }}')">
                        <input type="hidden" name="type" value="{% if tab == 'authors' %}author{% elseif tab == 'keywords' %}keyword{% else %}document{% endif %}">
                        <input type="hidden" name="keepId" value="{{ sug.keep.id }}">
                        <input type="hidden" name="discardId" value="{{ sug.discard.id }}">
                        <input type="hidden" name="tab" value="{{ tab }}">
                        <input type="hidden" name="kwType" value="{{ kwType }}">
                        
                        <button type="submit" class="btn-bm-primary btn-sm d-flex align-items-center gap-1" style="font-size:12.5px;padding:6px 14px">
                            <i class="bi bi-merge"></i> Mesclar
                        </button>
                    </form>
                </div>

            </div>
        {% endfor %}
    {% endif %}
</div>

<!-- Floating Custom Toast Notification -->
<div class="toast-container">
    <div class="bm-toast" id="bm-toast">
        <i class="bi bi-check-circle-fill text-success" id="toast-icon"></i>
        <span id="toast-text">Mesclagem realizada com sucesso!</span>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
async function submitMerge(e, tab, keepId, discardId) {
    e.preventDefault();
    const form = e.target;
    
    // Disable button to prevent double submits
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processando…`;

    const formData = new FormData(form);

    try {
        const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'Accept': 'application/json'
            }
        });

        const data = await response.json();
        
        if (data.success) {
            // Animate card removal
            const card = document.getElementById(`card-${keepId}-${discardId}`);
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            
            setTimeout(() => {
                card.remove();
                checkEmptyState();
            }, 300);

            showToast(data.message, true);
        } else {
            showToast(data.message, false);
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-merge"></i> Mesclar`;
        }
    } catch (err) {
        showToast('Erro de rede ao processar mesclagem.', false);
        btn.disabled = false;
        btn.innerHTML = `<i class="bi bi-merge"></i> Mesclar`;
    }
}

function showToast(message, isSuccess) {
    const toast = document.getElementById('bm-toast');
    const text = document.getElementById('toast-text');
    const icon = document.getElementById('toast-icon');

    text.textContent = message;
    icon.className = isSuccess ? 'bi bi-check-circle-fill text-success' : 'bi bi-exclamation-triangle-fill text-danger';

    toast.classList.add('show');
    setTimeout(() => {
        toast.classList.remove('show');
    }, 3000);
}

function selectCaseOnlyDiffs() {
    let count = 0;
    document.querySelectorAll('.merge-select-check').forEach(cb => {
        const keepText = cb.getAttribute('data-keep-text').trim();
        const discardText = cb.getAttribute('data-discard-text').trim();
        
        // Identical text case-insensitively, but differing in case
        if (keepText.toLowerCase() === discardText.toLowerCase() && keepText !== discardText) {
            cb.checked = true;
            count++;
        } else {
            cb.checked = false;
        }
    });
    
    updateBatchActionVisibility();
    
    if (count > 0) {
        showToast(`${count} item(s) com diferença de caixa selecionado(s)!`, true);
    } else {
        showToast('Nenhum item com diferença de caixa encontrado na lista.', false);
    }
}

/**
 * Checks if two terms are likely singular/plural variants of each other.
 * Handles common English and Portuguese plural patterns:
 *   - word / words          (+ s)
 *   - box / boxes           (+ es)
 *   - study / studies       (y → ies)
 *   - analysis / analyses   (is → es)
 *   - criterion / criteria  (on → a)
 *   - ação / ações          (ção → ções)
 *   - ação / ações          (são → sões)
 *   - al / ais              (al → ais, el → eis, ol → ois, ul → uis)
 *   - m / ns               (m → ns: algum → alguns)
 */
function isSingularPluralPair(a, b) {
    const la = a.toLowerCase().trim();
    const lb = b.toLowerCase().trim();

    if (la === lb) return false; // identical (case-only handled by other button)

    // One must be derivable from the other
    function check(shorter, longer) {
        // Rule: shorter + s = longer  (word → words)
        if (longer === shorter + 's') return true;
        // Rule: shorter + es = longer  (box → boxes)
        if (longer === shorter + 'es') return true;
        // Rule: y → ies  (study → studies)
        if (shorter.endsWith('y') && longer === shorter.slice(0,-1) + 'ies') return true;
        // Rule: is → es  (analysis → analyses)
        if (shorter.endsWith('is') && longer === shorter.slice(0,-2) + 'es') return true;
        // Rule: on → a  (criterion → criteria)
        if (shorter.endsWith('on') && longer === shorter.slice(0,-2) + 'a') return true;
        // Rule: ção → ções  (ação → ações)
        if (shorter.endsWith('ção') && longer === shorter.slice(0,-3) + 'ções') return true;
        // Rule: são → sões  (mansão → mansões)
        if (shorter.endsWith('são') && longer === shorter.slice(0,-3) + 'sões') return true;
        // Rule: al → ais  (digital → digitais)
        if (shorter.endsWith('al') && longer === shorter.slice(0,-2) + 'ais') return true;
        // Rule: el → eis  (papel → papéis) — accent-insensitive handled by .toLowerCase()
        if (shorter.endsWith('el') && longer === shorter.slice(0,-2) + 'eis') return true;
        // Rule: m → ns  (algum → alguns)
        if (shorter.endsWith('m') && longer === shorter.slice(0,-1) + 'ns') return true;
        // Rule: r/s/z + es  (professor → professores)
        if (['r','s','z'].some(c => shorter.endsWith(c)) && longer === shorter + 'es') return true;
        return false;
    }

    // Check both directions (a→b and b→a) since we don't know which is singular
    return check(la, lb) || check(lb, la);
}

function selectPluralSingularDiffs() {
    let count = 0;
    document.querySelectorAll('.merge-select-check').forEach(cb => {
        const keepText    = cb.getAttribute('data-keep-text').trim();
        const discardText = cb.getAttribute('data-discard-text').trim();

        if (isSingularPluralPair(keepText, discardText)) {
            cb.checked = true;
            count++;
        }
        // Don't uncheck others — allow combining with case button
    });

    updateBatchActionVisibility();

    if (count > 0) {
        showToast(`${count} par(es) singular/plural selecionado(s)!`, true);
    } else {
        showToast('Nenhum par singular/plural encontrado na lista atual.', false);
    }
}

function selectAllSuggestions(val) {
    document.querySelectorAll('.merge-select-check').forEach(cb => {
        cb.checked = val;
    });
    updateBatchActionVisibility();
}

/**
 * Select all checkboxes where similarity == 100 and immediately run batch merge.
 * Works for: exact case matches, singular/plural, cross-type identical terms.
 */
async function mergeAllPerfect() {
    // First: select only the 100% ones
    let count = 0;
    document.querySelectorAll('.merge-select-check').forEach(cb => {
        const sim = parseFloat(cb.getAttribute('data-similarity') || '0');
        cb.checked = sim >= 100;
        if (sim >= 100) count++;
    });
    updateBatchActionVisibility();

    if (count === 0) {
        showToast('Nenhum par com 100% de similaridade encontrado.', false);
        return;
    }

    if (!confirm(`Mesclar automaticamente ${count} par(es) com 100% de similaridade?\n\nEsta ação não pode ser desfeita.`)) {
        // Deselect all if user cancels
        selectAllSuggestions(false);
        return;
    }

    // Run the existing batch merge
    await runBatchMerge();
}

function updateBatchActionVisibility() {
    const checkedBoxes = document.querySelectorAll('.merge-select-check:checked');
    const area = document.getElementById('batch-action-area');
    const countSpan = document.getElementById('batch-selected-count');
    
    if (checkedBoxes.length > 0) {
        area.style.display = 'block';
        countSpan.textContent = checkedBoxes.length;
    } else {
        area.style.display = 'none';
    }
}

async function runBatchMerge() {
    const checkedBoxes = Array.from(document.querySelectorAll('.merge-select-check:checked'));
    if (checkedBoxes.length === 0) return;

    if (!confirm(`Deseja realmente mesclar os ${checkedBoxes.length} itens selecionados?`)) {
        return;
    }

    showToast(`Iniciando mesclagem em lote de ${checkedBoxes.length} itens...`, true);

    const buttons = document.querySelectorAll('button');
    const checkboxes = document.querySelectorAll('.merge-select-check');
    
    // Disable all buttons and checkboxes
    buttons.forEach(btn => btn.disabled = true);
    checkboxes.forEach(cb => cb.disabled = true);

    for (const cb of checkedBoxes) {
        const keepId = cb.getAttribute('data-keep-id');
        const discardId = cb.getAttribute('data-discard-id');
        const card = document.getElementById(`card-${keepId}-${discardId}`);
        if (!card) continue;

        const form = card.querySelector('form');
        if (!form) continue;

        card.style.border = '1px solid var(--bm-accent)';
        card.style.background = 'rgba(79,142,247,0.05)';
        
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        const formData = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            });

            const data = await response.json();
            if (data.success) {
                card.style.opacity = '0';
                card.style.transform = 'scale(0.95)';
                await new Promise(resolve => setTimeout(resolve, 300));
                card.remove();
                checkEmptyState();
            } else {
                card.style.border = '1px solid var(--bm-danger)';
                card.style.background = 'rgba(248,81,73,0.05)';
                showToast(`Erro ao mesclar: ${data.message}`, false);
            }
        } catch (err) {
            card.style.border = '1px solid var(--bm-danger)';
            card.style.background = 'rgba(248,81,73,0.05)';
            showToast('Erro de rede na mesclagem em lote.', false);
        }
    }

    // Re-enable all buttons and checkboxes
    buttons.forEach(btn => btn.disabled = false);
    checkboxes.forEach(cb => cb.disabled = false);
    
    document.querySelectorAll('.merge-select-check').forEach(cb => {
        cb.checked = false;
    });
    updateBatchActionVisibility();
    showToast('Processamento em lote concluído!', true);
}

function checkEmptyState() {
    const list = document.querySelector('.dup-list');
    if (list.querySelectorAll('.dup-card').length === 0) {
        list.innerHTML = `
            <div class="empty-state">
                <div class="empty-icon">🎉</div>
                <h5 style="color:var(--bm-text)">Nenhum registro duplicado encontrado!</h5>
                <p class="mb-0" style="font-size:13px">Seus dados nesta categoria estão 100% limpos e consistentes.</p>
            </div>
        `;
        const batchBar = document.getElementById('batch-control-bar');
        if (batchBar) batchBar.remove();
    }
}
</script>
{% endblock %}
