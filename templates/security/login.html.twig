{% extends 'base.html.twig' %}

{% block auth_body %}
<div style="min-height:100vh;background:var(--bm-bg);display:flex;align-items:center;justify-content:center;padding:20px">
    <div style="width:100%;max-width:420px">

        {# Logo #}
        <div class="text-center mb-5">
            <div style="width:56px;height:56px;background:linear-gradient(135deg,#4f8ef7,#a855f7);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 16px">📊</div>
            <h1 style="font-size:24px;font-weight:700;color:var(--bm-text);margin:0">BiblioMap</h1>
            <p style="color:var(--bm-text-muted);font-size:13px;margin:4px 0 0">Plataforma de análise bibliométrica</p>
        </div>

        {# Card #}
        <div style="background:var(--bm-card-bg);border:1px solid var(--bm-border);border-radius:16px;padding:32px">
            <h2 style="font-size:18px;font-weight:600;color:var(--bm-text);margin:0 0 24px">Entrar na plataforma</h2>

            {% if error %}
                <div class="alert alert-danger d-flex gap-2 align-items-center mb-3" style="border-radius:8px;font-size:13px">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" id="login-form">
                <div class="mb-3">
                    <label for="inputEmail" class="form-label">E-mail</label>
                    <input type="email" id="inputEmail" name="_username"
                           value="{{ last_username }}"
                           class="form-control"
                           placeholder="seu@email.com"
                           autocomplete="email" autofocus required>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="inputPassword" class="form-label mb-0">Senha</label>
                        <a href="#" style="font-size:12px;color:var(--bm-accent)">Esqueceu a senha?</a>
                    </div>
                    <input type="password" id="inputPassword" name="_password"
                           class="form-control mt-1"
                           placeholder="Sua senha"
                           autocomplete="current-password" required>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="rememberMe" name="_remember_me">
                    <label class="form-check-label" for="rememberMe" style="font-size:13px">Manter conectado por 7 dias</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" id="login-btn"
                        style="width:100%;padding:10px;background:linear-gradient(135deg,#4f8ef7,#a855f7);border:none;border-radius:8px;color:white;font-weight:600;font-size:15px;cursor:pointer;transition:opacity 0.2s">
                    Entrar
                </button>
            </form>
        </div>

        <p class="text-center mt-4" style="font-size:13px;color:var(--bm-text-muted)">
            Não tem conta?
            <a href="{{ path('app_register') }}" style="color:var(--bm-accent);font-weight:500">Criar conta grátis</a>
        </p>
    </div>
</div>
{% endblock %}
