# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Vazio de propósito: o repositório é público. O valor real fica no .env.local de cada servidor
# (gere com: php -r "echo bin2hex(random_bytes(32));"). Dev e teste usam o do .env.dev e do .env.test.
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# Em produção (MySQL) o DATABASE_URL com usuário e senha fica só no .env.local do servidor.
###< doctrine/doctrine-bundle ###

###> app:database:backup ###
# Pasta dos backups diários do banco (app:database:backup e app:keywords:treat --require-backup).
# Defina só no .env.local: caminho absoluto fora do projeto, permissão 700. Vazia = sem backup.
DATABASE_BACKUP_DIR=
###< app:database:backup ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/seo-analytics ###
# Google Analytics Measurement ID (ex: G-XXXXXXXXXX). Leave empty to disable.
GOOGLE_ANALYTICS_ID=

# Public home SEO
APP_SEO_TITLE="BiblioMap — Plataforma Bibliométrica"
APP_SEO_DESCRIPTION="BiblioMap é a plataforma para análise bibliométrica, cientométrica e mapeamento da produção científica. Visualize redes de coautoria, mapas temáticos e muito mais."
APP_SEO_KEYWORDS="bibliometria, cientometria, análise bibliométrica, mapa temático, rede de coautoria, pesquisa científica"
APP_SEO_OG_IMAGE=
APP_BASE_URL=http://localhost
###< app/seo-analytics ###
